{
  "name": "event-point-astro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Event Point Ranchi — wedding mandap, stage design, furniture and event equipment planning, built as removable Astro feature modules.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:vercel": "BUILD_TARGET=vercel npm run sync:content && BUILD_TARGET=vercel npm run build && npm run report:publish",
    "sync:content": "node --import tsx scripts/sync-content.ts",
    "report:publish": "node --import tsx scripts/report-publish.ts",
    "preview": "node ./dist/server/entry.mjs",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "TEST_MODE=1 node --import tsx --test 'tests/**/*.test.ts'",
    "test:live": "TEST_MODE=1 ALLOW_LIVE_DB_TESTS=1 node --import tsx --test 'tests/**/*.test.ts'",
    "perf:baseline": "node --import tsx scripts/perf-baseline.ts",
    "verify:e2e": "node --import tsx scripts/verify-enquiry-e2e.ts",
    "verify:booking": "node --import tsx scripts/verify-booking-live.ts",
    "db:reset": "node scripts/reset-db.mjs",
    "db:audit": "node --import tsx scripts/db-audit.ts",
    "db:migrate:publications": "node --import tsx scripts/migrate-publications-neon.ts",
    "db:migrate:schema": "node --import tsx scripts/migrate-schema-neon.ts",
    "content:export": "node --import tsx scripts/migrate-page-content-to-filebase.ts",
    "content:parity": "node --import tsx scripts/content-parity.ts",
    "probe:filebase": "node --import tsx scripts/probe-filebase.ts",
    "db:migrate:inquiries": "node --import tsx scripts/migrate-contact-inquiries-neon.ts",
    "db:migrate:bookings": "node --import tsx scripts/migrate-bookings-neon.ts",
    "db:migrate:catalog": "node --import tsx scripts/migrate-catalog-to-d1.ts",
    "db:migrate:catalogue-admin": "node --import tsx scripts/migrate-catalogue-admin-d1.ts",
    "db:bootstrap:build-d1": "node --import tsx scripts/bootstrap-build-d1.ts",
    "dev:snapshot": "CONTENT_SOURCE=snapshot astro dev"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/vercel": "^11.0.18",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@neondatabase/serverless": "^1.2.0",
    "astro": "^7.4.5",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vercel/cli-config": "0.3.6",
    "@vercel/functions": "3.10.6",
    "@vercel/oidc": "4.0.6",
    "@vercel/routing-utils": "6.6.1",
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "path-to-regexp": "6.3.0",
    "zod": "4.6.7"
  }
}
