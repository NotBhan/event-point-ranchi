{
  "name": "event-point-astro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Event Point Ranchi — wedding mandap, stage design, furniture and event equipment planning, built as removable Astro feature modules.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:vercel": "BUILD_TARGET=vercel npm run sync:content && BUILD_TARGET=vercel npm run build && npm run report:publish",
    "sync:content": "node --import tsx scripts/sync-content.ts",
    "report:publish": "node --import tsx scripts/report-publish.ts",
    "preview": "node ./dist/server/entry.mjs",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "perf:baseline": "node --import tsx scripts/perf-baseline.ts",
    "db:reset": "node scripts/reset-db.mjs",
    "db:audit": "node --import tsx scripts/db-audit.ts",
    "db:migrate:publications": "node --import tsx scripts/migrate-publications-neon.ts",
    "db:migrate:catalog": "node --import tsx scripts/migrate-catalog-to-d1.ts",
    "dev:snapshot": "CONTENT_SOURCE=snapshot astro dev"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/vercel": "^11.0.16",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@neondatabase/serverless": "^1.2.0",
    "astro": "^7.4.2",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
