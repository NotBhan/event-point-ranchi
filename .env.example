# Signing secret for session cookies. Generate with: openssl rand -hex 32
APP_SECRET=change-me-in-production

# Where the SQLite database and legacy uploaded images live.
DATA_DIR=./data

# Optional: comma separated module ids to disable, e.g. "gallery,contact"
DISABLED_MODULES=

# Admin password (defaults to 'admin' if not set)
ADMIN_PASSWORD=admin

# Dedicated content editor password (defaults to 'Editor@Royal2026!' if not set)
EDITOR_PASSWORD=Editor@Royal2026!

# Filebase (S3-compatible) object storage.
# Leave the bucket and keys empty to use the in-memory mock storage driver.
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto
FILEBASE_BUCKET=
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
# Optional public URL prefix for stored objects.
# Defaults to https://{FILEBASE_BUCKET}.s3.filebase.io
FILEBASE_PUBLIC_BASE_URL=

# Optional driver override: filebase | mock
STORAGE_DRIVER=

# Storage quotas in bytes.
# Gallery defaults to 3 GiB, other assets default to 1 GiB.
GALLERY_STORAGE_LIMIT_BYTES=3221225472
ASSET_STORAGE_LIMIT_BYTES=1073741824

# Neon PostgreSQL Operational Database
DATABASE_URL=postgresql://neondb_owner:password@ep-example.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare D1 Website Content Database (HTTP API)
# Store server-side only in Vercel environment variables or .env
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Payment Gateway Configuration (PhonePe)
# Server-side secrets only — NEVER prefix with PUBLIC_ or expose to the browser!
PAYMENT_ENVIRONMENT=test
PAYMENT_DEFAULT_PROVIDER=phonepe

# PhonePe Payment Gateway (PG V1)
# Production / UAT credentials from PhonePe Merchant Portal
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# ---------------------------------------------------------------------------
# Content snapshots & publishing (server-only — NEVER prefix with PUBLIC_)
# ---------------------------------------------------------------------------

# Vercel Deploy Hook used by "Publish changes" in the Content Studio.
# Create it in Vercel → Project → Settings → Git → Deploy Hooks (production branch).
VERCEL_DEPLOY_HOOK_URL=

# Optional: lets the CMS confirm a deployment actually reached READY.
# VERCEL_PROJECT_ID is shown in Vercel → Project → Settings → General.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: direct link for the "Open Vercel deployments" button (rollbacks).
VERCEL_DASHBOARD_URL=

# Post-build report back to the running site (set these on Vercel too):
# PUBLISH_REPORT_URL=https://your-domain/api/internal/publish-report
# PUBLISH_REPORT_SECRET=<random string shared with the running deployment>

# Build-time switches (normally set by the npm scripts, not by hand):
# REQUIRE_SNAPSHOT=1     # fail the Vercel build when the snapshot is missing
# CONTENT_SOURCE=auto    # auto | snapshot | d1 (dev defaults to live D1)

