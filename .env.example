# Signing secret for session cookies. Generate with: openssl rand -hex 32
APP_SECRET=change-me-in-production

# Where the SQLite database and legacy uploaded images live.
DATA_DIR=./data

# Optional: comma separated module ids to disable, e.g. "gallery,contact"
DISABLED_MODULES=

# Admin password (defaults to 'admin' if not set)
ADMIN_PASSWORD=admin

# Filebase (S3-compatible) object storage.
# Leave the bucket and keys empty to use the in-memory mock storage driver.
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto
FILEBASE_BUCKET=
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
# Optional public URL prefix for stored objects.
# Defaults to https://{FILEBASE_BUCKET}.s3.filebase.io
FILEBASE_PUBLIC_BASE_URL=

# Optional driver override: filebase | mock
STORAGE_DRIVER=

# Storage quotas in bytes.
# Gallery defaults to 3 GiB, other assets default to 1 GiB.
GALLERY_STORAGE_LIMIT_BYTES=3221225472
ASSET_STORAGE_LIMIT_BYTES=1073741824
