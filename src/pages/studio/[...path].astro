---
import { getSanityConfig, isSanityConfigured } from '../../core/sanity/config';
import { site } from '../../core/config';
import '../../styles/tokens.css';
import '../../styles/base.css';

const config = getSanityConfig();
const configured = isSanityConfigured();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sanity Studio · {site.name}</title>
    <link rel="icon" type="image/svg+xml" href={site.logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: #101112;
        color: #f1f3f5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      .studio-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
        background: #18191a;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        height: 44px;
        box-sizing: border-box;
      }
      .studio-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
      }
      .studio-brand img {
        width: 24px;
        height: 24px;
      }
      .studio-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 9999px;
        background: rgba(212, 175, 55, 0.15);
        color: #e0b868;
        border: 1px solid rgba(212, 175, 55, 0.3);
      }
      .studio-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .studio-action-link {
        font-size: 12px;
        color: #9ca3af;
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .studio-action-link:hover {
        color: #fff;
      }
      .studio-main {
        height: calc(100vh - 44px);
        width: 100vw;
      }
      .studio-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding: 24px;
        box-sizing: border-box;
      }
      .studio-card {
        max-width: 480px;
        background: #1f2937;
        border: 1px solid #374151;
        border-radius: 12px;
        padding: 32px;
        text-align: center;
      }
      .studio-card h2 {
        margin: 0 0 12px;
        font-size: 20px;
        color: #fff;
      }
      .studio-card p {
        color: #9ca3af;
        font-size: 14px;
        line-height: 1.5;
        margin: 0 0 20px;
      }
      .studio-btn {
        display: inline-block;
        background: #d4af37;
        color: #1a0208;
        padding: 9px 18px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header class="studio-header">
      <div style="display: flex; align-items: center; gap: 12px;">
        <a href="/" class="studio-brand">
          <img src={site.logo} alt="" />
          <span>{site.name}</span>
        </a>
        <span class="studio-badge">Sanity Studio</span>
      </div>
      <div class="studio-actions">
        {configured && (
          <span style="font-size: 11px; color: #9ca3af;">
            Dataset: <strong>{config.dataset}</strong>
          </span>
        )}
        <a href="https://sanity.io/manage" target="_blank" rel="noopener noreferrer" class="studio-action-link">
          Sanity Manage ↗
        </a>
        <a href="/" class="studio-action-link">
          View Website ↗
        </a>
      </div>
    </header>

    <main class="studio-main">
      {!configured ? (
        <div class="studio-empty">
          <div class="studio-card">
            <h2>Sanity Project Not Connected</h2>
            <p>
              Please set <code>PUBLIC_SANITY_PROJECT_ID</code> in your deployment environment variables to activate the Sanity Studio.
            </p>
            <a href="https://sanity.io/manage" target="_blank" rel="noopener noreferrer" class="studio-btn">
              Go to Sanity Manage
            </a>
          </div>
        </div>
      ) : (
        <div id="sanity-studio-root" style="height: 100%; width: 100%;"></div>
      )}
    </main>

    {configured && (
      <script>
        import React from 'react';
        import { createRoot } from 'react-dom/client';
        import { Studio } from 'sanity';
        import sanityConfig from '../../../sanity.config';

        const rootEl = document.getElementById('sanity-studio-root');
        if (rootEl) {
          createRoot(rootEl).render(React.createElement(Studio, { config: sanityConfig }));
        }
      </script>
    )}
  </body>
</html>
