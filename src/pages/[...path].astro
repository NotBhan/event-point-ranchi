---
import NotFound from '../components/NotFound.astro';
import { resolvePage } from '../core/registry';

const matched = resolvePage(Astro.url.pathname);
let Page: any = null;
let pageProps: Record<string, unknown> = {};
let response: Response | null = null;

if (!matched) {
  Astro.response.status = 404;
} else {
  const contentType = Astro.request.headers.get('content-type') ?? '';
  const form =
    Astro.request.method === 'POST' && contentType.includes('form')
      ? await Astro.request.formData()
      : null;

  const result = await matched.route.handle({
    request: Astro.request,
    url: Astro.url,
    params: matched.params,
    form,
    auth: Astro.locals.auth,
    csrf: Astro.locals.csrf,
    cookies: Astro.cookies,
  });

  if (result instanceof Response) {
    response = result;
  } else {
    Astro.response.status = result.status ?? 200;
    Page = matched.route.component;
    pageProps = result.props ?? {};
  }
}

if (response) {
  return response;
}
---

{Page ? <Page {...pageProps} /> : <NotFound />}
