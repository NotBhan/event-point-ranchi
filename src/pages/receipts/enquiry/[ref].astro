---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getSiteSettings } from '../../../core/content/service';
import { getEnquiryReceiptService } from '../../../core/operational/enquiry-receipt-service';

const settings = await getSiteSettings();
const brandName = settings.name || 'Event Point Ranchi';

const { ref } = Astro.params;
const tokenParam = Astro.url.searchParams.get('token') || '';

const receiptService = getEnquiryReceiptService(Astro.url.origin);
let receiptData = null;
let notFound = false;

const lookupKey = tokenParam || ref || '';
if (lookupKey) {
  try {
    receiptData = await receiptService.getEnquiryReceiptData(lookupKey, Astro.url.origin);
    if (!receiptData) {
      notFound = true;
    }
  } catch (err) {
    console.warn('[Enquiry Receipt Lookup Error]:', err);
    notFound = true;
  }
} else {
  notFound = true;
}

const enquiry = receiptData?.enquiry;
const businessInfo = receiptData?.businessInfo;
const token = receiptData?.token || '';
const qrDataUrl = receiptData?.qrDataUrl || '';
const verificationUrl = receiptData?.verificationUrl || '';
const pdfDownloadUrl = enquiry
  ? `/api/enquiries/receipt/${enquiry.referenceCode}/pdf?token=${token}`
  : '#';
---

<BaseLayout
  title={enquiry ? `Enquiry Acknowledgement ${enquiry.referenceCode} | ${brandName}` : `Enquiry Not Found | ${brandName}`}
  description="Official digital enquiry acknowledgement receipt and coordinator check-in pass for Event Point Ranchi."
  noCart
>
  <section class="page-hero no-print">
    <div class="container">
      <span class="eyebrow">Customer Service Desk</span>
      <h1>
        {notFound ? 'Enquiry Record Not Found' : 'Official Enquiry Acknowledgement'}
      </h1>
      <p>
        {notFound
          ? 'We could not locate an event enquiry matching this reference or token in our live system.'
          : 'Thank you for choosing Event Point Ranchi. Below is your official blueprint acknowledgement and instant coordinator check-in slip.'}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px;">
      {notFound || !enquiry ? (
        <div class="panel" style="padding:40px;text-align:center;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);">
          <div style="width:56px;height:56px;border-radius:50%;background:rgba(211,47,47,0.1);color:#d32f2f;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <Icon name="x" size={32} />
          </div>
          <h2 style="font-size:1.4rem;margin:0 0 8px;">Enquiry Reference Not Found</h2>
          <p style="color:var(--muted);font-size:14px;max-width:460px;margin:0 auto 20px;">
            The enquiry code or token “{lookupKey}” could not be verified. Please check the link sent to your phone or contact our team directly.
          </p>
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <a href="/plan" class="btn btn-primary">Create New Blueprint</a>
            <a href="/contact" class="btn btn-secondary">Contact Our Team</a>
            <a href="/" class="btn btn-ghost">Return to Home</a>
          </div>
        </div>
      ) : (
        <div>
          <!-- Top Action Buttons (Hidden on Print) -->
          <div class="no-print" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
            <a href="/plan" class="btn btn-ghost btn-sm">
              <Icon name="arrow-left" size={14} /> Plan Another Event
            </a>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <a href={pdfDownloadUrl} class="btn btn-secondary btn-sm" download>
                <Icon name="download" size={14} /> Download PDF
              </a>
              <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">
                <Icon name="receipt" size={14} /> Print Receipt
              </button>
              <button type="button" class="btn btn-primary btn-sm" id="shareReceiptBtn">
                <Icon name="share" size={14} /> Share Slip
              </button>
            </div>
          </div>

          <!-- Printable Receipt Card -->
          <div class="enquiry-receipt-card print-card" id="enquiryReceiptSheet">
            <!-- Brand & Acknowledgement Header -->
            <div class="receipt-header-row">
              <div class="receipt-brand-col">
                <span class="brand-tag">EVENT POINT RANCHI</span>
                <h2 class="brand-title">Official Enquiry Acknowledgement</h2>
                <p class="brand-sub">Mandap, Stage, Equipment & Wedding Requirements · Ranchi, Jharkhand</p>
                <span class="disclaimer-badge">
                  <Icon name="info" size={13} /> Enquiry Acknowledgement · Not a Confirmed Booking or GST Invoice
                </span>
              </div>
              <div class="receipt-ref-col">
                <span class="ref-label">Enquiry Reference</span>
                <strong class="ref-code">{enquiry.referenceCode}</strong>
                <span class="status-pill">Submitted · Review Pending</span>
              </div>
            </div>

            <div class="gold-divider"></div>

            <!-- Customer & Event Summary Grid -->
            <div class="receipt-grid-2">
              <div class="receipt-subcard">
                <h3>Customer Information</h3>
                <div class="info-row">
                  <span>Name:</span>
                  <strong>{enquiry.customerName}</strong>
                </div>
                <div class="info-row">
                  <span>Phone:</span>
                  <strong>{enquiry.customerPhone}</strong>
                </div>
                {enquiry.customerEmail && (
                  <div class="info-row">
                    <span>Email:</span>
                    <strong>{enquiry.customerEmail}</strong>
                  </div>
                )}
                <div class="info-row">
                  <span>Preferred Contact:</span>
                  <strong>{enquiry.preferredContact || 'Phone'}</strong>
                </div>
              </div>

              <div class="receipt-subcard">
                <h3>Event Specifications</h3>
                <div class="info-row">
                  <span>Event Type:</span>
                  <strong>{enquiry.eventType}</strong>
                </div>
                <div class="info-row">
                  <span>Event Date:</span>
                  <strong>{enquiry.eventDate} {enquiry.eventTime ? `· ${enquiry.eventTime}` : ''}</strong>
                </div>
                <div class="info-row">
                  <span>Venue Location:</span>
                  <strong>{enquiry.venueLocation}</strong>
                </div>
                <div class="info-row">
                  <span>Expected Guests:</span>
                  <strong>{enquiry.guestCount} guests</strong>
                </div>
                <div class="info-row">
                  <span>Approx. Budget:</span>
                  <strong>{enquiry.budgetRange || 'To be finalised'}</strong>
                </div>
              </div>
            </div>

            <!-- Itemized Blueprint Selections Table -->
            <div class="receipt-section">
              <div class="section-head">
                <h3>Requested Blueprint & Inventory Selections</h3>
                <span class="text-xs text-muted">Snapshot of items selected during planning</span>
              </div>

              <div class="table-wrap">
                <table class="receipt-table">
                  <thead>
                    <tr>
                      <th style="width:20%;">Category</th>
                      <th>Item Description</th>
                      <th style="width:30%;">Dimensions / Specs</th>
                      <th style="width:12%;text-align:center;">Qty</th>
                    </tr>
                  </thead>
                  <tbody>
                    {enquiry.items && enquiry.items.length > 0 ? (
                      enquiry.items.map((item) => (
                        <tr>
                          <td><span class="item-cat">{item.itemType}</span></td>
                          <td><strong>{item.name}</strong></td>
                          <td class="text-muted">{item.dimensions || 'Standard specifications'}</td>
                          <td style="text-align:center;"><strong>{item.quantity}</strong></td>
                        </tr>
                      ))
                    ) : (
                      <tr>
                        <td><span class="item-cat">Planning</span></td>
                        <td><strong>{enquiry.eventType} Blueprint Setup</strong></td>
                        <td class="text-muted">Custom curated wedding mandap & décor</td>
                        <td style="text-align:center;">1</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Accommodation & Notes (if any) -->
            {(enquiry.requiresRooms || enquiry.accommodationNotes || enquiry.decorationNotes) && (
              <div class="receipt-notes-card">
                <h4>Special Notes & Accommodation</h4>
                {enquiry.requiresRooms && (
                  <p><strong>Guest Rooms:</strong> {enquiry.roomCount} rooms requested.</p>
                )}
                {enquiry.accommodationNotes && (
                  <p><strong>Room Details:</strong> {enquiry.accommodationNotes}</p>
                )}
                {enquiry.decorationNotes && (
                  <p><strong>Styling & Special Notes:</strong> {enquiry.decorationNotes}</p>
                )}
              </div>
            )}

            <!-- QR Code Check-in Pass Box -->
            <div class="receipt-qr-banner">
              <div class="qr-img-wrap">
                <img src={qrDataUrl} alt={`QR Code for Enquiry ${enquiry.referenceCode}`} />
              </div>
              <div class="qr-text-wrap">
                <span class="qr-badge">Instant Coordinator Check-in QR</span>
                <h4>Rapid Blueprint & Order Retrieval</h4>
                <p>
                  Present this QR code at our studio (Main Road, Ranchi) or show it to our coordinator on-site. Scanning this code instantly pulls up your complete dimensions, equipment specs, and selected items.
                </p>
                <div class="qr-token-footnote">
                  <span>Cryptographic Token: {token.slice(0, 16)}...</span>
                  <span>Verified URL: {verificationUrl}</span>
                </div>
              </div>
            </div>

            <!-- Important Information & Disclaimer -->
            <div class="receipt-notice">
              <strong>What Happens Next:</strong>
              <ol>
                <li><strong>No Payment Required Yet:</strong> Submitting this enquiry does not incur any fee. Your date will be held once availability is verified and a deposit is accepted.</li>
                <li><strong>Coordinator Consultation:</strong> A dedicated event director from Event Point Ranchi will contact you within 24 business hours via {enquiry.preferredContact || 'phone'}.</li>
                <li><strong>Site Visit & Formal Quotation:</strong> We will inspect the venue and present a comprehensive itemised quotation.</li>
              </ol>
            </div>

            <!-- Signatures & Footer -->
            <div class="receipt-footer">
              <div class="sig-col">
                <div class="sig-line"></div>
                <span>Customer Signature</span>
              </div>
              <div class="receipt-contact-center">
                <strong>{businessInfo?.brandName}</strong>
                <span>{businessInfo?.address}</span>
                <span>Phone: {businessInfo?.phone} · Email: {businessInfo?.email}</span>
              </div>
              <div class="sig-col">
                <div class="sig-line"></div>
                <span>Authorized Coordinator</span>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <script>
    const shareBtn = document.getElementById('shareReceiptBtn');
    shareBtn?.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        text: 'Event Point Ranchi — My Event Enquiry Acknowledgement & Blueprint Slip',
        url: window.location.href,
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch {
          // Fallback if dismissed
        }
      } else {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = shareBtn.innerHTML;
        shareBtn.innerHTML = 'Link Copied!';
        window.setTimeout(() => {
          shareBtn.innerHTML = originalText;
        }, 2500);
      }
    });
  </script>
</BaseLayout>

<style>
  .enquiry-receipt-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 36px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    color: var(--ink);
  }

  .receipt-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
  }

  .brand-tag {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--brand-maroon, #721224);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .brand-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 6px;
    color: var(--ink);
  }

  .brand-sub {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .disclaimer-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff8e6;
    color: #8c6d1f;
    border: 1px solid #fae19c;
    border-radius: var(--r-full, 999px);
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .receipt-ref-col {
    text-align: right;
  }

  .ref-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .ref-code {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 1.3rem;
    color: var(--brand-maroon, #721224);
    font-weight: 700;
    margin: 2px 0 6px;
  }

  .status-pill {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 11.5px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .gold-divider {
    height: 3px;
    background: linear-gradient(90deg, #c8a251, #e6ca85, #721224);
    border-radius: 2px;
    margin: 24px 0 28px;
  }

  .receipt-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }

  .receipt-subcard {
    background: var(--canvas-warm, #faf8f5);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 18px 20px;
  }

  .receipt-subcard h3 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-maroon, #721224);
    margin: 0 0 12px;
    font-weight: 700;
    border-bottom: 1px solid var(--line);
    padding-bottom: 6px;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    line-height: 1.6;
    padding: 3px 0;
  }

  .info-row span {
    color: var(--muted);
  }

  .info-row strong {
    color: var(--ink);
    text-align: right;
  }

  .receipt-section {
    margin-bottom: 28px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
  }

  .section-head h3 {
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .receipt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .receipt-table th {
    background: #f1f5f9;
    padding: 9px 12px;
    text-align: left;
    font-weight: 600;
    color: #475569;
    font-size: 12px;
    border-bottom: 1px solid var(--line);
  }

  .receipt-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
  }

  .item-cat {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--brand-maroon, #721224);
    background: #fdf2f4;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .receipt-notes-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--r-md);
    padding: 14px 18px;
    font-size: 13px;
    margin-bottom: 28px;
  }

  .receipt-notes-card h4 {
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--ink);
  }

  .receipt-notes-card p {
    margin: 4px 0;
    color: var(--body);
  }

  .receipt-qr-banner {
    display: flex;
    align-items: center;
    gap: 24px;
    background: #fbfbfb;
    border: 1.5px dashed var(--gold, #c8a251);
    border-radius: var(--r-md);
    padding: 20px;
    margin-bottom: 28px;
  }

  .qr-img-wrap {
    flex-shrink: 0;
    width: 110px;
    height: 110px;
    background: #fff;
    padding: 6px;
    border-radius: var(--r-sm);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .qr-img-wrap img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .qr-text-wrap {
    flex: 1;
  }

  .qr-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    color: #8c6d1f;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .qr-text-wrap h4 {
    margin: 0 0 6px;
    font-size: 15px;
    color: var(--ink);
  }

  .qr-text-wrap p {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 8px;
  }

  .qr-token-footnote {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 10.5px;
    color: #94a3b8;
    font-family: var(--font-mono, monospace);
  }

  .receipt-notice {
    background: #fef2f2;
    border: 1px solid #fee2e2;
    border-radius: var(--r-md);
    padding: 16px 20px;
    font-size: 12.5px;
    color: #991b1b;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .receipt-notice strong {
    display: block;
    font-size: 13px;
    margin-bottom: 6px;
  }

  .receipt-notice ol {
    margin: 0;
    padding-left: 18px;
  }

  .receipt-notice li {
    margin-bottom: 4px;
  }

  .receipt-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid var(--line);
    padding-top: 32px;
    margin-top: 20px;
    gap: 16px;
  }

  .sig-col {
    width: 170px;
    text-align: center;
  }

  .sig-line {
    border-bottom: 1px solid #cbd5e1;
    height: 36px;
    margin-bottom: 6px;
  }

  .sig-col span {
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .receipt-contact-center {
    text-align: center;
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.5;
  }

  .receipt-contact-center strong {
    display: block;
    color: var(--ink);
    font-size: 12.5px;
  }

  /* Print Stylesheet for A4 Portrait */
  @media print {
    .no-print,
    .page-hero,
    header,
    footer,
    #pageProgressBar,
    .skip-link {
      display: none !important;
    }

    body {
      background: #ffffff !important;
      color: #000000 !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .container {
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .enquiry-receipt-card {
      border: none !important;
      box-shadow: none !important;
      padding: 10mm 15mm !important;
    }

    @page {
      size: A4 portrait;
      margin: 8mm;
    }
  }

  @media (max-width: 680px) {
    .receipt-grid-2 {
      grid-template-columns: 1fr;
    }
    .receipt-qr-banner {
      flex-direction: column;
      text-align: center;
    }
    .receipt-footer {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
    .receipt-ref-col {
      text-align: left;
    }
  }
</style>
