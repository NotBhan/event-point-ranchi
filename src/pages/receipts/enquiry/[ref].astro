---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import CanonicalDocument from '../../../components/documents/CanonicalDocument.astro';
import { getSiteSettings } from '../../../core/content/service';
import { getEnquiryReceiptService } from '../../../core/operational/enquiry-receipt-service';
import { buildEnquiryDocument } from '../../../core/documents/canonical';
import { resolveReceiptLookup } from '../../../core/documents/receipt-access';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Pragma', 'no-cache');

const settings = await getSiteSettings();
const brandName = settings.name || 'Event Point Ranchi';
const { ref } = Astro.params;
const tokenParam = Astro.url.searchParams.get('token') || '';
const lookup = resolveReceiptLookup(ref, tokenParam, Boolean(Astro.locals.adminAuth?.isAdmin));

let receiptData = null;
let notFound = !lookup.allowed;
let serviceError = false;

if (lookup.allowed) {
  try {
    receiptData = await getEnquiryReceiptService(Astro.url.origin).getEnquiryReceiptData(lookup.key, Astro.url.origin);
    if (!receiptData) notFound = true;
  } catch (error) {
    console.error('[Enquiry Receipt Lookup Error]:', error);
    serviceError = true;
  }
}

const enquiry = receiptData?.enquiry;
const document = receiptData ? buildEnquiryDocument(receiptData) : null;
---

<BaseLayout
  title={enquiry ? `Enquiry Acknowledgement ${enquiry.referenceCode} | ${brandName}` : `Enquiry Not Found | ${brandName}`}
  description="Official enquiry acknowledgement and quotation document for Event Point Ranchi."
  noCart
  noDock
>
  <section class="page-hero no-print">
    <div class="container">
      <span class="eyebrow">Customer Service Desk</span>
      <h1>
        {serviceError ? 'Verification Temporarily Unavailable' : notFound ? 'Enquiry Record Not Found' : 'Enquiry Acknowledgement'}
      </h1>
      <p>
        {serviceError
          ? 'Our verification service could not be reached just now. Your enquiry is safe — please retry in a moment.'
          : notFound
            ? 'This secure document link is missing or invalid. Open the link from your enquiry confirmation or contact our team.'
            : 'Below is your official enquiry record in the same document format used for quotations and bookings.'}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {notFound || !enquiry || !document ? (
        <div class="panel" style="max-width:620px;margin:0 auto;padding:40px;text-align:center;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);">
          <div style="width:56px;height:56px;border-radius:50%;background:rgba(211,47,47,0.1);color:#d32f2f;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <Icon name="x" size={32} />
          </div>
          <h2 style="font-size:1.4rem;margin:0 0 8px;">{serviceError ? 'Verification Temporarily Unavailable' : 'Secure Link Required'}</h2>
          <p style="color:var(--muted);font-size:14px;max-width:460px;margin:0 auto 20px;">
            This document contains private customer details. Use the tokenised link from your confirmation email or contact our team for a replacement link.
          </p>
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <a href="/plan" class="btn btn-primary">Create New Blueprint</a>
            <a href="/contact" class="btn btn-secondary">Contact Our Team</a>
          </div>
        </div>
      ) : (
        <>
          <div class="no-print" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
            <a href="/plan" class="btn btn-ghost btn-sm"><Icon name="arrow-left" size={14} /> Plan Another Event</a>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <button type="button" class="btn btn-secondary btn-sm" data-print>
                <Icon name="print" size={14} /> Print / save as PDF
              </button>
              <button type="button" class="btn btn-primary btn-sm" id="shareReceiptBtn">
                <Icon name="share" size={14} /> Share
              </button>
            </div>
          </div>

          <CanonicalDocument
            document={document}
            qrDataUrl={receiptData?.qrDataUrl}
            verificationUrl={receiptData?.verificationUrl}
          />
        </>
      )}
    </div>
  </section>

  <script>
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    document.getElementById('shareReceiptBtn')?.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        text: 'Event Point Ranchi — official enquiry document',
        url: window.location.href,
      };
      if (navigator.share) {
        try { await navigator.share(shareData); } catch {}
      } else {
        await navigator.clipboard.writeText(window.location.href);
      }
    });
  </script>
</BaseLayout>
