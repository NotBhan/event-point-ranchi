---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Event Point" noCart>
  <section class="section">
    <div class="container">
      <div style="max-width: 620px; margin: 40px auto; text-align:center;">
        <div class="error-code">404</div>
        <span class="badge badge-gold mt-4">Page not found</span>
        <h1 class="display-lg mt-4">This page has left the venue.</h1>
        <p class="lead mt-3">
          The link may be outdated, or the page has moved. Let us get you back to planning.
        </p>
        <div class="flex-center gap-3 mt-8 wrap">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/mandaps" class="btn btn-secondary">Explore mandaps</a>
          <a href="/contact" class="btn btn-ghost">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
