---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  path?: string;
}

const { path = '' } = Astro.props;

if (Astro.response) {
  Astro.response.status = 404;
}
---

<BaseLayout title="Page Not Found | Event Point Ranchi" noCart>
  <main class="section py-16" style="background: radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.05) 0%, transparent 70%);">
    <div class="container">
      <div style="max-width: 760px; margin: 20px auto 48px; text-align: center;">
        <div class="error-badge mb-4">
          <span class="badge badge-gold font-mono" style="font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase;">
            Status 404 · Venue Not Found
          </span>
        </div>

        <h1 class="display-lg mb-4" style="font-family: var(--font-heading); color: var(--ink); line-height: 1.15;">
          This Page Has Left the Venue
        </h1>

        <p class="lead text-muted mb-8" style="max-width: 580px; margin-left: auto; margin-right: auto; line-height: 1.6;">
          The celebration or blueprint you are searching for may have been moved, renamed, or is temporarily unavailable. Let us help guide you back to crafting your celebration.
        </p>

        {path && (
          <div class="muted-box mb-8 inline-block" style="display: inline-block; font-family: var(--font-mono); font-size: 0.85rem; padding: 6px 16px; border-radius: 9999px;">
            Requested path: <span style="color: var(--primary-color); font-weight: 600;">{path}</span>
          </div>
        )}

        <div class="flex-center gap-3 mb-12 wrap">
          <a href="/" class="btn btn-primary" style="padding: 12px 24px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: text-bottom;">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Return to Homepage
          </a>
          <a href="/plan" class="btn btn-secondary" style="padding: 12px 24px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: text-bottom;">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            Plan Your Event
          </a>
          <a href="/contact" class="btn btn-ghost" style="padding: 12px 24px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: text-bottom;">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Contact Concierge
          </a>
        </div>
      </div>

      <!-- Quick Navigation & Curated Destinations -->
      <div style="max-width: 980px; margin: 0 auto;">
        <h2 class="display-sm text-center mb-6" style="font-size: 1.25rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--body);">
          Popular Destinations
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
          <a href="/mandaps" class="card p-5" style="text-decoration: none; display: block; border-radius: 12px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div style="font-size: 1.5rem; margin-bottom: 8px;">🏛️</div>
            <h3 style="font-size: 1.1rem; font-weight: 600; color: var(--ink); margin-bottom: 6px;">Royal Mandaps</h3>
            <p style="font-size: 0.88rem; color: var(--body); line-height: 1.5; margin: 0;">
              Traditional carved wooden, fiber glass, and fresh floral royal mandaps in Ranchi.
            </p>
          </a>

          <a href="/gallery" class="card p-5" style="text-decoration: none; display: block; border-radius: 12px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div style="font-size: 1.5rem; margin-bottom: 8px;">📸</div>
            <h3 style="font-size: 1.1rem; font-weight: 600; color: var(--ink); margin-bottom: 6px;">Design Gallery</h3>
            <p style="font-size: 0.88rem; color: var(--body); line-height: 1.5; margin: 0;">
              Browse high-resolution photographs of real stages, light setups, and decor.
            </p>
          </a>

          <a href="/stages" class="card p-5" style="text-decoration: none; display: block; border-radius: 12px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div style="font-size: 1.5rem; margin-bottom: 8px;">✨</div>
            <h3 style="font-size: 1.1rem; font-weight: 600; color: var(--ink); margin-bottom: 6px;">Stage Designs</h3>
            <p style="font-size: 0.88rem; color: var(--body); line-height: 1.5; margin: 0;">
              Grand reception backdrops, modern geometric styling, and floral arches.
            </p>
          </a>

          <a href="/plan" class="card p-5" style="text-decoration: none; display: block; border-radius: 12px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div style="font-size: 1.5rem; margin-bottom: 8px;">📋</div>
            <h3 style="font-size: 1.1rem; font-weight: 600; color: var(--ink); margin-bottom: 6px;">Event Blueprint</h3>
            <p style="font-size: 0.88rem; color: var(--body); line-height: 1.5; margin: 0;">
              Customize mandap, stage, furniture, and sound specs with instant itemized estimates.
            </p>
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

