---
import { site } from '../core/config';
import { getNav } from '../core/registry';
import type { MergedSiteSettings } from '../core/content/service';
import Icon from './Icon.astro';

interface Props {
  settings?: MergedSiteSettings;
}

const { settings } = Astro.props;
const brandName = settings?.name || site.name;
const logoUrl = settings?.logo || site.logo;
const phone = settings?.phone || site.phone;
const phoneHref = `tel:${phone.replace(/\s/g, '')}`;

const auth = Astro.locals.auth;
const csrf = Astro.locals.csrf;
const path = Astro.url.pathname;
const nav = getNav();

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="announcement-bar">
  <div class="container announcement-inner">
    <span class="announcement-item">
      <Icon name="pin" size={13} />
      Wedding planning across Ranchi &amp; Jharkhand
    </span>
    <span class="announcement-item announcement-mid">
      {settings?.announcementText || 'Mandaps, stage designs, furniture & equipment — enquiries are quotations, not automatic bookings'}
    </span>
    {settings?.contactButtonsEnabled !== false && (
      <a class="announcement-item announcement-phone" href={phoneHref}>
        <Icon name="phone" size={13} />
        {phone}
      </a>
    )}
  </div>
</div>

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${brandName} home`}>
      <img src={logoUrl} alt={brandName} width="42" height="42" />
      <span class="brand-text">
        <strong>{brandName}</strong>
        <span>Mandap · Stage · Equipment</span>
      </span>
    </a>

    <nav class="nav-menu" id="primaryNav" aria-label="Primary navigation">
      <div class="nav-drawer-head">
        <div class="nav-drawer-brand">
          <img src={logoUrl} alt="" width="32" height="32" />
          <div class="nav-drawer-brand-text">
            <strong>{brandName}</strong>
            <span>Mandap · Stage · Equipment</span>
          </div>
        </div>
        <button type="button" class="nav-close-btn" data-nav-close aria-label="Close menu">
          <Icon name="x" size={18} strokeWidth={2.2} />
        </button>
      </div>

      <div class="nav-drawer-links">
        {nav.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            <span>{item.label}</span>
            <Icon name="chevron-right" size={14} class="nav-link-arrow" />
          </a>
        ))}
      </div>

      <div class="nav-drawer-footer">
        <a class="nav-drawer-phone" href={phoneHref}>
          <Icon name="phone" size={14} />
          <span>Call: {phone}</span>
        </a>
        <div class="nav-mobile-actions">
          <a href="/plan" class="btn btn-primary btn-block">Plan Your Event</a>
          <a href="/plan" class="btn btn-secondary btn-block nav-requirements-btn">
            <Icon name="receipt" size={15} />
            <span>View requirements</span>
            <span class="requirements-count" data-requirements-count>0</span>
          </a>
        </div>
      </div>
    </nav>

    <div class="nav-actions">
      <a href="/plan" class="requirements-link" aria-label="View your event requirements">
        <Icon name="receipt" size={16} />
        <span class="requirements-label">Requirements</span>
        <span class="requirements-count" data-requirements-count>0</span>
      </a>

      <a href="/plan" class="btn btn-primary btn-sm header-cta">Plan Your Event</a>

      {auth.user ? (
        <div class="user-menu" data-user-menu>
          <button type="button" class="user-menu-btn" data-user-toggle aria-expanded="false">
            <span class="avatar" style="width:26px;height:26px;font-size:10px;">{auth.user.firstName.slice(0, 1).toUpperCase()}</span>
            <span class="user-menu-btn-name">{auth.user.firstName}</span>
            <Icon name="chevron-down" size={11} strokeWidth={2} />
          </button>
          <div class="user-menu-panel" role="menu" aria-label="User account menu">
            <!-- User Profile Summary Header -->
            <div class="user-menu-profile-card">
              <div class="user-menu-profile-avatar">
                <span>{auth.user.firstName.slice(0, 1).toUpperCase()}</span>
              </div>
              <div class="user-menu-profile-meta">
                <span class="user-menu-profile-name">{auth.user.firstName}</span>
                <span class="user-menu-profile-sub">
                  {auth.user.email || `@${auth.user.username}`}
                </span>
                <span class={`user-menu-role-tag ${auth.isAdmin ? 'role-staff' : 'role-client'}`}>
                  {auth.isAdmin ? 'Staff Administrator' : 'Client Account'}
                </span>
              </div>
            </div>

            <div class="user-menu-section-label">My Account</div>

            <nav class="user-menu-links">
              <a href="/profile" class="user-menu-item" role="menuitem">
                <span class="user-menu-item-icon"><Icon name="user" size={15} /></span>
                <div class="user-menu-item-content">
                  <span class="user-menu-item-title">My profile</span>
                  <span class="user-menu-item-desc">Personal details & security</span>
                </div>
              </a>

              <a href="/my-bookings" class="user-menu-item" role="menuitem">
                <span class="user-menu-item-icon"><Icon name="calendar" size={15} /></span>
                <div class="user-menu-item-content">
                  <span class="user-menu-item-title">My bookings</span>
                  <span class="user-menu-item-desc">Reservations & receipts</span>
                </div>
              </a>

              <a href="/plan" class="user-menu-item" role="menuitem">
                <span class="user-menu-item-icon"><Icon name="receipt" size={15} /></span>
                <div class="user-menu-item-content">
                  <span class="user-menu-item-title">Event requirements</span>
                  <span class="user-menu-item-desc">Saved wishlist & drafts</span>
                </div>
              </a>

              {auth.isAdmin && (
                <>
                  <div class="user-menu-divider" />
                  <div class="user-menu-section-label">Operations</div>

                  <a href="/admin" class="user-menu-item admin-featured-item" role="menuitem">
                    <span class="user-menu-item-icon admin-icon"><Icon name="dashboard" size={15} /></span>
                    <div class="user-menu-item-content">
                      <span class="user-menu-item-title">
                        Admin console
                        <span class="user-menu-badge-staff">Staff</span>
                      </span>
                      <span class="user-menu-item-desc">Bookings, content & catalogue</span>
                    </div>
                  </a>

                  <a href="/admin/enquiries/scan" class="user-menu-item" role="menuitem">
                    <span class="user-menu-item-icon"><Icon name="ticket" size={15} /></span>
                    <div class="user-menu-item-content">
                      <span class="user-menu-item-title">Scan Enquiry QR</span>
                      <span class="user-menu-item-desc">Camera & code scanner</span>
                    </div>
                  </a>
                </>
              )}
            </nav>

            <div class="user-menu-divider" />

            <!-- Logout action -->
            <form method="POST" action="/logout" class="user-menu-logout-form">
              <input type="hidden" name="_csrf" value={csrf} />
              <button type="submit" class="user-menu-item user-menu-logout-btn" role="menuitem">
                <span class="user-menu-item-icon logout-icon"><Icon name="logout" size={15} /></span>
                <div class="user-menu-item-content">
                  <span class="user-menu-item-title">Log out</span>
                </div>
              </button>
            </form>
          </div>
        </div>
      ) : (
        <a href="/admin/login" class="header-staff-link" aria-label="Staff console">Staff</a>
      )}

      <button type="button" class="nav-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
  <div class="nav-backdrop" data-nav-close></div>
</header>
