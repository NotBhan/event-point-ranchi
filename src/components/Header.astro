---
import { site } from '../core/config';
import { getNav } from '../core/registry';
import Icon from './Icon.astro';

const auth = Astro.locals.auth;
const csrf = Astro.locals.csrf;
const path = Astro.url.pathname;
const nav = getNav();

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const phoneHref = `tel:${site.phone.replace(/\s/g, '')}`;
---

<div class="announcement-bar">
  <div class="container announcement-inner">
    <span class="announcement-item">
      <Icon name="pin" size={13} />
      Wedding planning across Ranchi &amp; Jharkhand
    </span>
    <span class="announcement-item announcement-mid">
      Mandaps, stage designs, furniture &amp; equipment — enquiries are quotations, not automatic bookings
    </span>
    <a class="announcement-item announcement-phone" href={phoneHref}>
      <Icon name="phone" size={13} />
      {site.phone}
    </a>
  </div>
</div>

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img src={site.logo} alt={site.name} width="42" height="42" />
      <span class="brand-text">
        <strong>{site.name}</strong>
        <span>Mandap · Stage · Equipment</span>
      </span>
    </a>

    <nav class="nav-menu" id="primaryNav" aria-label="Primary navigation">
      <div class="nav-drawer-head">
        <div class="nav-drawer-brand">
          <img src={site.logo} alt="" width="32" height="32" />
          <div class="nav-drawer-brand-text">
            <strong>{site.name}</strong>
            <span>Mandap · Stage · Equipment</span>
          </div>
        </div>
        <button type="button" class="nav-close-btn" data-nav-close aria-label="Close menu">
          <Icon name="x" size={18} strokeWidth={2.2} />
        </button>
      </div>

      <div class="nav-drawer-links">
        {nav.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            <span>{item.label}</span>
            <Icon name="chevron-right" size={14} class="nav-link-arrow" />
          </a>
        ))}
      </div>

      <div class="nav-drawer-footer">
        <a class="nav-drawer-phone" href={phoneHref}>
          <Icon name="phone" size={14} />
          <span>Call: {site.phone}</span>
        </a>
        <div class="nav-mobile-actions">
          <a href="/plan" class="btn btn-primary btn-block">Plan Your Event</a>
          <a href="/plan" class="btn btn-secondary btn-block nav-requirements-btn">
            <Icon name="receipt" size={15} />
            <span>View requirements</span>
            <span class="requirements-count" data-requirements-count>0</span>
          </a>
        </div>
      </div>
    </nav>

    <div class="nav-actions">
      <a href="/plan" class="requirements-link" aria-label="View your event requirements">
        <Icon name="receipt" size={16} />
        <span class="requirements-label">Requirements</span>
        <span class="requirements-count" data-requirements-count>0</span>
      </a>

      <a href="/plan" class="btn btn-primary btn-sm header-cta">Plan Your Event</a>

      {auth.user ? (
        <div class="user-menu" data-user-menu>
          <button type="button" class="user-menu-btn" data-user-toggle aria-expanded="false">
            <span class="avatar" style="width:26px;height:26px;font-size:10px;">{auth.user.firstName.slice(0, 1).toUpperCase()}</span>
            <span>{auth.user.firstName}</span>
            <Icon name="chevron-down" size={11} strokeWidth={2} />
          </button>
          <div class="user-menu-panel">
            <a href="/profile"><Icon name="user" size={15} /> My profile</a>
            <a href="/plan"><Icon name="receipt" size={15} /> Event requirements</a>
            <a href="/my-bookings"><Icon name="calendar" size={15} /> My bookings</a>
            {auth.isAdmin && (
              <a href="/admin"><Icon name="dashboard" size={15} /> Admin console</a>
            )}
            <div class="user-menu-divider"></div>
            <form method="POST" action="/logout">
              <input type="hidden" name="_csrf" value={csrf} />
              <button type="submit" class="user-menu-link danger-link">
                <Icon name="logout" size={15} /> Log out
              </button>
            </form>
          </div>
        </div>
      ) : (
        <a href="/admin/login" class="header-staff-link" aria-label="Staff console">Staff</a>
      )}

      <button type="button" class="nav-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
  <div class="nav-backdrop" data-nav-close></div>
</header>
