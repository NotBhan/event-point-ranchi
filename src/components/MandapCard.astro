---
import Icon from './Icon.astro';
import { responsiveImage } from '../core/media';

interface Props {
  mandap: {
    id: number;
    name: string;
    slug: string;
    description: string;
    image: string | null;
    category: string;
    length_ft: number;
    width_ft: number;
    height_ft: number;
    dimension_unit: string;
  };
}

const { mandap } = Astro.props;
const dimensions = `${mandap.length_ft} × ${mandap.width_ft} × ${mandap.height_ft} ${mandap.dimension_unit}`;
const image = responsiveImage(mandap.image, {
  widths: [320, 480, 640],
  sizes: '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px',
});
---

<article class="catalogue-card">
  <a class="catalogue-media" href={`/mandaps/${mandap.slug}`} aria-label={`View ${mandap.name}`}>
    {mandap.image ? (
      <div class="media-with-skeleton" style="width: 100%; height: 100%;">
        <div class="skeleton-placeholder skeleton-shimmer" role="status" aria-busy="true" aria-label="Loading image..."></div>
        <img src={image.src} srcset={image.srcset} sizes={image.sizes} width="640" height="480" alt={mandap.name} loading="lazy" decoding="async" />
        <div class="skeleton-error-fallback" role="alert">
          <Icon name="image" size={24} />
          <span>Image preview unavailable</span>
        </div>
      </div>
    ) : (
      <div class="catalogue-media-fallback"><Icon name="archway" size={40} /></div>
    )}
    <span class="catalogue-badge">{mandap.category}</span>
  </a>

  <div class="catalogue-body">
    <h3><a href={`/mandaps/${mandap.slug}`}>{mandap.name}</a></h3>
    <p class="catalogue-description">{mandap.description}</p>

    <div class="dimension-strip">
      <Icon name="archway" size={15} />
      <span>Standard size</span>
      <strong>{dimensions}</strong>
    </div>

    <div class="catalogue-foot">
      <a href={`/mandaps/${mandap.slug}`} class="btn btn-secondary btn-sm">View details</a>
      <button
        type="button"
        class="btn btn-primary btn-sm"
        data-add-mandap
        data-id={mandap.id}
        data-slug={mandap.slug}
        data-name={mandap.name}
        data-category={mandap.category}
        data-image={mandap.image ?? ''}
        data-length={mandap.length_ft}
        data-width={mandap.width_ft}
        data-height={mandap.height_ft}
        data-unit={mandap.dimension_unit}
        aria-pressed="false"
      >
        Add to Requirements
      </button>
    </div>
  </div>
</article>
