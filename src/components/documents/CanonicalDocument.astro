---
import { formatDate, formatDateTime, formatMoney } from '../../core/http';
import type { CanonicalDocumentData } from '../../core/documents/canonical';

interface Props {
  document: CanonicalDocumentData;
  qrDataUrl?: string;
  verificationUrl?: string;
  shareUrl?: string;
}

const { document, qrDataUrl = '', verificationUrl = '' } = Astro.props;
const f = document.financials;
const hasFinancials = Boolean(f);
const isLegacy = Boolean(document.isLegacy);
---

<article class="canonical-document" id="canonicalDocument">
  <div class="canonical-head">
    <div class="canonical-brand">
      <img src="/images/event-point-logo.svg" alt="" width="54" height="54" />
      <div>
        <span class="canonical-eyebrow">Event Point Ranchi</span>
        <h1>{document.documentType}</h1>
        <p>Mandap, Stage, Equipment &amp; Wedding Requirements · Ranchi, Jharkhand</p>
      </div>
    </div>
    <div class="canonical-meta">
      <span class="canonical-label">Document reference</span>
      <strong>{document.documentNumber}</strong>
      {document.reference !== document.documentNumber && <span class="canonical-subref">Enquiry {document.reference}</span>}
      <span class="canonical-status">{document.status}</span>
    </div>
  </div>

  <div class="canonical-grid">
    <section class="canonical-card">
      <h2>Customer</h2>
      <dl>
        <div><dt>Name</dt><dd>{document.customer.name}</dd></div>
        <div><dt>Phone</dt><dd>{document.customer.phone || '—'}</dd></div>
        <div><dt>Email</dt><dd>{document.customer.email || '—'}</dd></div>
        {document.customer.address && <div><dt>Address</dt><dd>{document.customer.address}</dd></div>}
      </dl>
    </section>
    <section class="canonical-card">
      <h2>Event</h2>
      <dl>
        <div><dt>Date</dt><dd>{formatDate(document.event.date)} {document.event.time ? `· ${document.event.time}` : ''}</dd></div>
        <div><dt>Type</dt><dd>{document.event.type}</dd></div>
        <div><dt>Guests</dt><dd>{document.event.guests}</dd></div>
        <div><dt>Venue</dt><dd>{document.event.venue || 'To be confirmed'}</dd></div>
        <div><dt>Prepared</dt><dd>{formatDateTime(document.preparedAt)}</dd></div>
      </dl>
    </section>
  </div>

  {document.details && document.details.length > 0 && (
    <section class="canonical-section canonical-detail-section">
      <h2>Additional event details</h2>
      <dl class="canonical-detail-grid">
        {document.details.map((detail) => (
          <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>
        ))}
      </dl>
    </section>
  )}

  <section class="canonical-section">
    <div class="canonical-section-head">
      <h2>Itemised selections</h2>
      {document.quotationVersion && <span class="badge badge-gold">Quotation v{document.quotationVersion}</span>}
    </div>

    {isLegacy ? (
      <div class="canonical-note">
        <strong>Legacy booking record.</strong> The original itemised breakdown is unavailable. The total is preserved as recorded.
      </div>
    ) : document.lines.length === 0 ? (
      <div class="canonical-note">No catalogue line items were recorded for this document.</div>
    ) : (
      <div class="canonical-table-wrap">
        <table class="canonical-table">
          <thead>
            <tr>
              <th>Category</th>
              <th>Description</th>
              <th class="num">Qty</th>
              <th class="num">Unit</th>
              <th class="num">Amount</th>
            </tr>
          </thead>
          <tbody>
            {document.lines.map((line) => (
              <tr>
                <td><span class="canonical-category">{line.category}</span></td>
                <td>
                  {line.description}
                  {line.note && <small>{line.note}</small>}
                </td>
                <td class="num">{line.quantity}</td>
                <td class="num">
                  {line.onRequest || line.unitPricePaise === null || line.unitPricePaise <= 0
                    ? <span class="on-request">Price on request</span>
                    : formatMoney(line.unitPricePaise)}
                </td>
                <td class="num">
                  {line.onRequest || line.amountPaise === null
                    ? <span class="on-request">Price on request</span>
                    : formatMoney(line.amountPaise)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  {hasFinancials && f && (
    <section class="canonical-financials">
      <div><span>Agreed total</span><strong>{formatMoney(f.totalPaise)}</strong></div>
      <div><span>Required deposit</span><strong>{formatMoney(f.requiredDepositPaise)}</strong></div>
      <div><span>Amount received</span><strong>{formatMoney(f.amountPaidPaise)}</strong></div>
      <div><span>Outstanding balance</span><strong>{formatMoney(f.outstandingBalancePaise)}</strong></div>
      <div class="canonical-due"><span>Amount due now</span><strong>{formatMoney(f.amountDueNowPaise)}</strong></div>
      <div class="canonical-payment"><span>Payment status</span><strong>{String(f.paymentStatus).replace(/_/g, ' ').toUpperCase()}</strong></div>
    </section>
  )}

  {document.notes && (
    <section class="canonical-section">
      <h2>Notes &amp; requests</h2>
      <p class="canonical-notes">{document.notes}</p>
    </section>
  )}

  {qrDataUrl && (
    <section class="canonical-qr">
      <img src={qrDataUrl} alt="Document verification QR code" width="104" height="104" />
      <div>
        <span class="canonical-label">Coordinator check-in</span>
        <strong>Scan to retrieve this record</strong>
        {verificationUrl && <span class="canonical-subref">{verificationUrl}</span>}
      </div>
    </section>
  )}

  <section class="canonical-terms">
    <h2>Terms &amp; notes</h2>
    <ul>
      {document.terms.map((term) => <li>{term}</li>)}
    </ul>
  </section>

  <div class="canonical-footer">
    <div class="canonical-sign"><span></span><p>Customer signature</p></div>
    <div class="canonical-contact">
      <strong>{document.business.name}</strong>
      <span>{document.business.address}</span>
      <span>{document.business.phone ? `Phone: ${document.business.phone}` : ''}{document.business.email ? ` · ${document.business.email}` : ''}</span>
    </div>
    <div class="canonical-sign"><span></span><p>Authorised signature</p></div>
  </div>
</article>

<style>
  .canonical-document {
    background: #fff;
    color: #2c1b20;
    border: 1px solid var(--line, #eadfce);
    border-radius: 10px;
    padding: clamp(20px, 4vw, 42px);
    max-width: 960px;
    margin: 0 auto;
    box-shadow: 0 10px 35px rgba(44, 27, 32, 0.06);
  }
  .canonical-head { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; border-bottom: 1px solid #eadfce; padding-bottom: 18px; }
  .canonical-brand { display: flex; gap: 14px; align-items: flex-start; }
  .canonical-brand h1 { margin: 3px 0 5px; font-size: clamp(1.35rem, 3vw, 2rem); line-height: 1.15; }
  .canonical-brand p { margin: 0; color: #75676a; font-size: 12.5px; }
  .canonical-eyebrow, .canonical-label { display: block; color: #9a7b3f; font-size: 10.5px; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; }
  .canonical-meta { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .canonical-meta strong { font-size: 1.05rem; }
  .canonical-subref { color: #75676a; font-size: 11.5px; overflow-wrap: anywhere; }
  .canonical-status { display: inline-block; border: 1px solid #d7c18e; background: #faf4e7; color: #72551f; border-radius: 999px; font-size: 10.5px; letter-spacing: .08em; padding: 4px 9px; text-transform: uppercase; margin-top: 4px; }
  .canonical-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 22px 0; }
  .canonical-card { border: 1px solid #eadfce; border-radius: 8px; padding: 15px 17px; background: #fffdfa; }
  .canonical-card h2, .canonical-section h2, .canonical-terms h2 { margin: 0 0 10px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #72551f; }
  .canonical-card dl { margin: 0; display: flex; flex-direction: column; gap: 7px; }
  .canonical-card dl div { display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px; }
  .canonical-card dt { color: #75676a; }
  .canonical-card dd { margin: 0; text-align: right; font-weight: 600; overflow-wrap: anywhere; }
  .canonical-section { margin: 24px 0; }
  .canonical-detail-section { border-top: 1px solid #eadfce; padding-top: 18px; }
  .canonical-detail-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 20px; margin: 0; }
  .canonical-detail-grid div { display: flex; flex-direction: column; gap: 3px; font-size: 12px; }
  .canonical-detail-grid dt { color: #75676a; }
  .canonical-detail-grid dd { margin: 0; color: #2c1b20; font-weight: 600; overflow-wrap: anywhere; }
  .canonical-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .canonical-section-head h2 { margin: 0; }
  .canonical-table-wrap { overflow-x: auto; border: 1px solid #eadfce; border-radius: 8px; }
  .canonical-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .canonical-table th { text-align: left; background: #f8f2e8; color: #72551f; font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; padding: 10px; border-bottom: 1px solid #eadfce; }
  .canonical-table td { padding: 10px; border-bottom: 1px solid #f0e5d5; vertical-align: top; }
  .canonical-table tr:last-child td { border-bottom: 0; }
  .canonical-table .num { text-align: right; white-space: nowrap; }
  .canonical-table small { display: block; color: #75676a; margin-top: 4px; }
  .canonical-category { font-weight: 600; }
  .on-request { color: #9a7b3f; font-size: 11px; font-weight: 600; }
  .canonical-note { padding: 12px 14px; border-left: 3px solid #b48a3a; background: #faf4e7; font-size: 12.5px; }
  .canonical-financials { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #eadfce; border: 1px solid #eadfce; border-radius: 8px; overflow: hidden; margin: 24px 0; }
  .canonical-financials div { background: #fffdfa; padding: 13px 15px; display: flex; flex-direction: column; gap: 4px; font-size: 12.5px; }
  .canonical-financials span { color: #75676a; }
  .canonical-financials strong { font-size: 1rem; }
  .canonical-due { background: #faf4e7 !important; }
  .canonical-payment { grid-column: span 1; }
  .canonical-notes { white-space: pre-line; margin: 0; font-size: 12.5px; color: #5b4b4f; }
  .canonical-qr { display: flex; align-items: center; gap: 15px; border: 1px solid #eadfce; border-radius: 8px; padding: 12px 15px; margin: 24px 0; background: #fffdfa; }
  .canonical-qr div { display: flex; flex-direction: column; gap: 3px; }
  .canonical-qr strong { font-size: 13px; }
  .canonical-terms { border-top: 1px solid #eadfce; padding-top: 16px; }
  .canonical-terms ul { margin: 0; padding-left: 18px; color: #5b4b4f; font-size: 11.5px; line-height: 1.65; }
  .canonical-footer { display: flex; justify-content: space-between; gap: 20px; align-items: flex-end; border-top: 1px solid #eadfce; margin-top: 24px; padding-top: 18px; }
  .canonical-sign { width: 150px; text-align: center; }
  .canonical-sign span { display: block; border-top: 1px solid #8f7b62; margin-bottom: 6px; }
  .canonical-sign p { margin: 0; color: #75676a; font-size: 10.5px; }
  .canonical-contact { text-align: center; color: #75676a; font-size: 10.5px; display: flex; flex-direction: column; gap: 3px; }
  .canonical-contact strong { color: #2c1b20; }
  @media (max-width: 700px) {
    .canonical-grid, .canonical-financials { grid-template-columns: 1fr; }
    .canonical-detail-grid { grid-template-columns: 1fr; }
    .canonical-head { flex-direction: column; }
    .canonical-meta { align-items: flex-start; text-align: left; }
    .canonical-footer { flex-direction: column; align-items: center; }
  }
  @media print {
    .canonical-document { box-shadow: none; border: 0; border-radius: 0; max-width: none; padding: 0; }
    .canonical-table-wrap { overflow: visible; }
    .canonical-document { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
