---
import Skeleton from './Skeleton.astro';

interface Props {
  aspectRatio?: string;
  height?: string;
  class?: string;
}

const { aspectRatio = '4/3', height = '260px', class: className = '' } = Astro.props;
---

<article
  class:list={['plate', 'skeleton-card', className]}
  role="status"
  aria-busy="true"
  aria-label="Loading gallery photo..."
  style="cursor: default;"
>
  <div
    class="plate-media"
    style={`display: flex; align-items: center; justify-content: center; min-height: ${height}; aspect-ratio: ${aspectRatio}; background: var(--skeleton-base, #ede6dc);`}
  >
    <Skeleton width="100%" height="100%" class="skeleton-shimmer" />
  </div>
  <div class="plate-caption">
    <Skeleton width="70%" height="0.7rem" borderRadius="3px" />
    <Skeleton width="45%" height="0.95rem" borderRadius="3px" />
  </div>
</article>
