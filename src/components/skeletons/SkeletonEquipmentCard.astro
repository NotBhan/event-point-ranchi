---
import Skeleton from './Skeleton.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<article class:list={['equipment-card', 'skeleton-card', className]} role="status" aria-busy="true" aria-label="Loading equipment details...">
  <div class="equipment-media" style="position: relative; overflow: hidden; aspect-ratio: 4/3; background: var(--skeleton-base, #ede6dc);">
    <Skeleton width="100%" height="100%" class="skeleton-shimmer" />
    <span class="equipment-category-tag" style="opacity: 0.6; min-width: 50px;">&nbsp;</span>
  </div>

  <div class="equipment-body">
    <Skeleton height="1.35rem" width="75%" borderRadius="4px" style="margin-bottom: 0.5rem;" />
    <Skeleton height="0.875rem" width="90%" borderRadius="3px" style="margin-bottom: 0.75rem;" />

    <div style="display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem;">
      <Skeleton height="0.75rem" width="60%" borderRadius="2px" />
      <Skeleton height="0.75rem" width="50%" borderRadius="2px" />
    </div>

    <div class="equipment-footer">
      <div class="equipment-qty-row" style="opacity: 0.5;">
        <Skeleton width="50px" height="0.875rem" borderRadius="3px" />
        <Skeleton width="80px" height="1.75rem" borderRadius="4px" />
      </div>
      <div class="equipment-card-actions" style="margin-top: 0.75rem;">
        <Skeleton height="2rem" width="100%" borderRadius="6px" />
      </div>
    </div>
  </div>
</article>
