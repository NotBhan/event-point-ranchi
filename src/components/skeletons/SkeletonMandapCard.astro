---
import Skeleton from './Skeleton.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<article class:list={['catalogue-card', 'skeleton-card', className]} role="status" aria-busy="true" aria-label="Loading mandap details...">
  <div class="catalogue-media" style="position: relative; overflow: hidden; aspect-ratio: 4/3; background: var(--skeleton-base, #ede6dc);">
    <Skeleton width="100%" height="100%" class="skeleton-shimmer" />
    <span class="catalogue-badge" style="opacity: 0.6; min-width: 60px;">&nbsp;</span>
  </div>

  <div class="catalogue-body">
    <Skeleton height="1.5rem" width="70%" borderRadius="4px" style="margin-bottom: 0.5rem;" />
    <Skeleton height="0.875rem" width="95%" borderRadius="3px" style="margin-bottom: 0.25rem;" />
    <Skeleton height="0.875rem" width="60%" borderRadius="3px" style="margin-bottom: 0.75rem;" />

    <div class="dimension-strip" style="opacity: 0.5;">
      <Skeleton width="15px" height="15px" borderRadius="50%" />
      <Skeleton width="80px" height="0.75rem" borderRadius="3px" />
      <Skeleton width="100px" height="0.875rem" borderRadius="3px" style="margin-left: auto;" />
    </div>

    <div class="catalogue-foot">
      <Skeleton height="2rem" width="95px" borderRadius="6px" />
      <Skeleton height="2rem" width="140px" borderRadius="6px" />
    </div>
  </div>
</article>
