---
import { getDb } from '../core/db';
import { site } from '../core/config';
import { getNav } from '../core/registry';

const nav = getNav();
const contact = getDb()
  .prepare('SELECT address, phone, email FROM contact_info WHERE id = 1')
  .get() as { address: string; phone: string; email: string } | undefined;

const contactInfo = contact ?? { address: site.address, phone: site.phone, email: site.email };
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/logo1.png" alt="Royal Palace" />
        <h3>Royal Palace</h3>
        <p>Luxury venues, curated catering and a planning team that makes every celebration effortless.</p>
        <div class="footer-social">
          {site.social.map((social) => (
            <a href={social.href} aria-label={social.label}>{social.label.slice(0, 2).toUpperCase()}</a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <div class="footer-links">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>

      <div class="footer-col">
        <h4>Plan</h4>
        <div class="footer-links">
          <a href="/booking/overview">Booking overview</a>
          <a href="/cart">Event cart</a>
          <a href="/my-bookings">My bookings</a>
          <a href="/login">Customer login</a>
          <a href="/admin">Staff console</a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Reach us</h4>
        <div class="footer-contact">
          <div>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{contactInfo.address}</span>
          </div>
          <div>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg>
            <a href={`tel:${contactInfo.phone.replace(/\s/g, '')}`}>{contactInfo.phone}</a>
          </div>
          <div>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Royal Palace Event Management. All rights reserved.</span>
      <span>Ranchi, Jharkhand · Crafted with Astro</span>
    </div>
  </div>
</footer>
