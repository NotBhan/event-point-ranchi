---
import { site } from '../core/config';
import { getNav } from '../core/registry';
import type { MergedSiteSettings } from '../core/content/service';
import Icon from './Icon.astro';

interface Props {
  settings?: MergedSiteSettings;
}

const { settings } = Astro.props;
const brandName = settings?.name || site.name;
const legalName = settings?.legalName || site.legalName;
const logoUrl = settings?.logo || site.logo;
const phone = settings?.phone || site.phone;
const email = settings?.email || site.email;
const address = settings?.address || site.address;
const whatsapp = settings?.whatsapp || site.whatsapp;
const businessHours = settings?.businessHours || 'Daily, 10:00 – 19:00';
const socialLinks: ReadonlyArray<{ label: string; href: string }> = settings?.social || site.social;

const nav = getNav();
const planLinks = [
  ['Plan your event', '/plan'],
  ['Wedding mandaps', '/mandaps'],
  ['Stage designs', '/stages'],
  ['Furniture & equipment', '/equipment'],
  ['Photography gallery', '/gallery'],
];
const year = new Date().getFullYear();
const phoneHref = `tel:${phone.replace(/\s/g, '')}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src={logoUrl} alt={brandName} width="48" height="48" />
        <h3>{brandName}</h3>
        <p>
          Wedding mandap, stage design, furniture and event equipment planning in Ranchi. Share your
          dates and vision — we respond with a considered quotation.
        </p>
        <div class="footer-social">
          {socialLinks.map((social) => (
            <a href={social.href} aria-label={social.label}>{social.label.slice(0, 2).toUpperCase()}</a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <div class="footer-links">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>

      <div class="footer-col">
        <h4>Plan</h4>
        <div class="footer-links">
          {planLinks.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>

      <div class="footer-col">
        <h4>Reach us</h4>
        <div class="footer-contact">
          <div>
            <Icon name="pin" size={15} />
            {settings?.googleMapsUrl ? (
              <a href={settings.googleMapsUrl} target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:underline;text-underline-offset:2px;">
                {address}
              </a>
            ) : (
              <span>{address}</span>
            )}
          </div>
          <div>
            <Icon name="phone" size={15} />
            <a href={phoneHref}>{phone}</a>
          </div>
          <div>
            <Icon name="mail" size={15} />
            <a href={`mailto:${email}`}>{email}</a>
          </div>
          <div>
            <Icon name="clock" size={15} />
            <span>Studio visits: {businessHours}</span>
          </div>
          {settings?.googleMapsUrl && (
            <div style="margin-top:4px;">
              <Icon name="external" size={13} />
              <a href={settings.googleMapsUrl} target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--gold-bright);">
                View on Google Maps &rarr;
              </a>
            </div>
          )}
        </div>
        {settings?.contactButtonsEnabled !== false && (
          <a
            class="footer-whatsapp"
            href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hello ${brandName}, I would like to plan a wedding setup in Ranchi.`)}`}
            rel="noopener"
            target="_blank"
          >
            <Icon name="phone" size={14} /> Chat on WhatsApp
          </a>
        )}
      </div>
    </div>

    <div class="footer-bottom">
      <span>{settings?.footerText || `© ${year} ${legalName}. All rights reserved.`}</span>
      <span class="footer-policy-links">
        <a href="/policies#terms">Terms</a>
        <a href="/policies#privacy">Privacy</a>
        <a href="/policies#cancellations">Refund & Cancellation</a>
        <a href="/policies#fulfillment">Service Delivery</a>
        <a href="/policies#grievance">Grievance Officer</a>
      </span>
      <span>Main Road, Ranchi · Jharkhand 834001</span>
    </div>
  </div>
</footer>
