---
import { ClientRouter } from 'astro:transitions';
import { getAdminNav } from '../core/registry';
import Icon from '../components/Icon.astro';
import Toast from '../components/Toast.astro';
import { site } from '../core/config';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/admin.css';
import '../styles/mobile.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Dashboard', description = '' } = Astro.props;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Pragma', 'no-cache');
const auth = Astro.locals.adminAuth;
if (!auth?.user) return Astro.redirect('/admin/login');
const user = auth.user;
const csrf = Astro.locals.csrf;
const nav = getAdminNav();
const path = Astro.url.pathname;
const isEditorOnly = user.role === 'editor';
const visibleNav = isEditorOnly ? nav.filter((item) => item.href === '/admin/content') : nav;
const navGroups = [...visibleNav.reduce((groups, item) => {
  const group = item.group ?? (isEditorOnly ? 'Content Studio' : 'Operations');
  const current = groups.get(group) ?? [];
  current.push(item);
  groups.set(group, current);
  return groups;
}, new Map<string, typeof nav>()).entries()];

const isActive = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {site.name} Admin</title>
    <link rel="icon" type="image/svg+xml" href={site.logo} />
    <link rel="preload" href="/fonts/inter-normal-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-normal-400.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter fallback="swap" />
  </head>
  <body class="admin-body">
    <div id="pageProgressBar" class="page-progress-bar" aria-hidden="true"></div>
    <div class="admin-shell" id="adminShell">
      <aside class="admin-sidebar">
        <div class="admin-brand">
          <img src={site.logo} alt={site.name} />
          <div>
            <strong>{site.name}</strong>
            <span>Admin console</span>
          </div>
          <button type="button" class="admin-sidebar-close" data-admin-close aria-label="Close menu">
            <Icon name="x" size={18} />
          </button>
        </div>

        <nav class="admin-nav" aria-label="Admin sections">
          {navGroups.map(([group, items]) => (
            <div class="admin-nav-group">
              <span class="admin-nav-label">{group}</span>
              {items.map((item) => (
                <a href={item.href} class:list={{ active: isActive(item.href) }}>
                  <Icon name={item.icon} size={15} /> {item.label}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="admin-user">
          <div class="admin-user-chip">
            <span class="avatar">{user.firstName.slice(0, 1).toUpperCase()}</span>
            <div>
              <strong>{user.firstName}</strong>
              <span>{user.role}</span>
            </div>
          </div>
          <div class="admin-user-actions">
            <a href="/"><Icon name="external" size={14} /> View website</a>
            <a href="/admin"><Icon name="user" size={14} /> Dashboard</a>
            <form method="POST" action="/admin/logout">
              <input type="hidden" name="_csrf" value={csrf} />
              <button type="submit" class="danger"><Icon name="logout" size={14} /> Log out</button>
            </form>
          </div>
        </div>
      </aside>

      <button type="button" class="admin-backdrop" data-admin-close aria-label="Close menu" tabindex="-1"></button>

      <div class="admin-main">
        <header class="admin-topbar">
          <button
            type="button"
            class="admin-toggle"
            data-admin-toggle
            aria-label="Open admin menu"
            aria-expanded="false"
            aria-controls="adminShell"
          >
            <Icon name="menu" size={18} />
          </button>
          <div>
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </div>
          <div class="admin-topbar-actions">
            <span class="badge badge-gold">{site.name}</span>
          </div>
        </header>

        <div class="admin-content">
          <slot />
        </div>
      </div>
    </div>

    <Toast flash={Astro.locals.flash} />

    <script>
      import '../client/admin';
      import '../client/enquiry-state';

      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('pageProgressBar');
        if (bar) {
          bar.classList.remove('is-finished');
          bar.classList.add('is-loading');
        }
      });
      document.addEventListener('astro:page-load', () => {
        const bar = document.getElementById('pageProgressBar');
        if (bar) {
          bar.classList.add('is-finished');
          bar.classList.remove('is-loading');
        }
      });
    </script>
  </body>
</html>
