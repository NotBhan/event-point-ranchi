---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { imageUrl } from '../../../core/http';
import type { loadGalleryPage } from '../service';
import '../gallery.css';

interface Props {
  data: ReturnType<typeof loadGalleryPage>;
}

const { data } = Astro.props;
const { settings, categories, items } = data;
---

<BaseLayout title="Gallery | Royal Palace" description={settings.hero_subtitle}>
  <section class:list={['page-hero', { 'with-image': Boolean(settings.hero_image) }]}>
    {settings.hero_image && <img class="page-hero-media" src={imageUrl(settings.hero_image)} alt="" />}
    <div class="container">
      {settings.hero_badge && <span class="eyebrow">{settings.hero_badge}</span>}
      <h1>{settings.hero_title}</h1>
      <p>{settings.hero_subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-bar" data-gallery-filters>
        <button type="button" class="filter-btn active" data-gallery-filter="all">All</button>
        {categories.map((category) => (
          <button type="button" class="filter-btn" data-gallery-filter={String(category.id)}>{category.name}</button>
        ))}
      </div>

      {items.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon"><Icon name="image" size={24} /></div>
          <h3>No gallery images yet</h3>
          <p>Our team is uploading new photographs from recent events.</p>
        </div>
      ) : (
        <div class="gallery-grid">
          {items.map((item) => (
            <button
              type="button"
              class="gallery-tile"
              data-gallery-item
              data-gallery-category={item.category_id}
              data-lightbox
              data-src={imageUrl(item.image)}
              data-caption={item.title}
            >
              <img src={imageUrl(item.image)} alt={item.title || 'Gallery image'} loading="lazy" />
              <span class="gallery-overlay">{item.title || 'View image'}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  </section>

  <script>
    import '../../../client/gallery';
  </script>
</BaseLayout>
