---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import VideoPreviewCard from '../../../components/VideoPreviewCard.astro';
import { imageUrl } from '../../../core/http';
import type { GalleryPageData } from '../service';
import { getPageContent, getVideoPreviews } from '../../../core/content/service';
import '../gallery.css';

interface Props {
  data: GalleryPageData;
}

const { data } = Astro.props;
const { settings, categories, items } = data;
const [pageContent, videoPreviews] = await Promise.all([
  getPageContent('gallery'),
  getVideoPreviews({ onlyPublished: true }),
]);

const heroTitle = pageContent.title || settings.hero_title;
const heroSubtitle = pageContent.subtitle || settings.hero_subtitle;
const heroBadge = pageContent.content_json?.badge || settings.hero_badge;
const heroBanner = pageContent.banner_image_url || settings.hero_image;
const showBanner = pageContent.banner_enabled !== false && Boolean(heroBanner);

const DEFAULT_PAGE_SIZE = 8;
const totalInitialPages = Math.ceil(items.length / DEFAULT_PAGE_SIZE);
---

<BaseLayout
  title={pageContent.seo_title || "Gallery | Event Point Ranchi"}
  description={pageContent.seo_description || heroSubtitle}
>
  <section class:list={['page-hero', { 'with-image': showBanner }]}>
    {showBanner && <img class="page-hero-media" src={imageUrl(heroBanner)} alt="" />}
    <div class="container">
      {heroBadge && <span class="eyebrow">{heroBadge}</span>}
      <h1>{heroTitle}</h1>
      <p>{heroSubtitle}</p>
    </div>
  </section>

  <section class="section" id="gallerySection">
    <div class="container">
      <div class="filter-bar" data-gallery-filters>
        <button type="button" class="filter-btn active" data-gallery-filter="all">
          <span>All</span>
          <span class="filter-count">{items.length}</span>
        </button>
        {categories.map((category) => (
          <button type="button" class="filter-btn" data-gallery-filter={String(category.id)} data-category-slug={category.slug}>
            <span>{category.name}</span>
            <span class="filter-count">{category.count}</span>
          </button>
        ))}
      </div>

      <div class="gallery-toolbar" data-gallery-toolbar>
        <div class="gallery-count-badge">
          Showing <strong data-range-start>{items.length > 0 ? 1 : 0}</strong>–<strong data-range-end>{Math.min(items.length, DEFAULT_PAGE_SIZE)}</strong> of <strong data-total-count>{items.length}</strong> designs
        </div>
        <div class="gallery-view-options">
          <label class="page-size-label">
            <span>Per page:</span>
            <select class="page-size-select" data-page-size-select aria-label="Designs per page">
              <option value="8" selected>8</option>
              <option value="12">12</option>
              <option value="16">16</option>
              <option value="all">All</option>
            </select>
          </label>
        </div>
      </div>

      {items.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon"><Icon name="image" size={24} /></div>
          <h3>No gallery images yet</h3>
          <p>Our team is uploading new photographs from recent events.</p>
        </div>
      ) : (
        <>
          <div class="gallery-empty-state" data-gallery-empty style="display: none;">
            <div class="empty-icon"><Icon name="image" size={28} /></div>
            <h3>No designs in this category</h3>
            <p>Try selecting another category or view all designs in our collection.</p>
            <button type="button" class="filter-btn active" data-reset-filter>
              <span>View all designs</span>
            </button>
          </div>

          <div class="pinterest-masonry" data-gallery-masonry>
            {items.map((item, index) => (
              <article
                class="pinterest-pin"
                data-gallery-item
                data-gallery-index={index}
                data-gallery-category={item.category_id}
                data-gallery-slug={item.category_slug}
                data-lightbox
                data-src={imageUrl(item.image)}
                data-caption={`${item.title} (${item.category_name})`}
                tabindex="0"
                role="button"
                aria-label={`View ${item.title || 'event design'} in high resolution`}
              >
                <div class="pin-media-wrapper media-with-skeleton">
                  <div class="skeleton-placeholder skeleton-shimmer" role="status" aria-busy="true" aria-label="Loading image..."></div>
                  <img
                    src={imageUrl(item.image)}
                    alt={item.title || 'Event Point Ranchi celebration design'}
                    loading={index < 4 ? 'eager' : 'lazy'}
                  />
                  <div class="skeleton-error-fallback" role="alert">
                    <Icon name="image" size={24} />
                    <span>Image preview unavailable</span>
                  </div>
                  <div class="pin-hover-overlay">
                    <div class="pin-overlay-top">
                      <span class="pin-category-pill">{item.category_name}</span>
                      <span class="pin-zoom-pill">
                        <Icon name="zoom-in" size={13} />
                        <span>Expand</span>
                      </span>
                    </div>
                    <div class="pin-overlay-bottom">
                      <span class="pin-tap-hint">Click to enlarge</span>
                    </div>
                  </div>
                </div>

                <div class="pin-content">
                  <div class="pin-category-text">{item.category_name}</div>
                  <h3 class="pin-title">{item.title || 'Celebration Styling'}</h3>
                  <div class="pin-footer">
                    <span class="pin-location">Event Point · Ranchi</span>
                    <span class="pin-action-icon">
                      <Icon name="expand" size={13} />
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <nav class="gallery-pagination" data-gallery-pagination aria-label="Gallery pagination">
            <button type="button" class="pagination-btn pagination-prev" data-page-prev disabled aria-label="Previous page">
              <Icon name="arrow-left" size={15} />
              <span>Previous</span>
            </button>

            <div class="pagination-pages" data-page-numbers>
              {Array.from({ length: totalInitialPages }, (_, i) => i + 1).map((pageNum) => (
                <button
                  type="button"
                  class:list={['page-num-btn', { active: pageNum === 1 }]}
                  data-page={pageNum}
                  aria-label={`Page ${pageNum}`}
                  aria-current={pageNum === 1 ? 'page' : undefined}
                >
                  {pageNum}
                </button>
              ))}
            </div>

            <button
              type="button"
              class="pagination-btn pagination-next"
              data-page-next
              disabled={totalInitialPages <= 1}
              aria-label="Next page"
            >
              <span>Next</span>
              <Icon name="arrow-right" size={15} />
            </button>
          </nav>
        </>
      )}
    </div>
  </section>

  {videoPreviews.length > 0 && (
    <section class="section section-warm" id="videosSection" aria-labelledby="videos-heading">
      <div class="container">
        <div class="section-head text-center" style="max-width: 680px; margin-inline: auto; margin-bottom: 2rem;">
          <span class="eyebrow" style="color: var(--gold-deep, #a9862f);">Cinematic Experiences</span>
          <h2 id="videos-heading">Wedding Moments &amp; Decor in Motion</h2>
          <p>
            Experience our royal mandaps, ambient evening lighting, and reception stage reveal moments
            through full YouTube walkthroughs, Shorts, and Instagram Reels.
          </p>
        </div>

        <!-- Video Platform Filter Pills -->
        <div class="filter-bar" data-video-filters style="margin-bottom: 2rem; justify-content: center;">
          <button type="button" class="filter-btn active" data-video-filter="all">
            <span>All Videos</span>
            <span class="filter-count">{videoPreviews.length}</span>
          </button>
          {videoPreviews.some((v) => v.platform === 'youtube') && (
            <button type="button" class="filter-btn" data-video-filter="youtube">
              <span>YouTube Tours</span>
              <span class="filter-count">{videoPreviews.filter((v) => v.platform === 'youtube').length}</span>
            </button>
          )}
          {videoPreviews.some((v) => v.platform === 'youtube_shorts') && (
            <button type="button" class="filter-btn" data-video-filter="youtube_shorts">
              <span>Shorts</span>
              <span class="filter-count">{videoPreviews.filter((v) => v.platform === 'youtube_shorts').length}</span>
            </button>
          )}
          {videoPreviews.some((v) => v.platform === 'instagram_reels') && (
            <button type="button" class="filter-btn" data-video-filter="instagram_reels">
              <span>Instagram Reels</span>
              <span class="filter-count">{videoPreviews.filter((v) => v.platform === 'instagram_reels').length}</span>
            </button>
          )}
        </div>

        <!-- Responsive Video Grid -->
        <div
          class="video-showcase-grid"
          data-video-grid
          style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; align-items: start;"
        >
          {videoPreviews.map((video) => (
            <div data-video-item data-platform={video.platform}>
              <VideoPreviewCard video={video} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    import '../../../client/gallery';

    function setupVideoFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-video-filter]');
      const videoItems = document.querySelectorAll<HTMLElement>('[data-video-item]');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selected = btn.dataset.videoFilter;
          filterBtns.forEach((b) => b.classList.toggle('active', b === btn));

          videoItems.forEach((item) => {
            const matches = selected === 'all' || item.dataset.platform === selected;
            item.style.display = matches ? 'block' : 'none';
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupVideoFilters);
    } else {
      setupVideoFilters();
    }
    document.addEventListener('astro:page-load', setupVideoFilters);
  </script>
</BaseLayout>
