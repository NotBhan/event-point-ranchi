---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import VideoPreviewCard from '../../../components/VideoPreviewCard.astro';
import { imageUrl } from '../../../core/http';
import { heroImage, responsiveImage } from '../../../core/media';
import type { GalleryPageData } from '../service';
import { getPageContent, getVideoPreviews } from '../../../core/content/service';
import '../gallery.css';

interface Props {
  data: GalleryPageData;
}

const { data } = Astro.props;
const { settings, categories, items, category, perPage, pagination } = data;
const [pageContent, videoPreviews] = await Promise.all([
  getPageContent('gallery'),
  getVideoPreviews({ onlyPublished: true }),
]);

const heroTitle = pageContent.title || settings.hero_title;
const heroSubtitle = pageContent.subtitle || settings.hero_subtitle;
const heroBadge = pageContent.content_json?.badge || settings.hero_badge;
const heroBanner = pageContent.banner_image_url || settings.hero_image;
const heroBannerImage = heroImage(heroBanner);
const showBanner = pageContent.banner_enabled !== false && Boolean(heroBanner);

const totalAll = categories.reduce((sum, entry) => sum + entry.count, 0);

// Server-side filters + pagination: every gallery link is a plain URL so the
// page ships only the current slice of items.
const galleryHref = (options: { category?: string; page?: number; per?: number } = {}) => {
  const params = new URLSearchParams();
  const nextCategory = options.category ?? category;
  if (nextCategory) params.set('category', nextCategory);
  const nextPer = options.per ?? perPage;
  if (nextPer) params.set('per', String(nextPer));
  const nextPage = options.page ?? 1;
  if (nextPage > 1) params.set('page', String(nextPage));
  const query = params.toString();
  return `/gallery${query ? `?${query}` : ''}#gallerySection`;
};

const paginationWindow = (() => {
  const total = pagination.totalPages;
  const current = pagination.page;
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages = new Set([1, total, current - 1, current, current + 1]);
  return [...pages].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
})();
---

<BaseLayout
  title={pageContent.seo_title || "Gallery | Event Point Ranchi"}
  description={pageContent.seo_description || heroSubtitle}
>
  <section class:list={['page-hero', { 'with-image': showBanner }]}>
    {showBanner && <img class="page-hero-media" src={heroBannerImage.src} srcset={heroBannerImage.srcset} sizes={heroBannerImage.sizes} width="1600" height="900" alt="" fetchpriority="high" decoding="async" />}
    <div class="container">
      {heroBadge && <span class="eyebrow">{heroBadge}</span>}
      <h1>{heroTitle}</h1>
      <p>{heroSubtitle}</p>
    </div>
  </section>

  <section class="section" id="gallerySection">
    <div class="container">
      <div class="filter-bar" data-gallery-filters>
        <a
          class:list={['filter-btn', { active: !category }]}
          href={galleryHref({ category: '', page: 1 })}
          aria-current={!category ? 'page' : undefined}
        >
          <span>All</span>
          <span class="filter-count">{totalAll}</span>
        </a>
        {categories.map((entry) => (
          <a
            class:list={['filter-btn', { active: category === entry.slug }]}
            href={galleryHref({ category: entry.slug, page: 1 })}
            aria-current={category === entry.slug ? 'page' : undefined}
          >
            <span>{entry.name}</span>
            <span class="filter-count">{entry.count}</span>
          </a>
        ))}
      </div>

      <div class="gallery-toolbar" data-gallery-toolbar>
        <div class="gallery-count-badge">
          Showing <strong>{pagination.startItem}</strong>–<strong>{pagination.endItem}</strong> of <strong>{pagination.totalCount}</strong> designs
        </div>
        <div class="gallery-view-options">
          <label class="page-size-label">
            <span>Per page:</span>
            <select class="page-size-select" data-page-size-select aria-label="Designs per page">
              <option value="12" selected={perPage === 12}>12</option>
              <option value="24" selected={perPage === 24}>24</option>
              <option value="48" selected={perPage === 48}>48</option>
            </select>
          </label>
        </div>
      </div>

      {items.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon"><Icon name="image" size={24} /></div>
          <h3>No gallery images yet</h3>
          <p>Our team is uploading new photographs from recent events.</p>
        </div>
      ) : (
        <>
          <div class="pinterest-masonry" data-gallery-masonry>
            {items.map((item, index) => {
              const tileImage = responsiveImage(item.image, {
                widths: [320, 480, 640],
                sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 320px',
              });
              return (
              <article
                class="pinterest-pin"
                data-gallery-item
                data-gallery-index={index}
                data-gallery-category={item.category_id}
                data-gallery-slug={item.category_slug}
                data-lightbox
                data-src={imageUrl(item.image)}
                data-caption={`${item.title} (${item.category_name})`}
                tabindex="0"
                role="button"
                aria-label={`View ${item.title || 'event design'} in high resolution`}
              >
                <div class="pin-media-wrapper media-with-skeleton">
                  <div class="skeleton-placeholder skeleton-shimmer" role="status" aria-busy="true" aria-label="Loading image..."></div>
                  <img
                    src={tileImage.src}
                    srcset={tileImage.srcset}
                    sizes={tileImage.sizes}
                    width="400"
                    height="300"
                    alt={item.title || 'Event Point Ranchi celebration design'}
                    loading={pagination.page === 1 && index < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <div class="skeleton-error-fallback" role="alert">
                    <Icon name="image" size={24} />
                    <span>Image preview unavailable</span>
                  </div>
                  <div class="pin-hover-overlay">
                    <div class="pin-overlay-top">
                      <span class="pin-category-pill">{item.category_name}</span>
                      <span class="pin-zoom-pill">
                        <Icon name="zoom-in" size={13} />
                        <span>Expand</span>
                      </span>
                    </div>
                    <div class="pin-overlay-bottom">
                      <span class="pin-tap-hint">Click to enlarge</span>
                    </div>
                  </div>
                </div>

                <div class="pin-content">
                  <div class="pin-category-text">{item.category_name}</div>
                  <h3 class="pin-title">{item.title || 'Celebration Styling'}</h3>
                  <div class="pin-footer">
                    <span class="pin-location">Event Point · Ranchi</span>
                    <span class="pin-action-icon">
                      <Icon name="expand" size={13} />
                    </span>
                  </div>
                </div>
              </article>
              );
            })}
          </div>

          <nav class="gallery-pagination" aria-label="Gallery pagination">
            {pagination.page > 1 ? (
              <a class="pagination-btn pagination-prev" href={galleryHref({ page: pagination.page - 1 })} aria-label="Previous page">
                <Icon name="arrow-left" size={15} />
                <span>Previous</span>
              </a>
            ) : (
              <span class="pagination-btn pagination-prev is-disabled" aria-disabled="true">
                <Icon name="arrow-left" size={15} />
                <span>Previous</span>
              </span>
            )}

            {pagination.totalPages > 1 && (
              <div class="pagination-pages">
                {paginationWindow.map((pageNum) => (
                  <a
                    class:list={['page-num-btn', { active: pageNum === pagination.page }]}
                    href={galleryHref({ page: pageNum })}
                    aria-label={`Page ${pageNum}`}
                    aria-current={pageNum === pagination.page ? 'page' : undefined}
                  >
                    {pageNum}
                  </a>
                ))}
              </div>
            )}

            {pagination.page < pagination.totalPages ? (
              <a class="pagination-btn pagination-next" href={galleryHref({ page: pagination.page + 1 })} aria-label="Next page">
                <span>Next</span>
                <Icon name="arrow-right" size={15} />
              </a>
            ) : (
              <span class="pagination-btn pagination-next is-disabled" aria-disabled="true">
                <span>Next</span>
                <Icon name="arrow-right" size={15} />
              </span>
            )}
          </nav>
        </>
      )}
    </div>
  </section>

  {videoPreviews.length > 0 && (
    <section class="section section-warm" id="videosSection" aria-labelledby="videos-heading">
      <div class="container">
        <div class="section-head text-center" style="max-width: 680px; margin-inline: auto; margin-bottom: 2rem;">
          <span class="eyebrow" style="color: var(--gold-deep, #a9862f);">Cinematic Experiences</span>
          <h2 id="videos-heading">Wedding Moments &amp; Decor in Motion</h2>
          <p>
            Experience our royal mandaps, ambient evening lighting, and reception stage reveal moments
            through full YouTube walkthroughs, Shorts, and Instagram Reels.
          </p>
        </div>

        <!-- Video Platform Filter Pills -->
        <div class="filter-bar" data-video-filters style="margin-bottom: 2rem; justify-content: center;">
          <button type="button" class="filter-btn active" data-video-filter="all">
            <span>All Videos</span>
            <span class="filter-count">{videoPreviews.length}</span>
          </button>
          {videoPreviews.some((v) => v.platform === 'youtube') && (
            <button type="button" class="filter-btn" data-video-filter="youtube">
              <span>YouTube Tours</span>
              <span class="filter-count">{videoPreviews.filter((v) => v.platform === 'youtube').length}</span>
            </button>
          )}
          {videoPreviews.some((v) => v.platform === 'youtube_shorts') && (
            <button type="button" class="filter-btn" data-video-filter="youtube_shorts">
              <span>Shorts</span>
              <span class="filter-count">{videoPreviews.filter((v) => v.platform === 'youtube_shorts').length}</span>
            </button>
          )}
          {videoPreviews.some((v) => v.platform === 'instagram_reels') && (
            <button type="button" class="filter-btn" data-video-filter="instagram_reels">
              <span>Instagram Reels</span>
              <span class="filter-count">{videoPreviews.filter((v) => v.platform === 'instagram_reels').length}</span>
            </button>
          )}
        </div>

        <!-- Responsive Video Grid -->
        <div
          class="video-showcase-grid"
          data-video-grid
          style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; align-items: start;"
        >
          {videoPreviews.map((video) => (
            <div data-video-item data-platform={video.platform}>
              <VideoPreviewCard video={video} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    // Gallery filtering + pagination are server-rendered links now; this script
    // only wires the per-page selector and the video platform pills. Listeners
    // are marked on the elements themselves so view-transition re-runs are safe.
    function setupGalleryControls() {
      const pageSizeSelect = document.querySelector<HTMLSelectElement>('[data-page-size-select]');
      if (pageSizeSelect && pageSizeSelect.dataset.bound !== 'true') {
        pageSizeSelect.dataset.bound = 'true';
        pageSizeSelect.addEventListener('change', () => {
          const url = new URL(window.location.href);
          if (pageSizeSelect.value) {
            url.searchParams.set('per', pageSizeSelect.value);
          } else {
            url.searchParams.delete('per');
          }
          url.searchParams.delete('page');
          url.hash = 'gallerySection';
          window.location.assign(url.toString());
        });
      }

      const filterBtns = document.querySelectorAll<HTMLElement>('[data-video-filter]');
      const videoItems = document.querySelectorAll<HTMLElement>('[data-video-item]');

      filterBtns.forEach((btn) => {
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const selected = btn.dataset.videoFilter;
          filterBtns.forEach((b) => b.classList.toggle('active', b === btn));

          videoItems.forEach((item) => {
            const matches = selected === 'all' || item.dataset.platform === selected;
            item.style.display = matches ? 'block' : 'none';
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGalleryControls, { once: true });
    } else {
      setupGalleryControls();
    }
    document.addEventListener('astro:page-load', setupGalleryControls);
  </script>
</BaseLayout>
