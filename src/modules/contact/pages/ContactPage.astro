---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getSiteSettings } from '../../../core/content/service';
import type { ContactInfo } from '../service';
import '../contact.css';

interface Props {
  info: ContactInfo;
  sent: boolean;
}

const { info, sent } = Astro.props;
const csrf = Astro.locals.csrf;

const eventOptions = ['Wedding', 'Reception', 'Engagement', 'Birthday', 'Corporate event', 'Conference', 'Other'];
const today = new Date().toISOString().slice(0, 10);

const settings = await getSiteSettings();
const telHref = `tel:${info.phone.replace(/[^\d+]/g, '')}`;
const mailtoHref = `mailto:${info.email}`;
const mapsHref =
  settings.googleMapsUrl ||
  `https://maps.google.com/?q=${encodeURIComponent(info.address)}`;
---

<BaseLayout title="Contact us | Event Point Ranchi" description="Talk to Event Point Ranchi about wedding mandaps, stage designs, furniture and event equipment in Ranchi.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Get in touch</span>
      <h1>Let's plan your celebration.</h1>
      <p>Tell us your date, guest count and what matters most — we will reply with availability and an itemised quotation.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <aside class="contact-aside" aria-label="Studio contact details">
        <div class="contact-visit-card">
          <div class="contact-visit-head">
            <span class="eyebrow contact-visit-eyebrow">Visit the studio</span>
            <h2>Where to find us</h2>
            <p class="contact-visit-address">{info.address}</p>
            <a class="contact-visit-map" href={mapsHref} target="_blank" rel="noopener">
              <Icon name="pin" size={14} />
              <span>Open in Google Maps</span>
              <Icon name="external" size={12} />
            </a>
          </div>

          <div class="contact-visit-rows">
            <a class="contact-visit-row" href={telHref}>
              <span class="contact-visit-icon"><Icon name="phone" size={17} /></span>
              <span class="contact-visit-copy">
                <span class="contact-visit-label">Call us</span>
                <strong>{info.phone}</strong>
                <small>Call or WhatsApp</small>
              </span>
              <span class="contact-visit-chevron"><Icon name="arrow-right" size={15} /></span>
            </a>

            <a class="contact-visit-row" href={mailtoHref}>
              <span class="contact-visit-icon"><Icon name="mail" size={17} /></span>
              <span class="contact-visit-copy">
                <span class="contact-visit-label">Email</span>
                <strong>{info.email}</strong>
                <small>Replies within one working day</small>
              </span>
              <span class="contact-visit-chevron"><Icon name="arrow-right" size={15} /></span>
            </a>
          </div>

          <dl class="contact-visit-facts">
            <div>
              <dt><Icon name="clock" size={14} /> Studio hours</dt>
              <dd>Daily 9:00 – 21:00</dd>
            </div>
            <div>
              <dt><Icon name="calendar" size={14} /> Site visits</dt>
              <dd>Daily 10:00 – 19:00</dd>
            </div>
          </dl>

          <div class="contact-visit-foot">
            <div>
              <span class="contact-visit-label">Grievance Officer</span>
              <strong>Mr. Rahul Sharma</strong>
            </div>
            <a href="/grievance" class="contact-visit-foot-link">
              <span>View procedure</span>
              <Icon name="arrow-right" size={13} />
            </a>
          </div>
        </div>
      </aside>

      <div class="panel">
        <div class="panel-head">
          <div>
            <h2>Send an enquiry</h2>
            <p>Every field helps us quote accurately.</p>
          </div>
        </div>

        {sent && (
          <div class="alert alert-success mb-6">
            <Icon name="check-circle" size={16} />
            <span>Thank you! Your enquiry is with our team — expect a call within one working day.</span>
          </div>
        )}

        <form method="POST" action="/contact" class="form-grid" id="contactForm" novalidate>
          <input type="hidden" name="_csrf" value={csrf} />

          <p class="form-required-legend">
            <span class="required-indicator" aria-hidden="true">*</span> Indicates required fields
          </p>

          <div class="form-grid cols-2">
            <div class="field" data-field-wrap="name">
              <label for="name">
                Full name <span class="required-indicator" aria-hidden="true">*</span>
              </label>
              <input
                class="input"
                id="name"
                name="name"
                required
                aria-required="true"
                placeholder="Aarav Sharma"
              />
            </div>
            <div class="field" data-field-wrap="phone">
              <label for="phone">
                Phone number <span class="required-indicator" aria-hidden="true">*</span>
              </label>
              <input
                class="input"
                id="phone"
                name="phone"
                required
                aria-required="true"
                placeholder="9876543210"
                inputmode="tel"
              />
            </div>
          </div>

          <div class="form-grid cols-2">
            <div class="field" data-field-wrap="email">
              <label for="email">
                Email address <span class="required-indicator" aria-hidden="true">*</span>
              </label>
              <input
                class="input"
                id="email"
                name="email"
                type="email"
                required
                aria-required="true"
                placeholder="you@example.com"
              />
            </div>
            <div class="field" data-field-wrap="event_type">
              <label for="event_type">Event type</label>
              <select class="select" id="event_type" name="event_type">
                {eventOptions.map((option) => <option value={option}>{option}</option>)}
              </select>
            </div>
          </div>

          <div class="form-grid cols-2">
            <div class="field" data-field-wrap="event_date">
              <label for="event_date">Expected event date</label>
              <input class="input" id="event_date" name="event_date" type="date" min={today} />
            </div>
            <div class="field" data-field-wrap="guest_count">
              <label for="guest_count">Estimated guests</label>
              <input
                class="input"
                id="guest_count"
                name="guest_count"
                type="number"
                min="1"
                placeholder="e.g. 400"
              />
            </div>
          </div>

          <div class="field" data-field-wrap="message">
            <label for="message">Your requirements</label>
            <textarea
              class="textarea"
              id="message"
              name="message"
              rows="5"
              placeholder="Tell us about décor, menu preferences, rooms needed or any special requests."
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg">
            <Icon name="mail" size={16} /> Send enquiry
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    if (form) {
      function setFieldError(fieldInput: HTMLElement, message: string) {
        fieldInput.classList.add('is-invalid');
        const parent = fieldInput.closest('.field');
        if (parent) {
          let errSpan = parent.querySelector('.field-error-msg');
          if (!errSpan) {
            errSpan = document.createElement('span');
            errSpan.className = 'field-error-msg';
            parent.appendChild(errSpan);
          }
          errSpan.textContent = message;
        }
      }

      function clearFieldError(fieldInput: HTMLElement) {
        fieldInput.classList.remove('is-invalid');
        const parent = fieldInput.closest('.field');
        if (parent) {
          const errSpan = parent.querySelector('.field-error-msg');
          if (errSpan) errSpan.remove();
        }
      }

      // Clear error on user input
      form.querySelectorAll('input, select, textarea').forEach((el) => {
        el.addEventListener('input', () => clearFieldError(el as HTMLElement));
        el.addEventListener('change', () => clearFieldError(el as HTMLElement));
      });

      form.addEventListener('submit', (event) => {
        let firstInvalid: HTMLElement | null = null;

        const nameInput = form.querySelector('#name') as HTMLInputElement;
        if (nameInput && (!nameInput.value || nameInput.value.trim().length < 2)) {
          setFieldError(nameInput, 'Please enter your full name (at least 2 characters).');
          if (!firstInvalid) firstInvalid = nameInput;
        } else if (nameInput) {
          clearFieldError(nameInput);
        }

        const phoneInput = form.querySelector('#phone') as HTMLInputElement;
        const phoneRegex = /^[6-9]\d{9}$/;
        const cleanPhone = phoneInput ? phoneInput.value.replace(/\D/g, '') : '';
        if (phoneInput && !phoneRegex.test(cleanPhone)) {
          setFieldError(phoneInput, 'Enter a valid 10-digit Indian mobile number (e.g., 9876543210).');
          if (!firstInvalid) firstInvalid = phoneInput;
        } else if (phoneInput) {
          clearFieldError(phoneInput);
        }

        const emailInput = form.querySelector('#email') as HTMLInputElement;
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (emailInput && (!emailInput.value || !emailRegex.test(emailInput.value.trim()))) {
          setFieldError(emailInput, 'Enter a valid email address.');
          if (!firstInvalid) firstInvalid = emailInput;
        } else if (emailInput) {
          clearFieldError(emailInput);
        }

        const dateInput = form.querySelector('#event_date') as HTMLInputElement;
        const todayStr = new Date().toISOString().slice(0, 10);
        if (dateInput && dateInput.value && dateInput.value < todayStr) {
          setFieldError(dateInput, 'Event date cannot be in the past.');
          if (!firstInvalid) firstInvalid = dateInput;
        } else if (dateInput) {
          clearFieldError(dateInput);
        }

        const guestInput = form.querySelector('#guest_count') as HTMLInputElement;
        if (guestInput && guestInput.value && (Number(guestInput.value) <= 0 || !Number.isInteger(Number(guestInput.value)))) {
          setFieldError(guestInput, 'Estimated guests must be a positive integer.');
          if (!firstInvalid) firstInvalid = guestInput;
        } else if (guestInput) {
          clearFieldError(guestInput);
        }

        if (firstInvalid) {
          event.preventDefault();
          (firstInvalid as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
          (firstInvalid as HTMLElement).focus();
        }
      });
    }
  </script>
</BaseLayout>
