---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import type { PlanCatalogue } from '../service';
import { imageUrl } from '../../../core/http';

interface Props {
  catalogue: PlanCatalogue;
  csrf: string;
  eventTypes: readonly string[];
  budgetRanges: readonly string[];
  preferredContactMethods: readonly string[];
  today: string;
}

const { catalogue, csrf, eventTypes, budgetRanges, preferredContactMethods, today } = Astro.props;

const phases = [
  { step: '1', title: 'Event & Venue', short: 'Event', icon: 'calendar', subtitle: 'Essentials & Dates' },
  { step: '2', title: 'Decor & Stages', short: 'Decor', icon: 'sparkles', subtitle: 'Mandap, Stage & Styling' },
  { step: '3', title: 'Seating & Stay', short: 'Setup', icon: 'chair', subtitle: 'Equipment & Rooms' },
  { step: '4', title: 'Review & Quote', short: 'Review', icon: 'check-circle', subtitle: 'Blueprint & Contact' },
];

const lightingOptions = [
  { name: 'Warm fairy lights', desc: 'Golden romantic canopy', icon: 'light' },
  { name: 'Crystal chandeliers', desc: 'Regal opulent ambiance', icon: 'sparkles' },
  { name: 'LED uplighting', desc: 'Vibrant modern wash', icon: 'sparkles' },
  { name: 'Natural daylight', desc: 'Open lawn & garden setup', icon: 'sparkles' },
  { name: 'Not sure yet', desc: 'Consult with designer', icon: 'info' },
];

const floralOptions = [
  { name: 'Maroon & ivory', desc: 'Traditional royal wedding', color: '#721c24' },
  { name: 'Pastel blush', desc: 'Soft romantic elegance', color: '#e8a598' },
  { name: 'All white', desc: 'Pure contemporary luxury', color: '#ffffff' },
  { name: 'Jewel tones', desc: 'Rich ruby & emerald festive', color: '#8b1e42' },
  { name: 'Marigold', desc: 'Vibrant haldi & auspicious', color: '#f59e0b' },
  { name: 'Mixed seasonal', desc: 'Curated seasonal blooms', color: '#10b981' },
  { name: 'Not sure yet', desc: 'Decide during consultation', color: '#9ca3af' },
];

const catalogueJson = JSON.stringify(catalogue).replace(/</g, '\\u003c');
const equipmentCount = catalogue.equipment.reduce((sum, category) => sum + category.items.length, 0);
---

<BaseLayout
  title="Plan Your Celebration | Bespoke Event Blueprint | Event Point Ranchi"
  description="Build your wedding mandap, reception stage, furniture and hospitality requirements and receive an itemised quotation from Event Point Ranchi."
>
  <!-- Page Hero -->
  <section class="page-hero plan-hero">
    <div class="container">
      <span class="eyebrow" style="color:var(--gold-bright);">Bespoke Event Architecture</span>
      <h1>Design your celebration blueprint.</h1>
      <p>
        Select your signature mandap, grand reception stage, banquet seating, and guest accommodations.
        Our Ranchi planning concierges review every specification and craft an itemised quotation.
      </p>
      <div class="plan-hero-note">
        <Icon name="info" size={17} />
        <span>Official quotation enquiry. No advance required at this stage. Date availability and inventory confirmed in writing.</span>
      </div>
    </div>
  </section>

  <!-- Planning Wizard Shell -->
  <section class="section plan-section">
    <div class="container plan-shell" id="planShell">
      
      <!-- Modern 4-Phase Stepper Navigation -->
      <nav class="plan-stepper-nav" aria-label="Planning progression">
        <ol class="plan-stepper-list">
          {phases.map((phase, index) => (
            <li class="plan-stepper-item">
              <button
                type="button"
                class:list={['plan-stepper-btn', { 'is-active': index === 0 }]}
                data-plan-step-link={phase.step}
                aria-current={index === 0 ? 'step' : undefined}
              >
                <span class="stepper-badge">
                  <span class="stepper-num">{phase.step}</span>
                  <span class="stepper-check" aria-hidden="true">✓</span>
                </span>
                <span class="stepper-meta">
                  <strong class="stepper-title">{phase.title}</strong>
                  <small class="stepper-sub">{phase.subtitle}</small>
                </span>
              </button>
            </li>
          ))}
        </ol>
        <div class="plan-stepper-bar">
          <div class="plan-stepper-progress" data-plan-progress-bar style="width: 25%;"></div>
        </div>
        <p class="plan-progress-text" data-plan-progress-text aria-live="polite">Phase 1 of 4 — Event &amp; Venue Essentials</p>
      </nav>

      <div class="plan-layout">
        <form class="plan-form panel" id="planForm" data-csrf={csrf} data-today={today} novalidate>
          <div class="plan-error" data-plan-error role="alert" tabindex="-1" hidden></div>
          
          <div class="plan-form-header">
            <span class="form-required-legend">
              <span class="required-indicator" aria-hidden="true">*</span> Mandatory details for accurate quotation
            </span>
          </div>

          <!-- ========================================== -->
          <!-- PHASE 1: EVENT & VENUE ESSENTIALS          -->
          <!-- ========================================== -->
          <section class="plan-step" data-plan-step="1" aria-labelledby="plan-phase-1-title">
            <header class="plan-step-head">
              <span class="plan-step-kicker">Phase 1 of 4</span>
              <h2 id="plan-phase-1-title">Event &amp; Venue Essentials</h2>
              <p>Establish the foundation of your celebration. Dates and guest scale allow us to verify space feasibility and artisan availability.</p>
            </header>

            <div class="form-grid cols-2">
              <div class="field" data-field-wrap="eventType">
                <label for="eventType">
                  Event celebration type <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <select class="select" id="eventType" name="eventType" required aria-required="true">
                  <option value="">Select ceremony or event</option>
                  {eventTypes.map((type) => <option value={type}>{type}</option>)}
                </select>
              </div>

              <div class="field" data-field-wrap="guestCount">
                <label for="guestCount">
                  Estimated guest attendance <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <div class="input-with-icon">
                  <input
                    class="input"
                    id="guestCount"
                    name="guestCount"
                    type="number"
                    min="1"
                    max="100000"
                    step="1"
                    inputmode="numeric"
                    placeholder="e.g. 350"
                    required
                    aria-required="true"
                  />
                  <span class="input-affix">guests</span>
                </div>
              </div>

              <div class="field" data-field-wrap="eventDate">
                <label for="eventDate">
                  Event date <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <input class="input" id="eventDate" name="eventDate" type="date" min={today} required aria-required="true" />
              </div>

              <div class="field" data-field-wrap="endDate">
                <label for="endDate">End date <span class="label-optional">(optional if multi-day)</span></label>
                <input class="input" id="endDate" name="endDate" type="date" min={today} />
              </div>

              <div class="field" data-field-wrap="eventTime">
                <label for="eventTime">Auspicious / start time <span class="label-optional">(optional)</span></label>
                <input class="input" id="eventTime" name="eventTime" type="time" />
              </div>

              <div class="field" data-field-wrap="venueLocation">
                <label for="venueLocation">
                  Venue or area in Ranchi <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <input
                  class="input"
                  id="venueLocation"
                  name="venueLocation"
                  type="text"
                  placeholder="e.g. Harmu Ground, Ranchi Club, Morabadi"
                  required
                  aria-required="true"
                />
              </div>
            </div>

            <div class="field" data-field-wrap="eventDescription">
              <label for="eventDescription">Celebration vision &amp; ceremony sequence <span class="label-optional">(optional)</span></label>
              <textarea
                class="textarea"
                id="eventDescription"
                name="eventDescription"
                rows="4"
                placeholder="Share any special rituals, baraat timing, family traditions, or specific setup requests…"
              ></textarea>
            </div>
          </section>

          <!-- ========================================== -->
          <!-- PHASE 2: MANDAP, STAGE & STYLING ARCHITECTURE -->
          <!-- ========================================== -->
          <section class="plan-step" data-plan-step="2" aria-labelledby="plan-phase-2-title" hidden>
            <header class="plan-step-head">
              <span class="plan-step-kicker">Phase 2 of 4</span>
              <h2 id="plan-phase-2-title">Mandap &amp; Stage Architecture</h2>
              <p>Choose your signature mandap and ceremonial stage. Select standard dimensions or specify custom proportions for your venue.</p>
            </header>

            <!-- MANDAP SELECTION -->
            <div class="section-block">
              <div class="section-block-head">
                <div class="section-badge-pill">Mandap Selection</div>
                <h3>Choose your sacred Mandap design</h3>
                <p>Select a signature design from our catalogue or choose to skip if your venue provides a built-in mandap structure.</p>
              </div>

              <!-- Hidden select for form serialization -->
              <select class="sr-only" id="mandapId" name="mandapId" tabindex="-1" aria-hidden="true">
                <option value="">Skip — no mandap selected</option>
                {catalogue.mandaps.map((mandap) => (
                  <option
                    value={mandap.id}
                    data-standard={`${mandap.length_ft} × ${mandap.width_ft} × ${mandap.height_ft} ${mandap.dimension_unit}`}
                  >
                    {mandap.name}
                  </option>
                ))}
              </select>

              <!-- Visual Cards Grid -->
              <div class="plan-visual-grid" role="radiogroup" aria-label="Mandap designs">
                <!-- Skip Card -->
                <div
                  class="plan-visual-card plan-skip-card is-selected"
                  data-plan-mandap-card=""
                  role="radio"
                  aria-checked="true"
                  tabindex="0"
                >
                  <div class="skip-card-inner">
                    <span class="skip-icon"><Icon name="x" size={20} /></span>
                    <strong>No Mandap Required</strong>
                    <small>Venue already has a structure or mandap not needed</small>
                    <span class="card-status-badge">Default</span>
                  </div>
                </div>

                <!-- Catalogue Mandap Cards -->
                {catalogue.mandaps.map((mandap) => (
                  <div
                    class="plan-visual-card"
                    data-plan-mandap-card={mandap.id}
                    role="radio"
                    aria-checked="false"
                    tabindex="0"
                  >
                    <div class="card-image-wrap">
                      <img src={imageUrl(mandap.image)} alt={mandap.name} loading="lazy" />
                      <span class="card-cat-badge">{mandap.category}</span>
                      <span class="card-selected-tick" aria-hidden="true">✓</span>
                    </div>
                    <div class="card-content">
                      <h4 class="card-title">{mandap.name}</h4>
                      <div class="card-dimension-tag">
                        <span>Standard:</span> {mandap.length_ft} × {mandap.width_ft} × {mandap.height_ft} {mandap.dimension_unit}
                      </div>
                      <p class="card-snippet">{mandap.material_specs || mandap.description}</p>
                      <button type="button" class="btn btn-secondary btn-sm card-select-btn" data-plan-mandap-select={mandap.id}>
                        Select Mandap
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Custom Dimensions Accordion -->
              <details class="dimension-accordion" data-mandap-dimension-accordion>
                <summary class="dimension-accordion-trigger">
                  <div class="accordion-trigger-title">
                    <Icon name="edit" size={16} />
                    <span>Customize Mandap Dimensions &amp; Layout Notes</span>
                  </div>
                  <span class="accordion-badge">Optional</span>
                </summary>
                <div class="dimension-accordion-body">
                  <p class="accordion-hint">
                    Leave blank to use the artisan's standard dimensions, or enter custom length, width, and height in feet:
                  </p>
                  <div class="form-grid cols-3">
                    <div class="field">
                      <label for="mandapLength">Length (ft)</label>
                      <input class="input" id="mandapLength" name="mandapLength" type="number" min="1" step="0.5" inputmode="decimal" data-custom-dim="mandap" placeholder="e.g. 18" />
                    </div>
                    <div class="field">
                      <label for="mandapWidth">Width (ft)</label>
                      <input class="input" id="mandapWidth" name="mandapWidth" type="number" min="1" step="0.5" inputmode="decimal" data-custom-dim="mandap" placeholder="e.g. 18" />
                    </div>
                    <div class="field">
                      <label for="mandapHeight">Height (ft)</label>
                      <input class="input" id="mandapHeight" name="mandapHeight" type="number" min="1" step="0.5" inputmode="decimal" data-custom-dim="mandap" placeholder="e.g. 12" />
                    </div>
                  </div>
                  <div class="field" style="margin-top: 14px;">
                    <label for="mandapNotes">Mandap placement &amp; entrance notes <span class="label-optional">(optional)</span></label>
                    <textarea class="textarea" id="mandapNotes" name="mandapNotes" rows="2" placeholder="Entrance orientation, venue height clearance, holy fire pit safety…"></textarea>
                  </div>
                </div>
              </details>
            </div>

            <hr class="plan-divider" />

            <!-- STAGE SELECTION -->
            <div class="section-block">
              <div class="section-block-head">
                <div class="section-badge-pill">Stage Architecture</div>
                <h3>Choose your Grand Reception Stage</h3>
                <p>Select a backdrop and stage platform or skip if your ceremony does not require a formal reception stage.</p>
              </div>

              <!-- Hidden select for form serialization -->
              <select class="sr-only" id="stageId" name="stageId" tabindex="-1" aria-hidden="true">
                <option value="">Skip — no stage selected</option>
                {catalogue.stages.map((stage) => (
                  <option
                    value={stage.id}
                    data-standard={`${stage.length_ft} × ${stage.width_ft} × ${stage.height_ft} ${stage.dimension_unit}`}
                  >
                    {stage.name}
                  </option>
                ))}
              </select>

              <!-- Visual Cards Grid -->
              <div class="plan-visual-grid" role="radiogroup" aria-label="Stage designs">
                <!-- Skip Card -->
                <div
                  class="plan-visual-card plan-skip-card is-selected"
                  data-plan-stage-card=""
                  role="radio"
                  aria-checked="true"
                  tabindex="0"
                >
                  <div class="skip-card-inner">
                    <span class="skip-icon"><Icon name="x" size={20} /></span>
                    <strong>No Stage Required</strong>
                    <small>Celebration will utilize ground seating or venue platform</small>
                    <span class="card-status-badge">Default</span>
                  </div>
                </div>

                <!-- Catalogue Stage Cards -->
                {catalogue.stages.map((stage) => (
                  <div
                    class="plan-visual-card"
                    data-plan-stage-card={stage.id}
                    role="radio"
                    aria-checked="false"
                    tabindex="0"
                  >
                    <div class="card-image-wrap">
                      <img src={imageUrl(stage.image)} alt={stage.name} loading="lazy" />
                      <span class="card-cat-badge">{stage.style_category}</span>
                      <span class="card-selected-tick" aria-hidden="true">✓</span>
                    </div>
                    <div class="card-content">
                      <h4 class="card-title">{stage.name}</h4>
                      <div class="card-dimension-tag">
                        <span>Standard:</span> {stage.length_ft} × {stage.width_ft} × {stage.height_ft} {stage.dimension_unit}
                      </div>
                      <p class="card-snippet">{stage.decoration_notes || stage.description}</p>
                      <button type="button" class="btn btn-secondary btn-sm card-select-btn" data-plan-stage-select={stage.id}>
                        Select Stage
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Custom Dimensions Accordion -->
              <details class="dimension-accordion" data-stage-dimension-accordion>
                <summary class="dimension-accordion-trigger">
                  <div class="accordion-trigger-title">
                    <Icon name="edit" size={16} />
                    <span>Customize Stage Dimensions &amp; Backdrop Notes</span>
                  </div>
                  <span class="accordion-badge">Optional</span>
                </summary>
                <div class="dimension-accordion-body">
                  <p class="accordion-hint">
                    Leave blank for standard proportions, or specify custom stage footprint in feet:
                  </p>
                  <div class="form-grid cols-3">
                    <div class="field">
                      <label for="stageLength">Length (ft)</label>
                      <input class="input" id="stageLength" name="stageLength" type="number" min="1" step="0.5" inputmode="decimal" data-custom-dim="stage" placeholder="e.g. 24" />
                    </div>
                    <div class="field">
                      <label for="stageWidth">Width (ft)</label>
                      <input class="input" id="stageWidth" name="stageWidth" type="number" min="1" step="0.5" inputmode="decimal" data-custom-dim="stage" placeholder="e.g. 14" />
                    </div>
                    <div class="field">
                      <label for="stageHeight">Height (ft)</label>
                      <input class="input" id="stageHeight" name="stageHeight" type="number" min="1" step="0.5" inputmode="decimal" data-custom-dim="stage" placeholder="e.g. 10" />
                    </div>
                  </div>
                  <div class="field" style="margin-top: 14px;">
                    <label for="stageNotes">Backdrop &amp; elevation notes <span class="label-optional">(optional)</span></label>
                    <textarea class="textarea" id="stageNotes" name="stageNotes" rows="2" placeholder="Sofa riser height, LED wall integration, floral draping accents…"></textarea>
                  </div>
                </div>
              </details>
            </div>

            <hr class="plan-divider" />

            <!-- STYLING & AMBIANCE -->
            <div class="section-block">
              <div class="section-block-head">
                <div class="section-badge-pill">Ambiance &amp; Styling</div>
                <h3>Lighting &amp; Floral Themes</h3>
                <p>Define the mood and aesthetic theme of the celebration to guide our decorative artisans.</p>
              </div>

              <!-- Hidden selects for styling -->
              <select class="sr-only" id="lighting" name="lighting" tabindex="-1" aria-hidden="true">
                {lightingOptions.map((opt) => <option value={opt.name}>{opt.name}</option>)}
              </select>
              <select class="sr-only" id="floralPalette" name="floralPalette" tabindex="-1" aria-hidden="true">
                {floralOptions.map((opt) => <option value={opt.name}>{opt.name}</option>)}
              </select>

              <div class="styling-swatch-section">
                <label class="swatch-label">Lighting Style Preference</label>
                <div class="swatch-grid" role="radiogroup" aria-label="Lighting style options">
                  {lightingOptions.map((opt, i) => (
                    <button
                      type="button"
                      class:list={['swatch-card', { 'is-selected': i === 0 }]}
                      data-plan-lighting-swatch={opt.name}
                      role="radio"
                      aria-checked={i === 0 ? 'true' : 'false'}
                    >
                      <span class="swatch-icon"><Icon name="sparkles" size={15} /></span>
                      <span class="swatch-text">
                        <strong>{opt.name}</strong>
                        <small>{opt.desc}</small>
                      </span>
                      <span class="swatch-check">✓</span>
                    </button>
                  ))}
                </div>
              </div>

              <div class="styling-swatch-section" style="margin-top: 20px;">
                <label class="swatch-label">Floral &amp; Color Palette</label>
                <div class="swatch-grid" role="radiogroup" aria-label="Floral palette options">
                  {floralOptions.map((opt, i) => (
                    <button
                      type="button"
                      class:list={['swatch-card', { 'is-selected': i === 0 }]}
                      data-plan-floral-swatch={opt.name}
                      role="radio"
                      aria-checked={i === 0 ? 'true' : 'false'}
                    >
                      <span class="color-dot" style={`background-color: ${opt.color}; border: 1px solid rgba(0,0,0,0.15);`}></span>
                      <span class="swatch-text">
                        <strong>{opt.name}</strong>
                        <small>{opt.desc}</small>
                      </span>
                      <span class="swatch-check">✓</span>
                    </button>
                  ))}
                </div>
              </div>

              <div class="field" style="margin-top: 20px;">
                <label for="specialInstructions">Special decorative nuances <span class="label-optional">(optional)</span></label>
                <textarea
                  class="textarea"
                  id="specialInstructions"
                  name="specialInstructions"
                  rows="3"
                  placeholder="Photography priorities, VIP seating arrangements, specific holy symbols, scenting or entry gates…"
                ></textarea>
              </div>
            </div>
          </section>

          <!-- ========================================== -->
          <!-- PHASE 3: SEATING, EQUIPMENT & HOSPITALITY  -->
          <!-- ========================================== -->
          <section class="plan-step" data-plan-step="3" aria-labelledby="plan-phase-3-title" hidden>
            <header class="plan-step-head">
              <span class="plan-step-kicker">Phase 3 of 4</span>
              <h2 id="plan-phase-3-title">Seating, Equipment &amp; Hospitality</h2>
              <p>Configure guest seating, banquet tables, sound/lighting gear, and hotel room requirements for out-of-town guests.</p>
            </header>

            <!-- EQUIPMENT & FURNITURE CATALOG -->
            <div class="section-block">
              <div class="section-block-head split-flex">
                <div>
                  <div class="section-badge-pill">Inventory &amp; Seating</div>
                  <h3>Furniture, Dining &amp; Technical Equipment</h3>
                  <p>Browse our verified Ranchi inventory ({equipmentCount} items available). Increment quantities directly on each item card.</p>
                </div>
                <div class="equipment-live-badge" data-plan-equipment-status>
                  0 items selected
                </div>
              </div>

              <!-- Category filter tabs -->
              <div class="equipment-tabs-bar" data-equipment-tabs role="tablist" aria-label="Inventory categories">
                {catalogue.equipment.map((cat, i) => (
                  <button
                    type="button"
                    class:list={['equipment-tab-btn', { 'is-active': i === 0 }]}
                    data-equipment-tab={cat.slug}
                    role="tab"
                    aria-selected={i === 0 ? 'true' : 'false'}
                  >
                    {cat.name}
                  </button>
                ))}
              </div>

              <!-- Interactive Equipment Grid (Rendered client-side per tab) -->
              <div class="equipment-card-grid" data-equipment-grid>
                <!-- Filled dynamically by plan-wizard.ts -->
              </div>

              <div class="field" style="margin-top: 20px;">
                <label for="equipmentNotes">Delivery &amp; setup logistics notes <span class="label-optional">(optional)</span></label>
                <textarea
                  class="textarea"
                  id="equipmentNotes"
                  name="equipmentNotes"
                  rows="3"
                  placeholder="Venue access gates, setup timing, power generator requirements, weather backup plans…"
                ></textarea>
              </div>
            </div>

            <hr class="plan-divider" />

            <!-- GUEST ACCOMMODATION -->
            <div class="section-block">
              <div class="section-block-head">
                <div class="section-badge-pill">Guest Hospitality</div>
                <h3>Guest Accommodations in Ranchi</h3>
                <p>We negotiate and coordinate premium hotel blocks across Ranchi for visiting family and attendees.</p>
              </div>

              <fieldset class="field-group">
                <legend class="sr-only">Do you require guest rooms?</legend>
                <div class="option-row">
                  <label class="option-card">
                    <input type="radio" name="requiresRooms" value="yes" required aria-required="true" />
                    <div class="option-card-content">
                      <span class="option-icon"><Icon name="bed" size={20} /></span>
                      <div>
                        <strong>Yes — We require room blocks</strong>
                        <small>Coordinate discounted hotel rooms in Ranchi for guests</small>
                      </div>
                    </div>
                  </label>
                  <label class="option-card">
                    <input type="radio" name="requiresRooms" value="no" checked />
                    <div class="option-card-content">
                      <span class="option-icon"><Icon name="x-circle" size={20} /></span>
                      <div>
                        <strong>No — Self-arranged stay</strong>
                        <small>Guests will make their own accommodation arrangements</small>
                      </div>
                    </div>
                  </label>
                </div>
              </fieldset>

              <div class="form-grid cols-2" data-room-count-field hidden style="margin-top: 16px;">
                <div class="field" data-field-wrap="acRoomCount">
                  <label for="acRoomCount">
                    Air-Conditioned (AC) rooms <span class="required-indicator" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="input"
                    id="acRoomCount"
                    name="acRoomCount"
                    type="number"
                    min="0"
                    max="500"
                    step="1"
                    inputmode="numeric"
                    placeholder="e.g. 15"
                    data-ac-room-input
                  />
                  <span class="hint">Premium air-conditioned hotel rooms.</span>
                </div>

                <div class="field" data-field-wrap="nonAcRoomCount">
                  <label for="nonAcRoomCount">
                    Non-AC / Standard rooms <span class="required-indicator" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="input"
                    id="nonAcRoomCount"
                    name="nonAcRoomCount"
                    type="number"
                    min="0"
                    max="500"
                    step="1"
                    inputmode="numeric"
                    placeholder="e.g. 10"
                    data-non-ac-room-input
                  />
                  <span class="hint">Comfortable non-AC / standard guest rooms.</span>
                </div>
                <input type="hidden" id="roomCount" name="roomCount" data-room-count-input />
              </div>

              <div class="field" data-field-wrap="accommodationNotes" style="margin-top: 14px;">
                <label for="accommodationNotes">Hospitality &amp; stay notes <span class="label-optional">(optional)</span></label>
                <textarea
                  class="textarea"
                  id="accommodationNotes"
                  name="accommodationNotes"
                  rows="3"
                  placeholder="Number of nights, preferred location in Ranchi, early check-in needs, bride/groom suite…"
                ></textarea>
              </div>
            </div>
          </section>

          <!-- ========================================== -->
          <!-- PHASE 4: CONTACT & QUOTATION REVIEW        -->
          <!-- ========================================== -->
          <section class="plan-step" data-plan-step="4" aria-labelledby="plan-phase-4-title" hidden>
            <header class="plan-step-head">
              <span class="plan-step-kicker">Phase 4 of 4</span>
              <h2 id="plan-phase-4-title">Contact &amp; Quotation Review</h2>
              <p>Review your assembled celebration blueprint and provide your contact information to receive the itemised quotation.</p>
            </header>

            <!-- BUDGET & CONTACT DETAILS -->
            <div class="section-block">
              <div class="section-block-head">
                <div class="section-badge-pill">Planner Contact</div>
                <h3>Your Contact Details &amp; Budget Range</h3>
                <p>We use this information exclusively to communicate availability and send your official quotation.</p>
              </div>

              <div class="field" data-field-wrap="budgetRange" style="margin-bottom: 18px;">
                <label for="budgetRange">
                  Approximate budget range (INR) <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <select class="select" id="budgetRange" name="budgetRange" required aria-required="true">
                  <option value="">Select target budget bracket</option>
                  {budgetRanges.map((range) => <option value={range}>{range}</option>)}
                </select>
              </div>

              <div class="form-grid cols-2">
                <div class="field" data-field-wrap="customerName">
                  <label for="customerName">
                    Full name <span class="required-indicator" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="input"
                    id="customerName"
                    name="customerName"
                    type="text"
                    autocomplete="name"
                    required
                    aria-required="true"
                    placeholder="e.g. Ramesh Kumar"
                  />
                </div>

                <div class="field" data-field-wrap="customerPhone">
                  <label for="customerPhone">
                    Indian mobile number <span class="required-indicator" aria-hidden="true">*</span>
                  </label>
                  <div class="input-with-prefix">
                    <span class="prefix">+91</span>
                    <input
                      class="input"
                      id="customerPhone"
                      name="customerPhone"
                      type="tel"
                      inputmode="tel"
                      autocomplete="tel"
                      pattern="[6-9][0-9]{9}"
                      maxlength="10"
                      required
                      aria-required="true"
                      placeholder="9876543210"
                    />
                  </div>
                  <span class="hint">10 digits starting with 6, 7, 8 or 9.</span>
                </div>

                <div class="field" data-field-wrap="customerEmail">
                  <label for="customerEmail">Email address <span class="label-optional">(optional)</span></label>
                  <input
                    class="input"
                    id="customerEmail"
                    name="customerEmail"
                    type="email"
                    autocomplete="email"
                    placeholder="you@example.com"
                  />
                </div>

                <div class="field" data-field-wrap="preferredContact">
                  <label for="preferredContact">
                    Preferred communication channel <span class="required-indicator" aria-hidden="true">*</span>
                  </label>
                  <select class="select" id="preferredContact" name="preferredContact" required aria-required="true">
                    <option value="">Select contact preference</option>
                    {preferredContactMethods.map((method) => <option value={method}>{method}</option>)}
                  </select>
                </div>
              </div>
            </div>

            <hr class="plan-divider" />

            <!-- QUOTATION BLUEPRINT REVIEW -->
            <div class="section-block">
              <div class="section-block-head">
                <div class="section-badge-pill">Summary Review</div>
                <h3>Quotation Blueprint Overview</h3>
                <p>Verify all specifications. Click “Edit” on any block to return and adjust choices.</p>
              </div>

              <div class="plan-review" data-plan-review>
                <!-- Rendered dynamically by plan-wizard.ts -->
              </div>
            </div>

            <!-- LEGAL CONSENT & SUBMISSION -->
            <div class="plan-submission-box">
              <label class="checkbox-row plan-consent" data-field-wrap="consent">
                <input type="checkbox" name="consent" id="consent" required aria-required="true" />
                <span>
                  I understand this is an enquiry for a formal quotation <span class="required-indicator" aria-hidden="true">*</span>. It does not charge any amount, hold a date, or reserve inventory until Event Point Ranchi confirms availability and receives written approval.
                </span>
              </label>

              <div class="plan-submit-row">
                <button type="submit" class="btn btn-primary btn-lg" data-plan-submit>
                  <Icon name="mail" size={17} /> Submit Quotation Enquiry
                </button>
                <a href="/contact" class="btn btn-secondary">Have Questions? Call Concierge</a>
              </div>

              <div class="plan-reassurance-strip">
                <span><Icon name="shield" size={14} /> 100% Free Consultation</span>
                <span><Icon name="check-circle" size={14} /> Itemised Transparent Pricing</span>
                <span><Icon name="phone" size={14} /> Same-day Coordinator Response</span>
              </div>
            </div>
          </section>

          <!-- Navigation Footer -->
          <div class="plan-nav">
            <button type="button" class="btn btn-secondary" data-plan-prev hidden>
              ← Back
            </button>
            <span class="plan-nav-spacer"></span>
            <button type="button" class="btn btn-primary" data-plan-next>
              Continue →
            </button>
          </div>
        </form>

        <!-- Aside Live Blueprint Card -->
        <aside class="plan-aside">
          <div class="plan-aside-card plan-blueprint-card">
            <div class="blueprint-card-head">
              <span class="blueprint-pulse"></span>
              <h3>Live Event Blueprint</h3>
            </div>
            <p class="blueprint-card-desc">Your selections update automatically as you build your requirements.</p>

            <div class="blueprint-summary-list" data-plan-live-summary>
              <!-- Rendered dynamically by plan-wizard.ts -->
            </div>

            <div class="blueprint-cta-group">
              <a href="/gallery" class="text-link" target="_blank" rel="noopener">
                Browse real event gallery ↗
              </a>
            </div>
          </div>

          <div class="plan-aside-card plan-aside-concierge">
            <span class="eyebrow" style="color:var(--gold-bright);">Ranchi Planning Studio</span>
            <h4>Speak with our Event Directors</h4>
            <p>Need urgent date reservation or venue site measurement advice?</p>
            <a href="tel:+919876543210" class="btn btn-secondary btn-block">
              <Icon name="phone" size={15} /> +91 98765 43210
            </a>
            <a href="https://wa.me/919876543210" class="btn btn-primary btn-block" target="_blank" rel="noopener">
              WhatsApp Concierge
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Official Digital Enquiry Slip Receipt -->
  <section class="section-sm plan-receipt-section" data-plan-receipt hidden aria-live="polite">
    <div class="container print-receipt-container">
      <div class="plan-receipt print-receipt-card">
        <span class="receipt-icon"><Icon name="check-circle" size={36} /></span>
        <span class="eyebrow" style="color:var(--gold-deep);">Enquiry Transmitted</span>
        <h2>Your Celebration Blueprint is with our Ranchi Planning Team.</h2>
        <p>
          We have recorded your requirements. A dedicated wedding director is reviewing dates, venue space, and equipment availability before compiling your itemised quotation.
        </p>

        <div class="receipt-reference">
          <span>Reference Identification Code</span>
          <strong data-receipt-reference>—</strong>
        </div>

        <!-- Official Digital QR Check-in Slip -->
        <div class="receipt-qr-card" data-receipt-qr-container hidden>
          <img data-receipt-qr src="" alt="Enquiry QR Code" />
          <div class="receipt-qr-copy">
            <span class="receipt-qr-badge">Official Digital Enquiry Slip</span>
            <h4>Instant Coordinator Check-in QR</h4>
            <p>
              Present this QR code to our planning team at our Main Road Ranchi studio or on-site for immediate blueprint retrieval.
            </p>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">
              <a href="#" class="btn btn-gold btn-sm" data-receipt-view-link target="_blank" rel="noopener">
                <Icon name="external" size={14} /> View Full Receipt
              </a>
              <a href="#" class="btn btn-secondary btn-sm" data-receipt-pdf-link download>
                <Icon name="download" size={14} /> Download PDF
              </a>
              <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">
                <Icon name="receipt" size={14} /> Print Enquiry Slip
              </button>
            </div>
          </div>
        </div>

        <div class="receipt-actions">
          <a href="#" class="btn btn-primary" data-receipt-primary-link>View &amp; Print Full Receipt</a>
          <a href="/gallery" class="btn btn-secondary">Explore Design Gallery</a>
          <a href="/" class="btn btn-ghost">Return to Homepage</a>
        </div>

        <p class="receipt-note">
          <Icon name="info" size={15} />
          Nothing has been charged. This is an enquiry acknowledgement receipt, not a confirmed booking. Event Point Ranchi will confirm all item availability and date reservations in writing.
        </p>
      </div>
    </div>
  </section>

  <!-- Injected Catalogue JSON for Client Logic -->
  <script type="application/json" id="planCatalogue" set:html={catalogueJson}></script>
  <script>
    import '../../../client/plan-wizard';
  </script>
</BaseLayout>
