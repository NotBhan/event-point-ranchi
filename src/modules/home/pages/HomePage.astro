---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MandapCard from '../../../components/MandapCard.astro';
import StageCard from '../../../components/StageCard.astro';
import VideoPreviewCard from '../../../components/VideoPreviewCard.astro';
import Icon from '../../../components/Icon.astro';
import { imageUrl } from '../../../core/http';
import { site } from '../../../core/config';
import type { HomeData } from '../service';
import { getHomepageContent, getPageContent, getVideoPreviews } from '../../../core/content/service';

interface Props {
  data: HomeData;
}

const { data } = Astro.props;
const { heroImage, mandaps, stages, equipment, galleryCategories, galleryItems, stats } = data;

const [pageContent, homepageContent, featuredVideos] = await Promise.all([
  getPageContent('home'),
  getHomepageContent(heroImage ?? undefined),
  getVideoPreviews({ onlyPublished: true, featuredOnly: true, limit: 3 }),
]);

const heroHeading = pageContent.title || homepageContent.heroHeading;
const heroSubtitle = pageContent.subtitle || homepageContent.heroSubtitle;
const heroImg = (pageContent.banner_enabled && pageContent.banner_image_url) ? pageContent.banner_image_url : homepageContent.heroImage;
const heroBadge = pageContent.content_json?.badge || 'Ranchi · Wedding setup studio';
const primaryCta = pageContent.content_json?.primaryCta || homepageContent.primaryCta;
const secondaryCta = pageContent.content_json?.secondaryCta || homepageContent.secondaryCta;

const steps = homepageContent.steps.map((s) => [s.stepNumber, s.title, s.description]);
---

<BaseLayout
  title={pageContent.seo_title || "Event Point Ranchi | Wedding Mandaps, Stage Designs & Event Equipment"}
  description={pageContent.seo_description || "Wedding mandap, stage designs, furniture and event equipment planning in Ranchi. Build your requirements and request a quotation from Event Point Ranchi."}
>
  <section class="hero wedding-hero">
    {heroImg && <img class="hero-media" src={imageUrl(heroImg)} alt="" />}
    <div class="container hero-inner">
      <span class="eyebrow" style="color:var(--gold-bright);">{heroBadge}</span>
      <h1>{heroHeading}</h1>
      <p>{heroSubtitle}</p>
      <div class="hero-actions">
        <a href={primaryCta.url} class="btn btn-gold btn-lg">
          {primaryCta.label} <Icon name="arrow-right" size={16} />
        </a>
        <a href={secondaryCta.url} class="btn btn-secondary btn-lg">{secondaryCta.label}</a>
      </div>
      {homepageContent.sectionsVisibility.stats && (
        <div class="hero-meta">
          <div><strong>{stats.mandaps}</strong><span>Mandap designs</span></div>
          <div><strong>{stats.stages}</strong><span>Stage concepts</span></div>
          <div><strong>{stats.equipment}</strong><span>Equipment items</span></div>
          <div><strong>{stats.gallery}</strong><span>Portfolio moments</span></div>
        </div>
      )}
    </div>
  </section>

  {homepageContent.promotionalBanner?.enabled && (
    <section class="promotional-banner" style="background:var(--burgundy-deep, #460511);color:#fff;padding:16px 0;">
      <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <span style="background:var(--gold-bright, #d4af37);color:#460511;font-weight:700;font-size:11px;padding:3px 8px;border-radius:4px;text-transform:uppercase;">{homepageContent.promotionalBanner.badge}</span>
          <strong>{homepageContent.promotionalBanner.headline}</strong>
          {homepageContent.promotionalBanner.description && <span style="opacity:0.85;font-size:14px;">{homepageContent.promotionalBanner.description}</span>}
        </div>
        <a href={homepageContent.promotionalBanner.ctaUrl} class="btn btn-gold btn-sm">{homepageContent.promotionalBanner.ctaLabel}</a>
      </div>
    </section>
  )}

  {homepageContent.sectionsVisibility.mandaps && (
    <section class="section" aria-labelledby="home-mandaps">
      <div class="container">
        <div class="section-head split-head">
          <div>
            <span class="eyebrow">Mandap collection</span>
            <h2 id="home-mandaps">Ceremony settings with honest dimensions.</h2>
            <p>
              Traditional, floral and contemporary mandaps with clear footprints, material notes and
              custom sizing on request.
            </p>
          </div>
          <a href="/mandaps" class="btn btn-secondary">View all mandaps <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="catalogue-grid catalogue-grid-mandaps">
          {mandaps.map((mandap) => <MandapCard mandap={mandap} />)}
        </div>
      </div>
    </section>
  )}

  {homepageContent.sectionsVisibility.stages && (
    <section class="section section-warm" aria-labelledby="home-stages">
      <div class="container">
        <div class="section-head split-head">
          <div>
            <span class="eyebrow">Stage design studio</span>
            <h2 id="home-stages">Reception stages built for the photograph.</h2>
            <p>
              Royal, Mughal, botanical and LED concepts — each with a standard footprint and styling
              notes you can take to your venue.
            </p>
          </div>
          <a href="/stages" class="btn btn-secondary">Explore stage designs <Icon name="arrow-right" size={15} /></a>
        </div>
        <div class="catalogue-grid catalogue-grid-stages">
          {stages.map((stage) => <StageCard stage={stage} />)}
        </div>
      </div>
    </section>
  )}

  {homepageContent.sectionsVisibility.equipment && (
    <section class="section" aria-labelledby="home-equipment">
      <div class="container">
        <div class="section-head split-head">
          <div>
            <span class="eyebrow">Furniture &amp; equipment</span>
            <h2 id="home-equipment">Build a practical equipment list.</h2>
            <p>
              Six curated categories with quantities, finishes and specifications. Add items directly
              to your requirements and adjust quantities in the planner.
            </p>
          </div>
          <a href="/equipment" class="btn btn-secondary">Browse the catalogue <Icon name="arrow-right" size={15} /></a>
        </div>

        <div class="equipment-preview-grid">
          {equipment.map((category) => (
            <article class="equipment-preview-card">
              <div class="equipment-preview-head">
                <span class="equipment-group-icon"><Icon name={category.icon} size={19} /></span>
                <div>
                  <h3>{category.name}</h3>
                  <p>{category.itemCount} items in catalogue</p>
                </div>
              </div>
              <ul class="equipment-preview-list">
                {category.items.map((item) => (
                  <li>
                    <div>
                      <strong>{item.name}</strong>
                      <small>{item.description}</small>
                    </div>
                    <button
                      type="button"
                      class="preview-add"
                      data-add-equipment
                      data-id={item.id}
                      data-slug={item.slug}
                      data-name={item.name}
                      data-category={category.name}
                      data-category-slug={category.slug}
                      data-unit={item.unit}
                      data-specifications={item.specifications}
                      data-image={item.image ?? ''}
                      data-min={item.min_quantity}
                      data-quantity={item.default_quantity}
                      aria-label={`Add ${item.name} to requirements`}
                    >
                      <Icon name="plus" size={13} /> Add
                    </button>
                  </li>
                ))}
              </ul>
              <a href={`/equipment?category=${category.slug}`} class="text-link">Browse {category.name.toLowerCase()}</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {homepageContent.sectionsVisibility.gallery && (
    <section class="section section-warm" aria-labelledby="home-gallery">
      <div class="container">
        <div class="section-head split-head">
          <div>
            <span class="eyebrow">Photography &amp; gallery</span>
            <h2 id="home-gallery">A closer look at the details.</h2>
            <p>Mandap carvings, stage florals, furniture settings and real celebrations in and around Ranchi.</p>
          </div>
          <a href="/gallery" class="btn btn-secondary">Open full gallery <Icon name="arrow-right" size={15} /></a>
        </div>

        <div class="home-gallery-filters" data-home-gallery-filters aria-label="Filter gallery by category">
          <button type="button" class="filter-btn active" data-home-gallery-filter="all">All photographs</button>
          {galleryCategories.map((category) => (
            <button type="button" class="filter-btn" data-home-gallery-filter={String(category.id)}>{category.name}</button>
          ))}
        </div>

        <div class="gallery-grid home-gallery-grid">
          {galleryItems.map((item) => (
            <button
              type="button"
              class="gallery-tile"
              data-home-gallery-item
              data-home-gallery-category={String(galleryCategories.find((category) => category.slug === item.categorySlug)?.id ?? '')}
              data-lightbox
              data-src={imageUrl(item.image)}
              data-caption={item.title}
            >
              <img src={imageUrl(item.image)} alt={item.title} loading="lazy" />
              <span class="gallery-overlay">
                <span>{item.title}</span>
                <small>{item.category}</small>
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  {featuredVideos.length > 0 && (
    <section class="section section-warm" aria-labelledby="home-videos-heading">
      <div class="container">
        <div class="section-head flex-between" style="align-items: flex-end; margin-bottom: 2rem;">
          <div>
            <span class="eyebrow" style="color:var(--gold-deep);">Motion &amp; Highlights</span>
            <h2 id="home-videos-heading">Celebrations in Motion</h2>
            <p>Watch authentic event walk-throughs, floral mandap setups and festive stage moments.</p>
          </div>
          <a href="/gallery#videosSection" class="btn btn-secondary btn-sm" style="margin-bottom: 0.5rem;">
            Explore all videos <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: start;">
          {featuredVideos.map((video) => (
            <VideoPreviewCard video={video} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-dark" aria-labelledby="home-process">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" style="color:var(--gold-bright);">How it works</span>
        <h2 id="home-process">Five steps, one clear quotation.</h2>
        <p>
          Submitting your requirements sends an enquiry — it is not an automatic confirmation. Our
          team reviews every detail before responding.
        </p>
      </div>
      <div class="process-grid process-grid-5">
        {steps.map(([index, title, description]) => (
          <div class="process-card">
            <span class="step-index">Step {index}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        ))}
      </div>
      <div class="process-notice">
        <Icon name="info" size={17} />
        <span>
          An enquiry does not block your date or reserve equipment. Availability is confirmed only
          after Event Point Ranchi issues a written quotation and you accept it.
        </span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="requirements-cta">
        <div>
          <span class="eyebrow" style="color:var(--gold-bright);">One complete brief</span>
          <h2>Build Your Event Requirements</h2>
          <p>
            Combine your mandap, stage, furniture, equipment, accommodation and styling preferences
            in one guided form. It takes a few minutes and gives our team everything needed to quote.
          </p>
          <div class="cta-contact-line">
            <span><Icon name="phone" size={15} /> {site.phone}</span>
            <span><Icon name="pin" size={15} /> Main Road, Ranchi</span>
          </div>
        </div>
        <div class="requirements-cta-actions">
          <a href="/plan" class="btn btn-gold btn-lg">Plan Your Event <Icon name="arrow-right" size={16} /></a>
          <a href="/contact" class="btn btn-secondary btn-lg">Ask a question</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-home-gallery-filter]'));
    const galleryItems = Array.from(document.querySelectorAll<HTMLElement>('[data-home-gallery-item]'));

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.homeGalleryFilter ?? 'all';
        filterButtons.forEach((entry) => entry.classList.toggle('active', entry === button));
        galleryItems.forEach((item) => {
          item.hidden = filter !== 'all' && item.dataset.homeGalleryCategory !== filter;
        });
      });
    });
  </script>
</BaseLayout>
