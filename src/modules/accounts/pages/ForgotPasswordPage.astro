---
import BaseLayout from '../../../layouts/BaseLayout.astro';

interface Props {
  submitted?: boolean;
}
const { submitted = false } = Astro.props;
const csrf = Astro.locals.csrf;
---
<BaseLayout title="Reset your password | Event Point Ranchi" description="Reset your Event Point Ranchi account password." noCart noDock>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Account recovery</span>
      <h1>Reset your password</h1>
      <p>Enter the email address on your account and we will send you a reset link.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:520px;">
      <div class="panel" style="padding:26px;">
        <div class="publish-notice warn" role="status" style="margin-bottom:18px;">
          <strong>Email delivery is not configured.</strong>
          Password reset emails cannot be sent yet, so this form will not deliver a link.
          Please contact us on +91 98765 43210 or info@eventpointranchi.com and we will verify your account manually.
        </div>

        {submitted && (
          <p class="text-sm" role="status" style="margin-bottom:14px;">
            If an account exists for that address, our team will contact you. For security we do not confirm whether an
            email is registered.
          </p>
        )}

        <form method="POST" action="/forgot-password">
          <input type="hidden" name="_csrf" value={csrf} />
          <div class="field">
            <label for="email">Email address</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
            <button type="submit" class="btn btn-primary">Request reset</button>
            <a href="/login" class="btn btn-ghost">Back to login</a>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
