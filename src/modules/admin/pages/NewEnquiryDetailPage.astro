---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { formatDate, formatDateTime, formatMoney } from '../../../core/http';
import { formatCataloguePrice } from '../../bookings/pricing-core';
import {
  bookingStatusLabel,
  enquiryStatusClass,
  enquiryStatusLabel,
  paymentStatusLabel,
  pricingStatusClass,
  pricingStatusLabel,
  quotationStatusClass,
  quotationStatusLabel,
  summariseEnquiryLines,
} from '../presentation';
import type { loadNewEnquiry } from '../service';
import { getEnquiryQrService } from '../../../core/operational/enquiry-qr-service';
import { getSiteSettings } from '../../../core/content/service';
import { buildEnquiryDocument, buildQuotationDocument } from '../../../core/documents/canonical';
import CanonicalDocument from '../../../components/documents/CanonicalDocument.astro';

interface Props {
  data?: Awaited<ReturnType<typeof loadNewEnquiry>>;
  notFound?: boolean;
}

const { data, notFound = false } = Astro.props;
const csrf = Astro.locals.csrf;

const enquiry = data?.enquiry;
const status = enquiry?.status ?? '';
const hasBooking = Boolean(data?.booking);
const isWorkflowActive = ['new', 'reviewing', 'contacted', 'quoted'].includes(status) && !hasBooking;
const canPrepareQuote = Boolean(enquiry) && !hasBooking && !['rejected', 'archived'].includes(status);
const latestPreparedQuote = data?.latestPreparedQuotation ?? null;
const canAccept =
  Boolean(latestPreparedQuote) && !hasBooking && !['rejected', 'archived'].includes(status);
const canReject =
  Boolean(enquiry) && !hasBooking && !['accepted', 'confirmed', 'rejected', 'archived'].includes(status);
const showActions = isWorkflowActive || canReject;
const selections = summariseEnquiryLines(data?.lines ?? []);

function parseStylingNotes(value: string | null | undefined): Array<{ label: string; value: string }> {
  return String(value || '')
    .split(/\n+/)
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => {
      const match = line.match(/^([^:]{2,40}):\s*(.*)$/);
      return match
        ? { label: match[1].trim(), value: match[2].trim() }
        : { label: 'Special instructions', value: line };
    })
    .filter((note) => note.value);
}

const stylingNotes = parseStylingNotes(enquiry?.decoration_notes);
const customerInitials = String(enquiry?.customer_name || 'Customer')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
const selectionGroups = [
  { label: 'Mandap', icon: 'archway', items: selections.mandap, empty: 'No mandap selected.' },
  { label: 'Stage', icon: 'theater', items: selections.stage, empty: 'No reception stage selected.' },
  { label: 'Furniture & equipment', icon: 'chair', items: selections.furniture, empty: 'No furniture or equipment selected.' },
  { label: 'Catering', icon: 'utensils', items: selections.catering, empty: 'No catering package selected.' },
];

const quoteLinesByEnquiryLine = new Map<number, any>();
for (const line of latestPreparedQuote?.lines ?? []) {
  if (line.enquiry_line_item_id) quoteLinesByEnquiryLine.set(Number(line.enquiry_line_item_id), line);
}
const latestManualLines = (latestPreparedQuote?.lines ?? []).filter((line) => line.line_type === 'manual');
const manualQuoteRows = [...latestManualLines, null, null];
const quoteHistory = data?.quotations ?? [];
const latestQuote = quoteHistory[0] ?? null;
const settings = enquiry ? await getSiteSettings() : null;
const quotationDocument = latestQuote && enquiry && settings
  ? buildQuotationDocument({
      enquiry: {
        reference_code: enquiry.reference_code,
        customer_name: enquiry.customer_name,
        customer_phone: enquiry.customer_phone,
        customer_email: enquiry.customer_email,
        event_type: enquiry.event_type,
        event_date: enquiry.event_date,
        end_date: enquiry.end_date,
        event_time: enquiry.event_time,
        venue_location: enquiry.venue_location,
        guest_count: Number(enquiry.guest_count ?? 0),
        budget_range: enquiry.budget_range,
        requires_rooms: enquiry.requires_rooms,
        room_count: enquiry.room_count,
        preferred_contact: enquiry.preferred_contact,
        additional_services: enquiry.additional_services,
        decoration_notes: enquiry.decoration_notes,
        accommodation_notes: enquiry.accommodation_notes,
        created_at: String(enquiry.created_at),
      },
      quotation: {
        version: latestQuote.quotation.version,
        status: latestQuote.quotation.status,
        total_paise: Number(latestQuote.quotation.total_paise),
        notes: latestQuote.quotation.notes,
        prepared_at: latestQuote.quotation.prepared_at,
        prepared_by_name: latestQuote.preparedByName,
      },
      lines: latestQuote.lines.map((line) => ({
        line_type: line.line_type,
        description: line.description,
        quantity: Number(line.quantity),
        quoted_unit_price_paise: Number(line.quoted_unit_price_paise),
        quoted_subtotal_paise: Number(line.quoted_subtotal_paise),
        notes: line.notes,
      })),
    }, {
      name: settings.name,
      phone: settings.phone,
      email: settings.email,
      address: settings.address,
      website: 'https://eventpointranchi.com',
    })
  : null;

function requestedDimensions(line: {
  requested_length_ft: number | null;
  requested_width_ft: number | null;
  requested_height_ft: number | null;
}): string {
  const values = [line.requested_length_ft, line.requested_width_ft, line.requested_height_ft];
  if (values.every((value) => value === null)) return 'Standard size';
  return `${line.requested_length_ft ?? '—'} × ${line.requested_width_ft ?? '—'} × ${line.requested_height_ft ?? '—'} ft`;
}

let qrPayload: any = null;
if (enquiry) {
  try {
    const qrService = getEnquiryQrService(Astro.url.origin);
    qrPayload = await qrService.getOrCreateEnquiryQr(enquiry.id, enquiry.reference_code, Astro.url.origin);
  } catch (err: any) {
    console.warn('[Enquiry QR error]:', err.message);
  }
}

const enquiryDocument = enquiry && settings
  ? buildEnquiryDocument({
      enquiry: {
        id: enquiry.id,
        referenceCode: enquiry.reference_code,
        customerName: enquiry.customer_name,
        customerPhone: enquiry.customer_phone,
        customerEmail: enquiry.customer_email,
        eventType: enquiry.event_type,
        eventDate: enquiry.event_date,
        endDate: enquiry.end_date,
        eventTime: enquiry.event_time,
        venueLocation: enquiry.venue_location,
        guestCount: Number(enquiry.guest_count ?? 0),
        budgetRange: enquiry.budget_range,
        requiresRooms: Boolean(enquiry.requires_rooms),
        roomCount: Number(enquiry.room_count ?? 0),
        accommodationNotes: enquiry.accommodation_notes || '',
        decorationNotes: enquiry.decoration_notes || '',
        preferredContact: enquiry.preferred_contact || '',
        additionalServices: enquiry.additional_services || '',
        status: enquiry.status,
        createdAt: String(enquiry.created_at),
        items: (data?.lines ?? []).map((line) => ({
          itemType: line.item_type,
          name: line.item_name_snapshot,
          quantity: Number(line.quantity),
          dimensions: line.standard_dimensions_snapshot || undefined,
          requestedDimensions: [line.requested_length_ft, line.requested_width_ft, line.requested_height_ft].some((value) => value !== null)
            ? requestedDimensions(line)
            : undefined,
          specifications: line.specifications || undefined,
          notes: line.notes || undefined,
        })),
      },
      token: '',
      qrDataUrl: qrPayload?.qrDataUrl ?? '',
      verificationUrl: qrPayload?.scanUrl ?? '',
      businessInfo: {
        brandName: settings.name,
        legalName: settings.legalName || settings.name,
        tagline: settings.tagline || '',
        phone: settings.phone,
        email: settings.email,
        address: settings.address,
        website: 'https://eventpointranchi.com',
      },
    })
  : null;
---

{notFound || !data || !enquiry ? (
  <AdminLayout title="Enquiry not found">
    <div class="admin-panel">
      <div class="admin-empty">
        This event enquiry does not exist.{' '}
        <a href="/admin/new-enquiries" style="color:var(--gold-ink);font-weight:600;">Back to New Enquiries</a>
      </div>
    </div>
  </AdminLayout>
) : (
  <AdminLayout
    title={enquiry.reference_code}
    description={`${enquiry.customer_name} · ${enquiry.event_type} · ${formatDate(enquiry.event_date)}`}
  >
    <div class="admin-toolbar">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <a href="/admin/new-enquiries" class="btn btn-secondary btn-sm">← New Enquiries</a>
        <a href="/admin/enquiries/scan" class="btn btn-ghost btn-sm">
          <Icon name="camera" size={13} /> Open Scanner
        </a>
        {data.booking && (
          <a href={`/admin/bookings/${data.booking.id}`} class="btn btn-primary btn-sm">
            <Icon name="ticket" size={13} /> Booking #{data.booking.id}
          </a>
        )}
      </div>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">
          <Icon name="print" size={13} /> Print Enquiry Slip
        </button>
        <span class:list={['badge', enquiryStatusClass(status)]}>{enquiryStatusLabel(status)}</span>
        <span class="text-xs text-muted">Received {formatDateTime(enquiry.created_at)}</span>
      </div>
    </div>

    {data.booking && (
      <div
        class="admin-panel"
        style="margin-bottom:20px;padding:16px 20px;border-left:4px solid var(--success,#2e7d32);display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap;"
      >
        <div>
          <strong style="display:block;color:var(--ink);">Converted to managed booking #{data.booking.id}</strong>
          <span class="text-xs text-muted">
            {bookingStatusLabel(data.booking.status)} · {paymentStatusLabel(data.booking.payment_status)} ·{' '}
            {formatMoney(data.booking.total_amount)}
          </span>
        </div>
        <a href={`/admin/bookings/${data.booking.id}`} class="btn btn-secondary btn-sm">Open booking</a>
      </div>
    )}

    {enquiry.status === 'rejected' && (
      <div class="admin-panel" style="margin-bottom:20px;padding:16px 20px;border-left:4px solid var(--danger,#b23b3b);">
        <strong style="display:block;color:var(--ink);">Enquiry rejected</strong>
        <span class="text-sm">{enquiry.rejection_reason || 'No rejection reason was recorded.'}</span>
      </div>
    )}

    {qrPayload && (
      <div
        class="admin-panel print-receipt-card"
        style="margin-bottom:20px;padding:16px 20px;background:var(--canvas-warm);border:1px solid var(--line);border-radius:var(--r-md);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;"
      >
        <div style="display:flex;align-items:center;gap:16px;">
          <a href={qrPayload.scanUrl} target="_blank" rel="noopener">
            <img
              src={qrPayload.qrDataUrl}
              alt={`QR Code for ${enquiry.reference_code}`}
              style="width:90px;height:90px;border-radius:var(--r-sm);border:1px solid var(--line);background:#fff;padding:3px;"
            />
          </a>
          <div>
            <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--gold-ink);display:block;margin-bottom:2px;">
              Coordinator Dispatch QR Code
            </span>
            <strong style="font-size:15px;color:var(--ink);display:block;margin-bottom:4px;">
              Scan to load enquiry on any mobile device or terminal
            </strong>
            <span style="font-size:12px;color:var(--muted);">
              Reference: <strong style="font-family:var(--font-mono);color:var(--gold-ink);">{enquiry.reference_code}</strong>
              {' · '}
              <a href={qrPayload.scanUrl} class="text-link" target="_blank" rel="noopener">Scan URL</a>
            </span>
          </div>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">
          <Icon name="print" size={14} /> Print Slip
        </button>
      </div>
    )}

    <div class="admin-panel enquiry-overview-panel">
      <div class="admin-panel-head">
        <div>
          <h2>Event &amp; customer overview</h2>
          <p>Essential event, contact and accommodation details.</p>
        </div>
        <span class:list={['badge', enquiryStatusClass(status)]}>{enquiryStatusLabel(status)}</span>
      </div>
      <div class="admin-panel-body">
        <div class="enquiry-overview-hero">
          <div class="enquiry-hero-date">
            <span>Event date</span>
            <strong>{formatDate(enquiry.event_date)}</strong>
            <small>
              {enquiry.event_time || 'Time to confirm'}
              {enquiry.end_date ? ` · ends ${formatDate(enquiry.end_date)}` : ''}
            </small>
          </div>
          <div class="enquiry-fact-grid">
            <div class="enquiry-fact"><span>Event type</span><strong>{enquiry.event_type}</strong></div>
            <div class="enquiry-fact"><span>Guests</span><strong>{enquiry.guest_count}</strong></div>
            <div class="enquiry-fact"><span>Budget range</span><strong>{enquiry.budget_range || 'Not provided'}</strong></div>
            <div class="enquiry-fact"><span>Venue</span><strong>{enquiry.venue_location}</strong></div>
          </div>
        </div>

        <div class="enquiry-overview-detail-grid">
          <div class="enquiry-detail-card">
            <div class="enquiry-detail-head">
              <span class="enquiry-detail-icon"><Icon name="user" size={17} /></span>
              <div><strong>Customer</strong><span>Primary contact</span></div>
            </div>
            <div class="enquiry-customer-line">
              <span class="enquiry-avatar">{customerInitials || 'C'}</span>
              <div>
                <strong>{enquiry.customer_name}</strong>
                <span>Prefers {enquiry.preferred_contact}</span>
              </div>
            </div>
            <div class="enquiry-contact-list">
              <a href={`tel:${enquiry.customer_phone.replace(/\s+/g, '')}`}>
                <Icon name="phone" size={14} /> {enquiry.customer_phone}
              </a>
              {enquiry.customer_email ? (
                <a href={`mailto:${enquiry.customer_email}`}>
                  <Icon name="mail" size={14} /> {enquiry.customer_email}
                </a>
              ) : (
                <span><Icon name="mail" size={14} /> No email provided</span>
              )}
            </div>
          </div>

          <div class="enquiry-detail-card">
            <div class="enquiry-detail-head">
              <span class="enquiry-detail-icon"><Icon name="bed" size={17} /></span>
              <div><strong>Accommodation</strong><span>Guest stay requirements</span></div>
            </div>
            <div class="enquiry-accommodation-state">
              <strong>{enquiry.requires_rooms ? `${enquiry.room_count} room${Number(enquiry.room_count) === 1 ? '' : 's'} requested` : 'Self-arranged stay'}</strong>
              <span>{enquiry.requires_rooms ? 'Hotel coordination requested' : 'No room block required'}</span>
            </div>
            <p class="enquiry-detail-note">{enquiry.accommodation_notes || 'No accommodation notes were provided.'}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="admin-panel">
      <div class="admin-panel-head">
        <div><h2>Selected requirements</h2><p>Itemised catalogue selections from the enquiry.</p></div>
        <span class="badge badge-muted">{data.lines.length} line{data.lines.length === 1 ? '' : 's'}</span>
      </div>
      <div class="admin-panel-body">
        <div class="selection-overview-grid">
          {selectionGroups.map((group) => (
            <div class:list={['selection-overview-card', { 'is-empty': group.items.length === 0 }]}>
              <div class="selection-overview-head">
                <span class="selection-overview-icon"><Icon name={group.icon} size={17} /></span>
                <div>
                  <span>{group.label}</span>
                  <strong>{group.items.length > 0 ? `${group.items.length} selected` : 'Not selected'}</strong>
                </div>
              </div>
              {group.items.length > 0 ? (
                <div class="selection-overview-items">
                  {group.items.map((item) => <span>{item}</span>)}
                </div>
              ) : (
                <p>{group.empty}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="admin-panel">
      <div class="admin-panel-head">
        <div><h2>Requirement line items</h2><p>{data.lines.length} item{data.lines.length === 1 ? '' : 's'} submitted.</p></div>
        <span class="badge badge-muted">Catalogue snapshot</span>
      </div>
      <div class="admin-panel-body">
        {data.lines.length === 0 ? (
          <div class="admin-empty">No catalogue line items submitted.</div>
        ) : (
          <div class="requirement-line-grid">
            {data.lines.map((line, index) => (
              <div class="requirement-line-card">
                <div class="requirement-line-head">
                  <span class="requirement-line-index">{String(index + 1).padStart(2, '0')}</span>
                  <div class="requirement-line-title">
                    <strong>{line.item_name_snapshot}</strong>
                    <div>
                      <span class="badge badge-muted">{line.item_type}</span>
                      <span class:list={['badge', line.pricing_status === 'priced' ? 'badge-success' : 'badge-gold']}>
                        {line.pricing_status === 'priced' ? 'Priced' : 'On request'}
                      </span>
                      {line.catalogue_item_id && <span class="requirement-catalog-id">Catalogue #{line.catalogue_item_id}</span>}
                    </div>
                  </div>
                  <div class="requirement-line-total">
                    <span>{line.pricing_status === 'priced' ? 'Catalogue subtotal' : 'Pricing'}</span>
                    <strong>{line.pricing_status === 'priced' ? formatMoney(line.catalogue_subtotal_paise ?? 0) : 'On request'}</strong>
                  </div>
                </div>

                <div class="requirement-line-metrics">
                  <div><span>Quantity</span><strong>{line.quantity}</strong></div>
                  <div><span>Catalogue unit</span><strong>{formatCataloguePrice(line.catalogue_unit_price_paise)}</strong></div>
                  <div><span>Catalogue subtotal</span><strong>{formatMoney(line.catalogue_subtotal_paise ?? 0)}</strong></div>
                </div>

                <div class="requirement-line-details">
                  <div><span>Standard dimensions</span><p>{line.standard_dimensions_snapshot || '—'}</p></div>
                  <div><span>Requested dimensions</span><p>{requestedDimensions(line)}</p></div>
                  <div class="is-wide">
                    <span>Specifications &amp; notes</span>
                    <p>
                      {line.specifications || line.notes
                        ? [line.specifications, line.notes].filter(Boolean).join(' · ')
                        : 'No additional specifications.'}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="admin-grid-2 enquiry-insight-grid">
      <div class="admin-panel enquiry-notes-card">
        <div class="admin-panel-head">
          <div>
            <h2>Styling &amp; event notes</h2>
            <p>Design direction and special requests shared by the customer.</p>
          </div>
          <span class="badge badge-muted">{stylingNotes.length} note{stylingNotes.length === 1 ? '' : 's'}</span>
        </div>
        <div class="admin-panel-body">
          {stylingNotes.length > 0 ? (
            <div class="enquiry-note-list">
              {stylingNotes.map((note) => (
                <div class="enquiry-note-item">
                  <span class="enquiry-note-label">{note.label}</span>
                  <p>{note.value}</p>
                </div>
              ))}
            </div>
          ) : (
            <div class="admin-empty enquiry-empty-note">No styling notes were provided.</div>
          )}
        </div>
      </div>

      <div class="admin-panel enquiry-commercial-card">
        <div class="admin-panel-head">
          <div>
            <h2>Pricing &amp; admin handling</h2>
            <p>Commercial snapshot and booking state.</p>
          </div>
          <span class:list={['badge', pricingStatusClass(enquiry.pricing_status)]}>
            {pricingStatusLabel(enquiry.pricing_status)}
          </span>
        </div>
        <div class="admin-panel-body">
          <div class="enquiry-metric-grid">
            <div class="enquiry-metric">
              <span>Priced subtotal</span>
              <strong>{formatMoney(enquiry.priced_subtotal_paise ?? 0)}</strong>
            </div>
            <div class="enquiry-metric">
              <span>Customer budget</span>
              <strong>{enquiry.budget_range || 'Not provided'}</strong>
            </div>
            <div class="enquiry-metric">
              <span>Booking record</span>
              <strong>{data.booking ? `#${data.booking.id}` : 'Not created'}</strong>
            </div>
            <div class="enquiry-metric">
              <span>Enquiry status</span>
              <strong>{enquiryStatusLabel(enquiry.status)}</strong>
            </div>
          </div>

          {enquiry.additional_services && (
            <div class="enquiry-note-item enquiry-services-note">
              <span class="enquiry-note-label">Additional services requested</span>
              <p>{enquiry.additional_services}</p>
            </div>
          )}

          {data.booking ? (
            <div class="enquiry-booking-strip">
              <div>
                <span>Final booking amount</span>
                <strong>{formatMoney(data.booking.total_amount)}</strong>
              </div>
              <span class="badge badge-success">
                {bookingStatusLabel(data.booking.status)} · {paymentStatusLabel(data.booking.payment_status)}
              </span>
            </div>
          ) : (
            <div class="enquiry-quiet-note">
              <Icon name="info" size={15} />
              <span>No amount has been charged. Accept an itemised quotation to create the booking.</span>
            </div>
          )}

          {enquiry.accepted_at && (
            <div class="enquiry-commercial-foot">
              <span>Accepted {formatDateTime(enquiry.accepted_at)}</span>
              {data.acceptedBy && <span>by {data.acceptedBy}</span>}
            </div>
          )}

          {enquiry.status === 'rejected' && (
            <div class="enquiry-note-item enquiry-rejection-note">
              <span class="enquiry-note-label">Rejection reason</span>
              <p>{enquiry.rejection_reason || 'No reason recorded'}</p>
            </div>
          )}
        </div>
      </div>
    </div>

    {canPrepareQuote && (
      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>{latestPreparedQuote ? 'Edit quotation' : 'Prepare quotation'}</h2>
            <p>
              Catalogue prices are preserved on the original selections. Enter the agreed price for each line;
              every line is required. Saving creates a new version and recalculates the total on the server.
            </p>
          </div>
          {latestPreparedQuote && (
            <span class:list={['badge', quotationStatusClass(latestPreparedQuote.quotation.status)]}>
              Version {latestPreparedQuote.quotation.version} · {quotationStatusLabel(latestPreparedQuote.quotation.status)}
            </span>
          )}
        </div>
        <div class="admin-panel-body">
          <form method="POST" action={`/admin/new-enquiries/${enquiry.id}`}>
            <input type="hidden" name="_csrf" value={csrf} />
            <input type="hidden" name="action" value="save_quotation" />
            <div class="quote-lines-editor">
              {data.lines.map((line, index) => {
                const quoteLine = quoteLinesByEnquiryLine.get(Number(line.id));
                const agreed = quoteLine
                  ? Number(quoteLine.quoted_unit_price_paise) / 100
                  : line.catalogue_unit_price_paise && line.catalogue_unit_price_paise > 0
                    ? Number(line.catalogue_unit_price_paise) / 100
                    : '';
                const savedSubtotal = quoteLine
                  ? Number(quoteLine.quoted_subtotal_paise ?? 0)
                  : Number(line.catalogue_subtotal_paise ?? 0);
                return (
                  <div class="quote-line-card">
                    <div class="quote-line-number">{String(index + 1).padStart(2, '0')}</div>
                    <div class="quote-line-main">
                      <div class="quote-line-title">
                        <strong>{line.item_name_snapshot}</strong>
                        <span class:list={['badge', line.pricing_status === 'priced' ? 'badge-success' : 'badge-gold']}>
                          {line.pricing_status === 'priced' ? 'Priced' : 'On request'}
                        </span>
                      </div>
                      <div class="quote-line-meta">
                        <span>{line.item_type}</span>
                        <span>Catalogue #{line.catalogue_item_id ?? '—'}</span>
                        <span>{line.standard_dimensions_snapshot || 'Standard dimensions'}</span>
                      </div>
                      {(quoteLine?.notes || line.notes) && (
                        <p class="quote-line-note">{quoteLine?.notes || line.notes}</p>
                      )}
                    </div>

                    <div class="quote-line-fields">
                      <label class="quote-field">
                        <span>Quantity</span>
                        <input
                          class="input"
                          name="line_quantity"
                          type="number"
                          min="1"
                          step="1"
                          value={quoteLine?.quantity ?? line.quantity}
                          required
                        />
                      </label>
                      <label class="quote-field">
                        <span>Agreed unit price</span>
                        <div class="quote-price-input">
                          <span>₹</span>
                          <input
                            class="input"
                            name="line_price"
                            type="number"
                            min="0.01"
                            step="0.01"
                            value={agreed === '' ? '' : Number(agreed).toFixed(2)}
                            placeholder={line.pricing_status === 'on_request' ? 'Enter agreed price' : ''}
                            required
                          />
                        </div>
                      </label>
                    </div>

                    <div class="quote-line-pricing">
                      <span class="quote-line-catalog">
                        Catalogue <strong>{formatCataloguePrice(line.catalogue_unit_price_paise)}</strong>
                      </span>
                      <span class="quote-line-saved">
                        {quoteLine ? 'Saved total' : 'Catalogue subtotal'}
                        <strong>{savedSubtotal > 0 ? formatMoney(savedSubtotal) : 'On request'}</strong>
                      </span>
                    </div>

                    <input type="hidden" name="line_id" value={line.id} />
                    <input type="hidden" name="line_notes" value={quoteLine?.notes ?? ''} />
                  </div>
                );
              })}
            </div>
            <p class="quote-editor-hint">
              <Icon name="info" size={14} />
              Saved totals are recalculated on the server from the agreed unit price and quantity.
            </p>

            <div class="admin-panel-body">
              <h3 style="margin:18px 0 10px;font-size:1rem;">Manual quotation lines</h3>
              <p class="text-sm text-muted" style="margin-bottom:12px;">
                Add any service or package that is not in the catalogue. Manual lines are clearly identified
                on the quotation and booking.
              </p>
              <div class="table-wrap">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Description</th>
                      <th>Quantity</th>
                      <th>Agreed unit price (₹)</th>
                      <th>Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                    {manualQuoteRows.map((manualLine) => (
                      <tr>
                        <td>
                          <input
                            class="input"
                            name="manual_description"
                            type="text"
                            value={manualLine?.description ?? ''}
                            placeholder="Additional service"
                            maxlength="255"
                          />
                        </td>
                        <td>
                          <input
                            class="input"
                            name="manual_quantity"
                            type="number"
                            min="1"
                            step="1"
                            value={manualLine?.quantity ?? 1}
                            style="min-width:90px;"
                          />
                        </td>
                        <td>
                          <input
                            class="input"
                            name="manual_price"
                            type="number"
                            min="0.01"
                            step="0.01"
                            value={manualLine ? (Number(manualLine.quoted_unit_price_paise) / 100).toFixed(2) : ''}
                            placeholder="0.00"
                            style="min-width:150px;"
                          />
                        </td>
                        <td>
                          <input
                            class="input"
                            name="manual_notes"
                            type="text"
                            value={manualLine?.notes ?? ''}
                            maxlength="1000"
                          />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div class="field" style="margin-top:16px;">
                <label for="quote_notes">Quotation notes <span class="label-optional">(optional)</span></label>
                <textarea class="input" id="quote_notes" name="quote_notes" rows="2" maxlength="2000">
                  {latestPreparedQuote?.quotation.notes ?? ''}
                </textarea>
              </div>
              <button type="submit" class="btn btn-primary" data-confirm="Save a new quotation version?">
                {latestPreparedQuote ? 'Save revised quotation' : 'Prepare quotation'}
              </button>
            </div>
          </form>
        </div>
      </div>
    )}

    {!latestQuote && enquiryDocument && (
      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Canonical enquiry slip</h2>
            <p>The same document the customer receives, views, and prints.</p>
          </div>
          <a href={`/receipts/enquiry/${enquiry.reference_code}`} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
            Open customer slip
          </a>
        </div>
        <div class="admin-panel-body">
          <CanonicalDocument
            document={enquiryDocument}
            qrDataUrl={qrPayload?.qrDataUrl}
            verificationUrl={qrPayload?.scanUrl}
          />
        </div>
      </div>
    )}

    {latestQuote && (
      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Canonical quotation document</h2>
            <p>
              Version {latestQuote.quotation.version} · {quotationStatusLabel(latestQuote.quotation.status)}
              {latestQuote.preparedByName ? ` · Prepared by ${latestQuote.preparedByName}` : ''}
              {latestQuote.quotation.prepared_at ? ` · ${formatDateTime(latestQuote.quotation.prepared_at)}` : ''}
            </p>
          </div>
          <strong class="money" style="font-size:1.1rem;">{formatMoney(latestQuote.quotation.total_paise)}</strong>
        </div>
        <div class="admin-panel-body">
          {quotationDocument ? (
            <CanonicalDocument document={quotationDocument} />
          ) : (
            <div class="admin-empty">The canonical quotation document could not be prepared.</div>
          )}
        </div>
        {latestPreparedQuote?.quotation.id === latestQuote.quotation.id && canAccept && (
          <div class="admin-panel-body" style="border-top:1px solid var(--line);">
            <form method="POST" action={`/admin/new-enquiries/${enquiry.id}`} class="form-grid">
              <input type="hidden" name="_csrf" value={csrf} />
              <input type="hidden" name="action" value="accept" />
              <input type="hidden" name="quotation_id" value={latestPreparedQuote.quotation.id} />
              <label class="checkbox-row" style="display:flex;gap:10px;align-items:flex-start;">
                <input type="checkbox" name="confirm_quotation" value="on" required />
                <span>
                  I confirm this itemised quotation and agree that accepting it creates one managed booking for{' '}
                  <strong>{formatMoney(latestPreparedQuote.quotation.total_paise)}</strong>.
                </span>
              </label>
              <button type="submit" class="btn btn-primary" data-confirm="Accept this quotation and create one booking?">
                Accept quotation &amp; create booking
              </button>
            </form>
          </div>
        )}
      </div>
    )}

    {quoteHistory.length > 1 && (
      <div class="admin-panel">
        <div class="admin-panel-head"><div><h2>Quotation history</h2><p>Every prepared version is retained for audit.</p></div></div>
        <div class="admin-panel-body flush">
          <div class="table-wrap">
            <table class="table table-stack">
              <thead>
                <tr><th>Version</th><th>Status</th><th>Prepared by</th><th>Prepared</th><th>Total</th></tr>
              </thead>
              <tbody>
                {quoteHistory.map((entry) => (
                  <tr>
                    <td data-label="Version">#{entry.quotation.version}</td>
                    <td data-label="Status">
                      <span class:list={['badge', quotationStatusClass(entry.quotation.status)]}>
                        {quotationStatusLabel(entry.quotation.status)}
                      </span>
                    </td>
                    <td data-label="Prepared by">{entry.preparedByName || '—'}</td>
                    <td data-label="Prepared">{formatDateTime(entry.quotation.prepared_at)}</td>
                    <td data-label="Total" class="money">{formatMoney(entry.quotation.total_paise)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    {showActions && (
      <div class="admin-panel workflow-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Workflow actions</h2>
            <p>Move the enquiry through review without creating a booking.</p>
          </div>
          <span class:list={['badge', enquiryStatusClass(status)]}>{enquiryStatusLabel(status)}</span>
        </div>
        <div class="admin-panel-body">
          <div class="workflow-safety-note">
            <Icon name="shield" size={16} />
            <span>These actions update the enquiry record only. A booking is created solely by accepting a prepared quotation.</span>
          </div>

          {isWorkflowActive && (
            <div class="workflow-action-grid">
              {status !== 'reviewing' && (
                <form method="POST" action={`/admin/new-enquiries/${enquiry.id}`} class="workflow-action-card">
                  <input type="hidden" name="_csrf" value={csrf} />
                  <input type="hidden" name="action" value="mark_reviewing" />
                  <button type="submit">
                    <span class="workflow-action-icon"><Icon name="clock" size={18} /></span>
                    <span class="workflow-action-copy">
                      <strong>Mark under review</strong>
                      <small>Begin checking inventory, dimensions and date availability.</small>
                    </span>
                    <Icon name="arrow-right" size={16} />
                  </button>
                </form>
              )}
              {status !== 'contacted' && (
                <form method="POST" action={`/admin/new-enquiries/${enquiry.id}`} class="workflow-action-card">
                  <input type="hidden" name="_csrf" value={csrf} />
                  <input type="hidden" name="action" value="mark_contacted" />
                  <button type="submit">
                    <span class="workflow-action-icon"><Icon name="phone" size={18} /></span>
                    <span class="workflow-action-copy">
                      <strong>Mark contacted</strong>
                      <small>Record that the customer conversation has taken place.</small>
                    </span>
                    <Icon name="arrow-right" size={16} />
                  </button>
                </form>
              )}
            </div>
          )}

          {canReject && (
            <form method="POST" action={`/admin/new-enquiries/${enquiry.id}`} class="workflow-reject-card">
              <input type="hidden" name="_csrf" value={csrf} />
              <input type="hidden" name="action" value="reject" />
              <div class="workflow-reject-head">
                <span class="workflow-action-icon is-danger"><Icon name="x-circle" size={18} /></span>
                <div>
                  <strong>Reject enquiry</strong>
                  <small>Moves this enquiry to rejected history. No booking will be created.</small>
                </div>
              </div>
              <div class="field">
                <label for="reason">Rejection reason <span class="label-optional">(optional)</span></label>
                <textarea
                  class="input"
                  id="reason"
                  name="reason"
                  rows="3"
                  maxlength="1000"
                  placeholder="Why is this enquiry not proceeding?"
                ></textarea>
              </div>
              <button
                type="submit"
                class="btn btn-danger-soft"
                data-confirm="Reject this enquiry? It will move to rejected history and will not create a booking."
              >
                Reject enquiry
              </button>
            </form>
          )}
        </div>
      </div>
    )}
  </AdminLayout>
)}
