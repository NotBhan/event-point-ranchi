---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ImageUploadDropzone from '../../../components/admin/ImageUploadDropzone.astro';

interface Props {
  room: Record<string, unknown> | null;
  features: string[];
  id: number | null;
}

const { room, features, id } = Astro.props;
const csrf = Astro.locals.csrf;

const value = (key: string, fallback = '') => String(room?.[key] ?? fallback);
const n = (key: string, fallback = 0) => Number(room?.[key] ?? fallback);
const isActive = room ? Boolean(Number(room.is_active)) : true;
const priceRupees = room ? (n('price_paise') / 100).toString() : '';
---

<AdminLayout title={id ? `Edit ${value('name', 'room')}` : 'Add a room type'}>
  <div class="admin-toolbar">
    <a href="/admin/rooms" class="btn btn-secondary btn-sm">← All rooms</a>
  </div>

  <form method="POST" action={id ? `/admin/rooms/${id}` : '/admin/rooms/new'} class="admin-grid-3" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value={csrf} />

    <div class="admin-panel" style="grid-column: span 2;">
      <div class="admin-panel-head"><div><h2>Room details</h2></div></div>
      <div class="admin-panel-body">
        <div class="admin-form-grid">
          <div class="field">
            <label for="name">Room name *</label>
            <input class="input" id="name" name="name" required value={value('name')} placeholder="Presidential Luxury Suite" />
          </div>

          <div class="field">
            <label for="description">Description</label>
            <textarea class="textarea" id="description" name="description" rows="3">{value('description')}</textarea>
          </div>

          <div class="admin-form-grid" style="grid-template-columns:repeat(3,1fr);">
            <div class="field">
              <label for="price">Price per night (₹) *</label>
              <input class="input" id="price" name="price" required value={priceRupees} placeholder="12000" inputmode="decimal" />
            </div>
            <div class="field">
              <label for="capacity">Sleeps (guests)</label>
              <input class="input" id="capacity" name="capacity" type="number" min="1" value={n('capacity', 1)} />
            </div>
            <div class="field">
              <label for="total_rooms">Rooms in category</label>
              <input class="input" id="total_rooms" name="total_rooms" type="number" min="1" value={n('total_rooms', 1)} />
            </div>
          </div>

          <div class="field">
            <label for="features">Feature list (one per line)</label>
            <textarea class="textarea" id="features" name="features" rows="6" placeholder="King Size Plush Bed&#10;Jacuzzi &amp; Designer Bath&#10;Private Scenic Balcony">{features.join('\n')}</textarea>
          </div>
        </div>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:20px;">
      <div class="admin-panel">
        <div class="admin-panel-head"><div><h2>Photo</h2></div></div>
        <div class="admin-panel-body">
          <ImageUploadDropzone
            name="image"
            id="image"
            label="Room photo"
            currentImage={value('image') || null}
            fallbackName="image_path"
            hint="Upload replaces the current photo."
            aspectHeight="140px"
          />
        </div>
      </div>

      <div class="admin-panel">
        <div class="admin-panel-body">
          <label class="switch"><input type="checkbox" name="is_active" checked={isActive} /> Published on the website</label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block">{id ? 'Save changes' : 'Create room type'}</button>

      {id && (
        <form method="POST" action={`/admin/rooms/${id}/delete`}>
          <input type="hidden" name="_csrf" value={csrf} />
          <button type="submit" class="btn btn-danger-soft btn-block" data-confirm="Delete this room type?">Delete room type</button>
        </form>
      )}
    </div>
  </form>
</AdminLayout>
