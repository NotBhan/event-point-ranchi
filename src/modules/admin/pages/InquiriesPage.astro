---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPager from '../../../components/admin/AdminPager.astro';
import Icon from '../../../components/Icon.astro';
import { formatDate, formatDateTime } from '../../../core/http';
import type { listInquiries } from '../service';

interface Props {
  items: Awaited<ReturnType<typeof listInquiries>>['items'];
  pagination: Awaited<ReturnType<typeof listInquiries>>['pagination'];
  status: string;
}

const { items: inquiries, pagination, status } = Astro.props;
const csrf = Astro.locals.csrf;
const pageHref = (page: number) => `/admin/inquiries?status=${encodeURIComponent(status)}&page=${page}`;

const statusClass: Record<string, string> = {
  new: 'badge-warning',
  contacted: 'badge-info',
  closed: 'badge-muted',
};

const tabs = [
  ['all', 'All'],
  ['new', 'New'],
  ['contacted', 'Contacted'],
  ['closed', 'Closed'],
];

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}
---

<AdminLayout title="Contact Messages" description={`${inquiries.length} message${inquiries.length === 1 ? '' : 's'} from the website contact form.`}>
  <div class="admin-panel">
    <div class="admin-panel-head">
      <div><h2>Contact messages</h2><p>Messages from the website contact form, separate from event enquiries. Call customers, then mark them contacted or closed.</p></div>
      <div class="admin-subnav">
        {tabs.map(([value, label]) => (
          <a href={`/admin/inquiries?status=${value}`} class:list={{ active: status === value }}>{label}</a>
        ))}
      </div>
    </div>

    <div class="admin-panel-body">
      {inquiries.length === 0 ? (
        <div class="admin-empty">No contact messages in this view.</div>
      ) : (
        <div class="inquiry-card-grid">
          {inquiries.map((inquiry) => (
            <article class="inquiry-card">
              <div class="inquiry-card-head">
                <span class="inquiry-avatar">{initials(inquiry.name)}</span>
                <div class="inquiry-identity">
                  <strong>{inquiry.name}</strong>
                  <a href={`tel:${inquiry.phone.replace(/\s+/g, '')}`}>{inquiry.phone}</a>
                  {inquiry.email && <a href={`mailto:${inquiry.email}`}>{inquiry.email}</a>}
                </div>
                <span class:list={['badge', statusClass[inquiry.status] ?? 'badge-muted']}>{inquiry.status}</span>
              </div>

              <div class="inquiry-meta-row">
                <span><Icon name="clock" size={13} /> {formatDateTime(inquiry.created_at)}</span>
                {inquiry.event_type && <span><Icon name="calendar" size={13} /> {inquiry.event_type}{inquiry.event_date ? ` · ${formatDate(inquiry.event_date)}` : ''}</span>}
                {inquiry.guest_count ? <span><Icon name="users" size={13} /> {inquiry.guest_count} guests</span> : null}
              </div>

              <p class="inquiry-message">{inquiry.message || 'No message body provided.'}</p>

              <div class="inquiry-actions">
                <form method="POST" action={`/admin/inquiries?status=${status}`} class="inquiry-status-form">
                  <input type="hidden" name="_csrf" value={csrf} />
                  <input type="hidden" name="action" value="update_status" />
                  <input type="hidden" name="id" value={inquiry.id} />
                  <label>
                    <span>Status</span>
                    <select class="select" name="status" data-auto-submit>
                      {['new', 'contacted', 'closed'].map((value) => (
                        <option value={value} selected={inquiry.status === value}>{value}</option>
                      ))}
                    </select>
                  </label>
                </form>
                <form method="POST" action={`/admin/inquiries?status=${status}`}>
                  <input type="hidden" name="_csrf" value={csrf} />
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={inquiry.id} />
                  <button type="submit" class="btn btn-ghost btn-sm inquiry-delete" data-confirm="Delete this inquiry?">
                    <Icon name="trash" size={14} /> Delete
                  </button>
                </form>
              </div>
            </article>
          ))}
        </div>
      )}
      {inquiries.length > 0 && (
        <AdminPager
          page={pagination.page}
          totalPages={pagination.totalPages}
          totalCount={pagination.totalCount}
          startItem={pagination.startItem}
          endItem={pagination.endItem}
          label="inquiries"
          href={pageHref}
        />
      )}
    </div>
  </div>
</AdminLayout>
