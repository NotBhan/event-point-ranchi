---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatMoney, imageUrl } from '../../../core/http';
import type { listRoomsAdmin } from '../service';

interface Props {
  rooms: ReturnType<typeof listRoomsAdmin>;
}

const { rooms } = Astro.props;
const csrf = Astro.locals.csrf;
---

<AdminLayout title="Rooms & suites" description={`${rooms.length} room categories.`}>
  <div class="admin-panel">
    <div class="admin-panel-head">
      <div>
        <h2>Room categories</h2>
        <p>Pricing is per night and multiplied by the rooms guests reserve.</p>
      </div>
      <a href="/admin/rooms/new" class="btn btn-primary btn-sm">Add room type</a>
    </div>

    <div class="admin-panel-body flush">
      {rooms.length === 0 ? (
        <div class="admin-empty">No rooms yet. <a href="/admin/rooms/new" style="color:var(--gold-ink);font-weight:600;">Add the first room type</a>.</div>
      ) : (
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Room</th>
                <th>Capacity</th>
                <th>Inventory</th>
                <th>Price / night</th>
                <th>Status</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              {rooms.map((room) => (
                <tr>
                  <td>
                    <div style="display:flex;align-items:center;gap:12px;">
                      {room.image ? (
                        <img class="admin-thumb" src={imageUrl(room.image)} alt="" />
                      ) : (
                        <span class="admin-thumb" style="display:flex;align-items:center;justify-content:center;color:var(--muted);">—</span>
                      )}
                      <a href={`/admin/rooms/${room.id}`} style="font-weight:600;color:var(--ink);">{room.name}</a>
                    </div>
                  </td>
                  <td>{room.capacity} guests</td>
                  <td>{room.total_rooms} rooms</td>
                  <td class="money">{formatMoney(room.price_paise)}</td>
                  <td><span class:list={['badge', room.is_active ? 'badge-success' : 'badge-muted']}>{room.is_active ? 'live' : 'hidden'}</span></td>
                  <td>
                    <div class="admin-row-actions">
                      <a href={`/admin/rooms/${room.id}`} class="btn btn-secondary btn-sm">Edit</a>
                      <form method="POST" action={`/admin/rooms/${room.id}/toggle`}>
                        <input type="hidden" name="_csrf" value={csrf} />
                        <button type="submit" class="btn btn-secondary btn-sm">{room.is_active ? 'Hide' : 'Publish'}</button>
                      </form>
                      <form method="POST" action={`/admin/rooms/${room.id}/delete`}>
                        <input type="hidden" name="_csrf" value={csrf} />
                        <button type="submit" class="icon-btn danger" data-confirm={`Delete "${room.name}"?`} aria-label="Delete room">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
