---
import Icon from '../../../components/Icon.astro';
import '../../../styles/tokens.css';
import '../../../styles/base.css';
import '../../../styles/components.css';
import '../../../styles/admin.css';

interface Props {
  error: string | null;
  next: string;
}

const { error, next } = Astro.props;
const csrf = Astro.locals.csrf;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin login · Royal Palace</title>
    <link rel="icon" type="image/png" href="/images/logo1.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <section class="auth-page" style="min-height:100vh;">
      <div class="auth-card">
        <div class="auth-head">
          <div class="flex-center" style="margin-bottom:14px;">
            <img src="/images/logo1.png" alt="Royal Palace" style="height:44px;width:auto;border-radius:6px;" />
          </div>
          <span class="eyebrow" style="display:flex;justify-content:center;">Staff console</span>
          <h1 style="text-align:center;">Admin sign in</h1>
          <p style="text-align:center;">Manage bookings, venues, menus and site content.</p>
        </div>

        {error && (
          <div class="alert alert-error mb-6">
            <Icon name="alert" size={16} />
            <span>{error}</span>
          </div>
        )}

        <form method="POST" action="/admin/login" class="form-grid">
          <input type="hidden" name="_csrf" value={csrf} />
          <input type="hidden" name="next" value={next} />

          <div class="field">
            <label for="username">Username</label>
            <input class="input" id="username" name="username" required autofocus placeholder="admin" />
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input class="input" id="password" name="password" type="password" required placeholder="••••••••" />
          </div>

          <button type="submit" class="btn btn-primary btn-lg btn-block">Sign in to console</button>
        </form>

        <p class="auth-foot">
          <a href="/">← Back to website</a>
        </p>
      </div>
    </section>
  </body>
</html>
