---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';

interface Props {
  initialToken?: string;
}

const { initialToken = '' } = Astro.props;
---

<AdminLayout title="Enquiry QR Scanner" description="Instant smartphone & webcam QR decoder for customer event enquiries.">
  <div class="admin-toolbar">
    <a href="/admin/enquiries" class="btn btn-secondary btn-sm">← All event enquiries</a>
    <span class="text-xs text-muted">Admin Quick Dispatch Desk</span>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));gap:24px;align-items:start;">
    
    <!-- Left Column: Camera Scanner & Inputs -->
    <div class="admin-panel">
      <div class="admin-panel-head">
        <div>
          <h2>QR Code Scanner</h2>
          <p>Scan an enquiry QR code from a customer slip or screen.</p>
        </div>
        <span id="cameraStatusBadge" class="badge badge-muted">Camera Idle</span>
      </div>

      <div class="admin-panel-body">
        <!-- Live Video Viewport -->
        <div style="position:relative;width:100%;aspect-ratio:4/3;background:#0f172a;border-radius:var(--r-md);overflow:hidden;margin-bottom:16px;display:flex;align-items:center;justify-content:center;">
          <video id="scannerVideo" playsinline style="width:100%;height:100%;object-fit:cover;display:none;"></video>
          <canvas id="scannerCanvas" style="display:none;"></canvas>

          <!-- Idle / Placeholder Screen -->
          <div id="scannerPlaceholder" style="text-align:center;color:#94a3b8;padding:20px;">
            <div style="width:52px;height:52px;border-radius:50%;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:#cbd5e1;">
              <Icon name="camera" size={28} />
            </div>
            <strong style="display:block;color:#f8fafc;font-size:14px;margin-bottom:4px;">Camera is Paused</strong>
            <span style="font-size:12px;">Click "Start Camera" below to activate live scanning</span>
          </div>

          <!-- Aiming Reticle (Visible when scanning) -->
          <div id="scannerReticle" style="display:none;position:absolute;width:60%;aspect-ratio:1/1;border:2px dashed #c8a251;border-radius:12px;box-shadow:0 0 0 9999px rgba(0,0,0,0.45);pointer-events:none;">
            <div style="position:absolute;top:0;left:0;right:0;height:2px;background:#c8a251;animation:scanLine 2s infinite ease-in-out;"></div>
          </div>
        </div>

        <!-- Camera Controls -->
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;">
          <button type="button" id="startCamBtn" class="btn btn-primary btn-sm">
            <Icon name="camera" size={14} /> Start Camera
          </button>
          <button type="button" id="stopCamBtn" class="btn btn-secondary btn-sm" disabled>
            <Icon name="x" size={14} /> Stop Camera
          </button>
          <button type="button" id="flipCamBtn" class="btn btn-ghost btn-sm" disabled>
            Flip Camera
          </button>
        </div>

        <!-- Camera Permission Error Alert -->
        <div id="camAlert" class="alert alert-danger" style="display:none;margin-bottom:18px;font-size:13px;"></div>

        <!-- Alternative: Image File Upload -->
        <div style="border-top:1px solid var(--line);padding-top:18px;margin-bottom:20px;">
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:8px;color:var(--ink-2);">
            Or Upload Screenshot / Image of QR:
          </label>
          <input type="file" id="qrFileInput" accept="image/*" class="input" style="padding:8px 12px;font-size:13px;" />
        </div>

        <!-- Alternative: Manual Reference Search -->
        <div style="border-top:1px solid var(--line);padding-top:18px;">
          <label for="manualInput" style="display:block;font-size:13px;font-weight:600;margin-bottom:8px;color:var(--ink-2);">
            Or Enter Reference Code Manually:
          </label>
          <div style="display:flex;gap:8px;">
            <input
              type="text"
              id="manualInput"
              class="input"
              value={initialToken}
              placeholder="e.g. EP-261030-XXXX or Token"
              style="font-family:var(--font-mono);font-size:13px;"
            />
            <button type="button" id="manualSearchBtn" class="btn btn-secondary">
              <Icon name="search" size={14} /> Search
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Instant Enquiry Details -->
    <div class="admin-panel" id="resultContainer">
      <div class="admin-panel-head">
        <div>
          <h2>Enquiry Details</h2>
          <p>Scan a code to instantly retrieve customer and event blueprint.</p>
        </div>
        <span id="resultStatusBadge" class="badge badge-muted">Awaiting Scan</span>
      </div>

      <div class="admin-panel-body" id="resultBody">
        <div style="text-align:center;padding:40px 20px;color:var(--muted);">
          <div style="width:52px;height:52px;border-radius:50%;background:var(--canvas-warm);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--muted);">
            <Icon name="search" size={24} />
          </div>
          <strong style="display:block;color:var(--ink);font-size:14px;margin-bottom:4px;">No Enquiry Loaded</strong>
          <span style="font-size:13px;">Point your camera at a QR code, upload an image, or enter a reference code.</span>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes scanLine {
      0% { top: 0%; opacity: 0.8; }
      50% { top: 96%; opacity: 1; }
      100% { top: 0%; opacity: 0.8; }
    }
  </style>

  <script>
    // Camera decoding is throttled to ~5 frames/second, works on a downscaled
    // frame, and jsQR is imported on demand so the route stays light and the
    // main thread stays responsive.
    type QrDecoder = (
      data: Uint8ClampedArray,
      width: number,
      height: number,
      options?: { inversionAttempts?: 'attemptBoth' | 'dontInvert' | 'onlyInvert' | 'invertFirst' },
    ) => { data: string } | null;

    let jsQrPromise: Promise<QrDecoder> | null = null;
    function loadQrDecoder(): Promise<QrDecoder> {
      if (!jsQrPromise) {
        jsQrPromise = import('jsqr').then((module) => module.default as unknown as QrDecoder);
      }
      return jsQrPromise;
    }

    // Elements are re-resolved on every init so the scanner keeps working after
    // Astro client-side navigations replace the DOM.
    let video: HTMLVideoElement | null = null;
    let canvas: HTMLCanvasElement | null = null;
    let placeholder: HTMLElement | null = null;
    let reticle: HTMLElement | null = null;
    let camBadge: HTMLElement | null = null;
    let camAlert: HTMLElement | null = null;
    let startBtn: HTMLButtonElement | null = null;
    let stopBtn: HTMLButtonElement | null = null;
    let flipBtn: HTMLButtonElement | null = null;
    let fileInput: HTMLInputElement | null = null;
    let manualInput: HTMLInputElement | null = null;
    let manualBtn: HTMLButtonElement | null = null;
    let resultBody: HTMLElement | null = null;
    let resultBadge: HTMLElement | null = null;

    function bindElements() {
      video = document.getElementById('scannerVideo') as HTMLVideoElement | null;
      canvas = document.getElementById('scannerCanvas') as HTMLCanvasElement | null;
      placeholder = document.getElementById('scannerPlaceholder');
      reticle = document.getElementById('scannerReticle');
      camBadge = document.getElementById('cameraStatusBadge');
      camAlert = document.getElementById('camAlert');
      startBtn = document.getElementById('startCamBtn') as HTMLButtonElement | null;
      stopBtn = document.getElementById('stopCamBtn') as HTMLButtonElement | null;
      flipBtn = document.getElementById('flipCamBtn') as HTMLButtonElement | null;
      fileInput = document.getElementById('qrFileInput') as HTMLInputElement | null;
      manualInput = document.getElementById('manualInput') as HTMLInputElement | null;
      manualBtn = document.getElementById('manualSearchBtn') as HTMLButtonElement | null;
      resultBody = document.getElementById('resultBody');
      resultBadge = document.getElementById('resultStatusBadge');
    }

    let mediaStream: MediaStream | null = null;
    let scanTimer: number | null = null;
    let usingFrontCamera = false;
    let isScanning = false;
    let decodeBusy = false;
    let scanCtx: CanvasRenderingContext2D | null = null;
    let audioCtx: AudioContext | null = null;

    const DECODE_INTERVAL_MS = 200;
    const MAX_DECODE_EDGE = 480;

    function esc(value: unknown): string {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const barcodeDetector =
      typeof (window as any).BarcodeDetector === 'function'
        ? new (window as any).BarcodeDetector({ formats: ['qr_code'] })
        : null;

    function playBeep() {
      try {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
          if (AudioContextClass) audioCtx = new AudioContextClass();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        if (audioCtx) {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(880, audioCtx.currentTime); // A5
          osc.frequency.exponentialRampToValueAtTime(1320, audioCtx.currentTime + 0.12);
          gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.12);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.12);
        }
      } catch (e) {
        // Audio optional
      }
    }

    async function startCamera() {
      bindElements();
      if (!video || !placeholder || !reticle || !camBadge || !camAlert || !startBtn || !stopBtn || !flipBtn) return;

      camAlert.style.display = 'none';
      try {
        const constraints: MediaStreamConstraints = {
          video: {
            facingMode: usingFrontCamera ? 'user' : 'environment',
            width: { ideal: 640 },
            height: { ideal: 480 },
          },
        };

        if (mediaStream) {
          stopCamera();
          bindElements();
        }

        mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
        video.srcObject = mediaStream;
        video.setAttribute('playsinline', 'true');
        await video.play();

        video.style.display = 'block';
        placeholder.style.display = 'none';
        reticle.style.display = 'block';
        camBadge.textContent = 'Camera Active';
        camBadge.className = 'badge badge-success';
        startBtn.disabled = true;
        stopBtn.disabled = false;
        flipBtn.disabled = false;
        isScanning = true;

        scheduleScan();
      } catch (err: any) {
        camBadge.textContent = 'Camera Error';
        camBadge.className = 'badge badge-danger';
        camAlert.style.display = 'block';
        camAlert.textContent = `Camera access error: ${err.message || 'Permission denied'}. Please allow camera permissions in your browser.`;
      }
    }

    function stopCamera() {
      isScanning = false;
      if (scanTimer !== null) {
        window.clearTimeout(scanTimer);
        scanTimer = null;
      }
      if (mediaStream) {
        mediaStream.getTracks().forEach((track) => track.stop());
        mediaStream = null;
      }
      if (video) {
        video.pause();
        video.srcObject = null;
        video.style.display = 'none';
      }
      if (placeholder) placeholder.style.display = 'block';
      if (reticle) reticle.style.display = 'none';
      if (camBadge) {
        camBadge.textContent = 'Camera Paused';
        camBadge.className = 'badge badge-muted';
      }
      if (startBtn) startBtn.disabled = false;
      if (stopBtn) stopBtn.disabled = true;
      if (flipBtn) flipBtn.disabled = true;
    }

    function scheduleScan() {
      if (!isScanning || scanTimer !== null) return;
      scanTimer = window.setTimeout(scanFrame, DECODE_INTERVAL_MS);
    }

    async function scanFrame() {
      scanTimer = null;
      if (!isScanning || decodeBusy) {
        scheduleScan();
        return;
      }
      if (!video || !canvas || video.readyState < video.HAVE_ENOUGH_DATA) {
        scheduleScan();
        return;
      }

      decodeBusy = true;
      try {
        const sourceWidth = video.videoWidth;
        const sourceHeight = video.videoHeight;
        if (!sourceWidth || !sourceHeight) return;

        const scale = Math.min(1, MAX_DECODE_EDGE / Math.max(sourceWidth, sourceHeight));
        const width = Math.max(1, Math.round(sourceWidth * scale));
        const height = Math.max(1, Math.round(sourceHeight * scale));

        if (canvas.width !== width || canvas.height !== height) {
          canvas.width = width;
          canvas.height = height;
          scanCtx = null;
        }
        if (!scanCtx) {
          scanCtx = canvas.getContext('2d', { willReadFrequently: true });
        }
        if (!scanCtx) return;

        scanCtx.drawImage(video, 0, 0, width, height);
        let payload: string | null = null;

        if (barcodeDetector) {
          try {
            const codes = await barcodeDetector.detect(canvas);
            payload = codes?.[0]?.rawValue ?? null;
          } catch {
            payload = null;
          }
        }

        if (!payload) {
          const decode = await loadQrDecoder();
          const imageData = scanCtx.getImageData(0, 0, width, height);
          const code = decode(imageData.data, width, height, { inversionAttempts: 'dontInvert' });
          payload = code?.data ?? null;
        }

        if (payload) {
          playBeep();
          const captured = payload;
          stopCamera();
          fetchEnquiry(captured);
          return;
        }
      } finally {
        decodeBusy = false;
      }

      scheduleScan();
    }

    async function scanUploadedImage(file: File) {
      const decode = await loadQrDecoder();
      bindElements();
      const target = canvas;
      if (!target) return;

      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          // Downscale large uploads before decoding so a 12MP photo cannot
          // block the main thread for seconds.
          const scale = Math.min(1, 1400 / Math.max(img.width, img.height));
          target.width = Math.max(1, Math.round(img.width * scale));
          target.height = Math.max(1, Math.round(img.height * scale));
          const ctx = target.getContext('2d');
          if (!ctx) return;
          ctx.drawImage(img, 0, 0, target.width, target.height);
          const imgData = ctx.getImageData(0, 0, target.width, target.height);
          const code = decode(imgData.data, imgData.width, imgData.height);
          if (code && code.data) {
            playBeep();
            fetchEnquiry(code.data);
          } else {
            alert('No QR code could be detected in this image. Please ensure the QR is clear and well-lit.');
          }
        };
        img.src = reader.result as string;
      };
      reader.readAsDataURL(file);
    }

    async function fetchEnquiry(rawInput: string) {
      bindElements();
      if (!resultBody || !resultBadge) return;

      resultBadge.textContent = 'Fetching…';
      resultBadge.className = 'badge badge-info';
      resultBody.innerHTML = `
        <div style="text-align:center;padding:36px;color:var(--muted);">
          <div style="display:inline-block;width:28px;height:28px;border:3px solid var(--gold);border-top-color:transparent;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
          <p style="margin-top:12px;font-size:13.5px;">Looking up enquiry record…</p>
        </div>
      `;

      try {
        const response = await fetch('/api/admin/enquiry/lookup-by-qr', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ input: rawInput }),
        });

        const data = await response.json();
        if (!response.ok || !data.success || !data.enquiry) {
          resultBadge.textContent = 'Not Found';
          resultBadge.className = 'badge badge-danger';
          resultBody.innerHTML = `
            <div style="text-align:center;padding:32px 16px;">
              <div style="width:48px;height:48px;border-radius:50%;background:rgba(211,47,47,0.1);color:#d32f2f;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </div>
              <h3 style="margin:0 0 8px;font-size:1.15rem;">Enquiry Not Found</h3>
              <p style="color:var(--muted);font-size:13px;max-width:340px;margin:0 auto 16px;">
                ${esc(data.error || 'No matching customer enquiry was located in the Neon database.')}
              </p>
              <button type="button" class="btn btn-secondary btn-sm" data-scan-again>
                Scan Again
              </button>
            </div>
          `;
          return;
        }

        const enq = data.enquiry;
        resultBadge.textContent = enq.status.toUpperCase();
        resultBadge.className = enq.status === 'confirmed' ? 'badge badge-success' : 'badge badge-gold';

        const cleanPhone = enq.customerPhone ? String(enq.customerPhone).replace(/\D/g, '') : '';
        const whatsappMsg = encodeURIComponent(`Namaste ${enq.customerName}, regarding your Event Point Ranchi enquiry (${enq.referenceCode}) for ${enq.eventType} on ${enq.eventDate}:`);

        resultBody.innerHTML = `
          <div style="display:flex;flex-direction:column;gap:18px;">
            
            <!-- Reference & Status Header -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:14px;">
              <div>
                <span style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);font-weight:600;">Reference Code</span>
                <h3 style="margin:2px 0 0;font-size:1.25rem;font-family:var(--font-mono);color:var(--gold-ink);">${esc(enq.referenceCode)}</h3>
              </div>
              <span class="badge ${enq.status === 'confirmed' ? 'badge-success' : 'badge-warning'}">${esc(enq.status.toUpperCase())}</span>
            </div>

            <!-- Customer Snapshot -->
            <div style="background:var(--canvas-warm);border:1px solid var(--line);border-radius:var(--r-md);padding:14px 16px;">
              <div style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--muted);margin-bottom:8px;">Customer Information</div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;font-size:13px;">
                <div><strong>Name:</strong> ${esc(enq.customerName)}</div>
                <div><strong>Phone:</strong> <a href="tel:${esc(cleanPhone)}" class="text-link">${esc(enq.customerPhone)}</a></div>
                <div><strong>Email:</strong> ${esc(enq.customerEmail || '—')}</div>
                <div><strong>Preferred Contact:</strong> ${esc(enq.preferredContact || 'Phone')}</div>
              </div>
            </div>

            <!-- Event Details -->
            <div style="background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);padding:14px 16px;">
              <div style="font-size:12px;font-weight:700;text-transform:uppercase;color:var(--muted);margin-bottom:8px;">Event Requirements</div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;font-size:13px;">
                <div><strong>Event Type:</strong> ${esc(enq.eventType)}</div>
                <div><strong>Event Date:</strong> ${esc(enq.eventDate)} ${enq.endDate ? 'to ' + esc(enq.endDate) : ''}</div>
                <div><strong>Venue:</strong> ${esc(enq.venueLocation)}</div>
                <div><strong>Expected Guests:</strong> ${esc(enq.guestCount)}</div>
                <div><strong>Budget Range:</strong> ${esc(enq.budgetRange)}</div>
                <div><strong>Rooms Required:</strong> ${enq.requiresRooms ? 'Yes (' + esc(enq.roomCount) + ' rooms)' : 'No'}</div>
              </div>
              ${enq.accommodationNotes ? `<div style="margin-top:8px;font-size:12px;color:var(--muted);"><strong>Accommodation:</strong> ${esc(enq.accommodationNotes)}</div>` : ''}
              ${enq.decorationNotes ? `<div style="margin-top:8px;font-size:12px;color:var(--muted);white-space:pre-line;"><strong>Notes:</strong> ${esc(enq.decorationNotes)}</div>` : ''}
            </div>

            <!-- Selected Line Items -->
            ${enq.items && enq.items.length > 0 ? `
              <div style="border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden;">
                <div style="background:var(--canvas-warm);padding:8px 14px;font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;">
                  Selected Items (${Number(enq.items.length) || 0})
                </div>
                <div style="max-height:160px;overflow-y:auto;padding:8px 14px;font-size:12.5px;">
                  ${enq.items.map((item: any) => `
                    <div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px dashed var(--line);">
                      <span><strong>${esc(item.name)}</strong> <small style="color:var(--muted);">(${esc(item.itemType)})</small></span>
                      <span>Qty: <strong>${esc(item.quantity)}</strong></span>
                    </div>
                  `).join('')}
                </div>
              </div>
            ` : ''}

            <!-- Linked Booking Info (if converted) -->
            ${enq.linkedBooking ? `
              <div style="background:rgba(46,125,50,0.08);border:1px solid rgba(46,125,50,0.25);border-radius:var(--r-md);padding:12px 16px;font-size:13px;">
                <strong style="color:#2e7d32;display:block;margin-bottom:4px;">Linked Active Booking #${esc(enq.linkedBooking.id)}</strong>
                <div style="display:flex;justify-content:space-between;font-size:12.5px;">
                  <span>Payment Status: <strong style="text-transform:uppercase;">${esc(enq.linkedBooking.paymentStatus)}</strong></span>
                  <span>Balance: <strong>₹${(Number(enq.linkedBooking.outstandingBalance) / 100).toLocaleString('en-IN')}</strong></span>
                </div>
              </div>
            ` : ''}

            <!-- Quick Action Dispatch Buttons -->
            <div style="display:flex;gap:8px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:16px;">
              <a href="/admin/enquiries/${esc(enq.id)}" class="btn btn-primary btn-sm">
                View Full Enquiry &rarr;
              </a>
              ${cleanPhone ? `
                <a href="https://wa.me/91${cleanPhone}?text=${whatsappMsg}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="background:#25D366;color:#fff;border-color:#25D366;">
                  WhatsApp Customer
                </a>
                <a href="tel:${cleanPhone}" class="btn btn-secondary btn-sm">
                  Call Customer
                </a>
              ` : ''}
              <button type="button" class="btn btn-ghost btn-sm" data-print-slip>
                Print Slip
              </button>
            </div>
          </div>
        `;
      } catch (err: any) {
        resultBadge.textContent = 'Error';
        resultBadge.className = 'badge badge-danger';
        resultBody.innerHTML = `<div class="alert alert-danger">Error querying enquiry: ${esc(err.message)}</div>`;
      }
    }

    let globalsBound = false;

    function initScanner() {
      bindElements();
      if (!video) return; // not on the scanner page
      if (video.dataset.scannerBound === 'true') return;
      video.dataset.scannerBound = 'true';

      startBtn?.addEventListener('click', startCamera);
      stopBtn?.addEventListener('click', stopCamera);
      flipBtn?.addEventListener('click', () => {
        usingFrontCamera = !usingFrontCamera;
        startCamera();
      });

      fileInput?.addEventListener('change', (e) => {
        const files = (e.target as HTMLInputElement).files;
        if (files && files[0]) {
          scanUploadedImage(files[0]);
        }
      });

      manualBtn?.addEventListener('click', () => {
        const value = manualInput?.value.trim();
        if (value) fetchEnquiry(value);
      });

      manualInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const value = manualInput?.value.trim();
          if (value) fetchEnquiry(value);
        }
      });

      // Auto-lookup if an initial token was supplied
      const initialValue = manualInput?.value.trim();
      if (initialValue) fetchEnquiry(initialValue);
    }

    if (!globalsBound) {
      globalsBound = true;

      // Delegated handlers keep working after the page markup is swapped.
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (target?.closest('[data-scan-again]')) {
          startCamera();
          return;
        }
        if (target?.closest('[data-print-slip]')) {
          window.print();
        }
      });

      // Release the camera, timers and audio on real unload AND on Astro
      // client-side navigation, where beforeunload never fires.
      const teardown = () => stopCamera();
      document.addEventListener('astro:before-swap', teardown);
      window.addEventListener('beforeunload', teardown);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) teardown();
      });
    }

    initScanner();
    document.addEventListener('astro:page-load', initScanner);
  </script>
</AdminLayout>
