---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPager from '../../../components/admin/AdminPager.astro';
import { formatDate, formatMoney } from '../../../core/http';
import type { listCustomers } from '../service';

interface Props {
  items: ReturnType<typeof listCustomers>['items'];
  pagination: ReturnType<typeof listCustomers>['pagination'];
  query: string;
}

const { items: customers, pagination, query } = Astro.props;
const pageHref = (page: number) => `/admin/customers?q=${encodeURIComponent(query)}&page=${page}`;
---

<AdminLayout title="Customers" description={`${pagination.totalCount} customer records.`}>
  <div class="admin-panel">
    <div class="admin-panel-head">
      <form method="GET" action="/admin/customers" class="admin-toolbar">
        <input class="input" type="search" name="q" value={query} placeholder="Search name, phone or email…" />
        <button type="submit" class="btn btn-secondary btn-sm">Search</button>
        {query && <a href="/admin/customers" class="btn btn-ghost btn-sm">Clear</a>}
      </form>
    </div>
    <div class="admin-panel-body flush">
      {customers.length === 0 ? (
        <div class="admin-empty">No customers found.</div>
      ) : (
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Contact</th>
                <th>Joined</th>
                <th>Bookings</th>
                <th>Lifetime value</th>
                <th style="text-align:right;"></th>
              </tr>
            </thead>
            <tbody>
              {customers.map((customer) => (
                <tr>
                  <td><a href={`/admin/customers/${customer.id}`} style="font-weight:600;color:var(--ink);">{customer.name}</a></td>
                  <td>
                    {customer.phone}
                    <div class="text-xs text-muted">{customer.email || '—'}</div>
                  </td>
                  <td class="text-xs">{formatDate(customer.created_at)}</td>
                  <td>{customer.booking_count}</td>
                  <td class="money">{formatMoney(customer.total_spend)}</td>
                  <td>
                    <div class="admin-row-actions">
                      <a href={`/admin/customers/${customer.id}`} class="btn btn-secondary btn-sm">Open</a>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <AdminPager
          page={pagination.page}
          totalPages={pagination.totalPages}
          totalCount={pagination.totalCount}
          startItem={pagination.startItem}
          endItem={pagination.endItem}
          label="customers"
          href={pageHref}
        />
      )}
    </div>
  </div>
</AdminLayout>
