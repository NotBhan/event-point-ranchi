---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSanityConfig, isSanityConfigured } from '../../../core/sanity/config';

interface Props {
  configured: boolean;
  projectId: string;
  dataset: string;
}

const config = getSanityConfig();
const configured = isSanityConfigured();
---

<AdminLayout title="Sanity CMS Studio" description="Edit marketing copy, banners, and presentation content.">
  <div class="studio-wrapper">
    <div class="studio-toolbar">
      <div class="studio-meta">
        <span class:list={['studio-status-pill', { active: configured }]}>
          {configured ? `Connected: ${config.projectId} (${config.dataset})` : 'Awaiting Project Configuration'}
        </span>
      </div>
      <div class="studio-links">
        {configured && (
          <a
            href={`https://${config.projectId}.sanity.studio`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm"
          >
            Open Standalone Studio ↗
          </a>
        )}
        <a
          href="https://www.sanity.io/manage"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-sm"
        >
          Sanity Manage Console ↗
        </a>
      </div>
    </div>

    {!configured ? (
      <div class="studio-onboarding">
        <div class="onboarding-card">
          <div class="onboarding-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          <h2>Connect Your Sanity CMS Project</h2>
          <p>
            Sanity CMS schemas and embedded Studio integration are ready! To connect your live project,
            configure your Sanity Project ID in <code>.env</code> or your deployment environment variables:
          </p>
          <div class="env-example-box">
            <code>
              PUBLIC_SANITY_PROJECT_ID=your-project-id<br/>
              PUBLIC_SANITY_DATASET={config.dataset || 'production'}<br/>
              SANITY_API_VERSION={config.apiVersion || '2025-01-01'}
            </code>
          </div>
          <div class="onboarding-actions">
            <a href="https://www.sanity.io/manage" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Find Project ID on Sanity Manage ↗
            </a>
          </div>
        </div>
      </div>
    ) : (
      <div id="sanity-studio-root" class="studio-canvas"></div>
    )}
  </div>

  <style>
    .studio-wrapper {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 120px);
      background: var(--surface, #fff);
      border-radius: var(--radius-lg, 12px);
      overflow: hidden;
      border: 1px solid var(--border, #e5e7eb);
    }
    .studio-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 18px;
      background: var(--surface-secondary, #faf7f5);
      border-bottom: 1px solid var(--border, #e5e7eb);
    }
    .studio-status-pill {
      font-size: 12px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 9999px;
      background: #fef3c7;
      color: #92400e;
    }
    .studio-status-pill.active {
      background: #dcfce7;
      color: #166534;
    }
    .studio-links {
      display: flex;
      gap: 10px;
    }
    .studio-canvas {
      flex: 1;
      height: 100%;
      min-height: 600px;
    }
    .studio-onboarding {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px;
    }
    .onboarding-card {
      max-width: 520px;
      text-align: center;
      padding: 36px 32px;
      border: 1px solid var(--border, #e5e7eb);
      border-radius: 14px;
      background: var(--surface, #fff);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
    .onboarding-icon {
      color: var(--gold-bright, #d4af37);
      margin-bottom: 16px;
    }
    .onboarding-card h2 {
      margin-bottom: 10px;
      font-size: 22px;
    }
    .onboarding-card p {
      color: var(--text-muted, #666);
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 20px;
    }
    .env-example-box {
      text-align: left;
      background: #1f2937;
      color: #f9fafb;
      padding: 14px 18px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 24px;
    }
    .onboarding-actions {
      display: flex;
      justify-content: center;
      gap: 12px;
    }
  </style>

  {configured && (
    <script>
      import React from 'react';
      import { createRoot } from 'react-dom/client';
      import { Studio } from 'sanity';
      import sanityConfig from '../../../../sanity.config';

      const rootEl = document.getElementById('sanity-studio-root');
      if (rootEl) {
        createRoot(rootEl).render(React.createElement(Studio, { config: sanityConfig }));
      }
    </script>
  )}
</AdminLayout>
