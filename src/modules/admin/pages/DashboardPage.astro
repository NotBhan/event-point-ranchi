---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { formatDate, formatDateTime, formatMoney } from '../../../core/http';
import type { loadDashboard, loadStorageDashboard } from '../service';

interface Props {
  counts: Awaited<ReturnType<typeof loadDashboard>>['counts'];
  recentBookings: Awaited<ReturnType<typeof loadDashboard>>['recentBookings'];
  upcoming: Awaited<ReturnType<typeof loadDashboard>>['upcoming'];
  topHalls: Awaited<ReturnType<typeof loadDashboard>>['topHalls'];
  storage: ReturnType<typeof loadStorageDashboard>;
}

const { counts, recentBookings, upcoming, topHalls, storage } = Astro.props;
const csrf = Astro.locals.csrf;

const statusClass: Record<string, string> = {
  draft: 'badge-muted',
  pending: 'badge-warning',
  confirmed: 'badge-success',
  cancelled: 'badge-danger',
};

const levelBadge: Record<string, string> = {
  ok: 'badge-success',
  warning: 'badge-warning',
  critical: 'badge-danger',
  blocked: 'badge-danger',
};

const levelLabel: Record<string, string> = {
  ok: 'Healthy',
  warning: 'Warning',
  critical: 'Critical',
  blocked: 'Full',
};

const storageCards = [storage.gallery, storage.asset];

const stats = [
  { label: 'Total bookings', value: counts.bookings, icon: 'ticket', hint: `${counts.pending} awaiting confirmation` },
  { label: 'Pipeline value', value: formatMoney(counts.revenue), icon: 'receipt', hint: 'Pending + confirmed bookings' },
  { label: 'Active venues', value: counts.halls, icon: 'building', hint: `${counts.packages} catering packages` },
  { label: 'Customers', value: counts.customers, icon: 'users', hint: `${counts.inquiries} new inquiries` },
];
---

<AdminLayout title="Dashboard" description="Today's snapshot of bookings, revenue and inquiries.">
  <div class="admin-stats">
    {stats.map((stat) => (
      <div class="stat-card">
        <div class="stat-top">
          <span class="stat-icon"><Icon name={stat.icon} size={17} /></span>
        </div>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
        <small>{stat.hint}</small>
      </div>
    ))}
  </div>

  <div class="admin-panel">
    <div class="admin-panel-head">
      <div>
        <h2>Storage</h2>
        <p>Gallery and asset quotas on the {storage.driver} driver{!storage.isConfigured && ' — Filebase credentials are not configured, uploads use the mock driver'}.</p>
      </div>
      <span class:list={['badge', storage.isConfigured ? 'badge-success' : 'badge-warning']}>
        {storage.isConfigured ? 'Connected' : 'Not configured'}
      </span>
    </div>
    <div class="admin-panel-body">
      <div class="storage-grid">
        {storageCards.map((card) => (
          <div class:list={['storage-card', `is-${card.level}`]}>
            <div class="storage-card-head">
              <div>
                <h3 class="storage-card-title">{card.label}</h3>
                <div class="eyebrow">{card.formattedLimit} quota</div>
                <strong class="storage-card-used">{card.formattedUsed} <span>used</span></strong>
              </div>
              <span class:list={['badge', levelBadge[card.level]]}>{levelLabel[card.level]}</span>
            </div>

            <div
              class="storage-meter"
              role="progressbar"
              aria-label={`${card.label} storage usage`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={Math.min(100, Math.round(card.usagePercent))}
            >
              <span
                class:list={['storage-meter-fill', `is-${card.level}`]}
                style={`width:${Math.min(100, card.usagePercent)}%`}
              ></span>
            </div>

            <div class="storage-meter-meta">
              <span>{card.usagePercent.toFixed(1)}% of {card.formattedLimit}</span>
              <span>{card.formattedAvailable} available</span>
            </div>

            <div class="storage-facts">
              <div class="storage-fact">
                <strong>{card.activeCount}</strong>
                <span>Active images</span>
              </div>
              <div class="storage-fact">
                <strong>{card.pendingDeletionCount}</strong>
                <span>Pending deletion</span>
              </div>
              <div class="storage-fact">
                <strong>{card.usage.objectCount}</strong>
                <span>Stored records</span>
              </div>
            </div>

            <p class="text-xs text-muted" style="margin-top:10px;">{card.description}</p>
            {card.usage.reservedBytes > 0 && (
              <p class="hint">{card.formattedReserved} reserved by uploads in progress.</p>
            )}
          </div>
        ))}
      </div>

      <div class="storage-maintenance">
        <div>
          <strong>{storage.pendingDeletionCount} object{storage.pendingDeletionCount === 1 ? '' : 's'} pending deletion</strong>
          <p class="text-xs text-muted">
            Retry cleanup re-attempts failed deletes. Reconcile removes orphaned objects past the 24-hour grace period.
          </p>
        </div>
        <div class="storage-maintenance-actions">
          <form method="POST" action="/admin">
            <input type="hidden" name="_csrf" value={csrf} />
            <input type="hidden" name="action" value="retry_cleanup" />
            <button type="submit" class="btn btn-secondary btn-sm">Retry cleanup</button>
          </form>
          <form method="POST" action="/admin">
            <input type="hidden" name="_csrf" value={csrf} />
            <input type="hidden" name="action" value="reconcile_storage" />
            <button
              type="submit"
              class="btn btn-primary btn-sm"
              data-confirm="Reconcile storage and permanently delete orphaned objects older than 24 hours?"
            >
              Reconcile storage
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-grid-2">
    <div class="admin-panel">
      <div class="admin-panel-head">
        <div>
          <h2>Recent bookings</h2>
          <p>Latest eight reservations</p>
        </div>
        <a href="/admin/bookings" class="btn btn-secondary btn-sm">View all</a>
      </div>
      <div class="admin-panel-body flush">
        {recentBookings.length === 0 ? (
          <div class="admin-empty">No bookings yet.</div>
        ) : (
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Customer</th>
                  <th>Event</th>
                  <th>Total</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {recentBookings.map((booking) => (
                  <tr>
                    <td><a href={`/admin/bookings/${booking.id}`} style="font-weight:600;color:var(--ink);">#{booking.id}</a></td>
                    <td>{booking.customer}</td>
                    <td>
                      {booking.event_type}
                      <div class="text-xs text-muted">{formatDate(booking.event_date)}</div>
                    </td>
                    <td class="money">{formatMoney(booking.total_amount)}</td>
                    <td><span class:list={['badge', statusClass[booking.status] ?? 'badge-muted']}>{booking.status}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:20px;">
      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Upcoming events</h2>
            <p>Next confirmed and pending dates</p>
          </div>
        </div>
        <div class="admin-panel-body">
          {upcoming.length === 0 ? (
            <div class="admin-empty">No upcoming events scheduled.</div>
          ) : (
            <div style="display:flex;flex-direction:column;gap:12px;">
              {upcoming.map((event) => (
                <a href={`/admin/bookings/${event.id}`} class="other-venue" style="padding:10px 0;">
                  <span>
                    <strong>{event.event_type}</strong>
                    <small>{event.customer} · {event.total_guest} guests</small>
                  </span>
                  <span style="text-align:right;">
                    <span class="text-mono" style="font-size:12px;color:var(--ink);">{formatDate(event.event_date)}</span>
                    <div class:list={['badge', statusClass[event.status] ?? 'badge-muted']} style="margin-top:4px;">{event.status}</div>
                  </span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Venue performance</h2>
            <p>Revenue by hall</p>
          </div>
        </div>
        <div class="admin-panel-body">
          {topHalls.length === 0 ? (
            <div class="admin-empty">No hall bookings yet.</div>
          ) : (
            <div style="display:flex;flex-direction:column;gap:12px;">
              {topHalls.map((hall) => (
                <div class="flex-between" style="gap:12px;">
                  <div>
                    <div style="font-size:13px;color:var(--ink-2);font-weight:500;">{hall.name}</div>
                    <div class="text-xs text-muted">{hall.bookings} bookings</div>
                  </div>
                  <span class="money">{formatMoney(hall.revenue)}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="admin-panel">
    <div class="admin-panel-head">
      <div>
        <h2>Latest activity</h2>
        <p>Most recent booking activity (created dates)</p>
      </div>
    </div>
    <div class="admin-panel-body flush">
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Created</th><th>Booking</th><th>Customer</th><th>Status</th></tr>
          </thead>
          <tbody>
            {recentBookings.slice(0, 5).map((booking) => (
              <tr>
                <td class="text-mono text-xs">{formatDateTime(booking.created_at)}</td>
                <td><a href={`/admin/bookings/${booking.id}`} style="color:var(--ink);font-weight:600;">#{booking.id}</a></td>
                <td>{booking.customer}</td>
                <td><span class:list={['badge', statusClass[booking.status] ?? 'badge-muted']}>{booking.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
