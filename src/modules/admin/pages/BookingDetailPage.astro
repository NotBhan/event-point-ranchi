---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatDate, formatDateTime } from '../../../core/http';
import { bookingStatuses } from '../../../core/config';
import {
  bookingStatusClass,
  bookingStatusLabel,
  enquiryStatusLabel,
  paymentStatusLabel,
} from '../presentation';
import type { QuotationData } from '../../bookings/service';
import CanonicalDocument from '../../../components/documents/CanonicalDocument.astro';
import { getSiteSettings } from '../../../core/content/service';
import { buildBookingDocument } from '../../../core/documents/canonical';

interface Props {
  data?: QuotationData;
  notFound?: boolean;
}

const { data, notFound = false } = Astro.props;
const csrf = Astro.locals.csrf;
const statuses = bookingStatuses;
const settings = data ? await getSiteSettings() : null;
const bookingDocument = data && settings
  ? buildBookingDocument(data, {
      name: settings.name,
      phone: settings.phone,
      email: settings.email,
      address: settings.address,
      website: 'https://eventpointranchi.com',
    })
  : null;
---

{notFound || !data ? (
  <AdminLayout title="Booking not found">
    <div class="admin-panel">
      <div class="admin-empty">
        This booking does not exist. <a href="/admin/bookings" style="color:var(--gold-ink);font-weight:600;">Back to bookings</a>
      </div>
    </div>
  </AdminLayout>
) : (
  <AdminLayout title={`Booking #${data.booking.id}`} description={`${data.customer.name} · ${data.booking.event_type}`}>
    <div class="admin-toolbar">
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <a href="/admin/bookings" class="btn btn-secondary btn-sm">← All bookings</a>
        {data.booking.source_enquiry_id && (
          <a href={`/admin/new-enquiries/${data.booking.source_enquiry_id}`} class="btn btn-secondary btn-sm">
            Source enquiry
          </a>
        )}
        <a href={`/booking/${data.booking.id}/quotation`} class="btn btn-secondary btn-sm" target="_blank" rel="noopener">
          Open invoice
        </a>
      </div>
      <span class:list={['badge', bookingStatusClass(data.booking.status)]}>{bookingStatusLabel(data.booking.status)}</span>
    </div>

    <div class="admin-grid-3">
      <div class="admin-panel">
        <div class="admin-panel-head"><div><h2>Event</h2></div></div>
        <div class="admin-panel-body">
          <div class="summary-row"><div class="summary-left"><small>Event date</small><h4>{formatDate(data.booking.event_date)}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Start time</small><h4>{data.booking.event_time || '—'}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Type</small><h4>{data.booking.event_type}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Guests</small><h4>{data.booking.total_guest}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Venue</small><h4>{data.booking.venue_location || '—'}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Created</small><h4>{formatDateTime(data.booking.created_at)}</h4></div></div>
        </div>
      </div>

      <div class="admin-panel">
        <div class="admin-panel-head"><div><h2>Customer</h2></div></div>
        <div class="admin-panel-body">
          <div class="summary-row"><div class="summary-left"><small>Name</small><h4>{data.customer.name}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Phone</small><h4>{data.customer.phone || '—'}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Email</small><h4>{data.customer.email || '—'}</h4></div></div>
          <div class="summary-row"><div class="summary-left"><small>Address</small><h4>{data.customer.address || '—'}</h4></div></div>
        </div>
      </div>

      <div class="admin-panel">
        <div class="admin-panel-head"><div><h2>Update status</h2></div></div>
        <div class="admin-panel-body">
          <form method="POST" action={`/admin/bookings/${data.booking.id}`} class="form-grid">
            <input type="hidden" name="_csrf" value={csrf} />
            <input type="hidden" name="action" value="update_status" />
            <div class="field">
              <label for="status">Booking status</label>
              <select class="select" id="status" name="status">
                {statuses.map((status) => (
                  <option value={status} selected={data.booking.status === status}>
                    {bookingStatusLabel(status)}
                  </option>
                ))}
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Save status</button>
          </form>

        </div>
      </div>
    </div>

    <div class="admin-panel">
      <div class="admin-panel-head">
        <div><h2>Source &amp; admin handling</h2><p>How this managed booking was created.</p></div>
      </div>
      <div class="admin-panel-body">
        <div class="admin-grid-2">
          <div>
            <small class="text-muted">Source enquiry</small>
            <h4>
              {data.sourceEnquiry ? (
                <a href={`/admin/new-enquiries/${data.sourceEnquiry.id}`} class="text-link">
                  {data.sourceEnquiry.reference}
                </a>
              ) : (
                'Direct booking'
              )}
            </h4>
            {data.sourceEnquiry && (
              <div class="text-xs text-muted">
                {enquiryStatusLabel(data.sourceEnquiry.status)} · {formatDateTime(data.sourceEnquiry.acceptedAt)}
              </div>
            )}
          </div>
          <div>
            <small class="text-muted">Accepted by</small>
            <h4>{data.sourceEnquiry?.acceptedBy || '—'}</h4>
            {data.sourceEnquiry?.acceptedAt && (
              <div class="text-xs text-muted">{formatDateTime(data.sourceEnquiry.acceptedAt)}</div>
            )}
          </div>
          <div>
            <small class="text-muted">Event venue</small>
            <h4>{data.booking.venue_location || data.sourceEnquiry?.venue || '—'}</h4>
          </div>
          <div>
            <small class="text-muted">Booking status</small>
            <h4>{bookingStatusLabel(data.booking.status)}</h4>
            <div class="text-xs text-muted">{paymentStatusLabel(data.booking.payment_status)}</div>
          </div>
        </div>
      </div>
    </div>

    {data.sourceEnquiry && (
      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Source enquiry selections</h2>
            <p>Preserved from the accepted enquiry; these are not re-created from the browser.</p>
          </div>
          <a href={`/admin/new-enquiries/${data.sourceEnquiry.id}`} class="btn btn-secondary btn-sm">
            Open source enquiry
          </a>
        </div>
        <div class="admin-panel-body flush">
          {data.sourceEnquiry.lines.length === 0 ? (
            <div class="admin-empty">No catalogue line items were attached to the source enquiry.</div>
          ) : (
            <div class="table-wrap">
              <table class="table table-stack">
                <thead>
                  <tr>
                    <th>Type</th>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Dimensions</th>
                    <th>Specifications &amp; notes</th>
                  </tr>
                </thead>
                <tbody>
                  {data.sourceEnquiry.lines.map((line) => (
                    <tr>
                      <td data-label="Type"><span class="badge badge-muted">{line.itemType}</span></td>
                      <td data-label="Item">
                        <strong>{line.name}</strong>
                        {line.catalogueItemId && (
                          <div class="text-xs text-muted">Catalogue #{line.catalogueItemId}</div>
                        )}
                      </td>
                      <td data-label="Quantity">{line.quantity}</td>
                      <td data-label="Dimensions" class="text-sm">{line.dimensions || '—'}</td>
                      <td data-label="Specifications & notes" class="text-sm">
                        {line.specifications || '—'}
                        {line.notes && <div class="text-xs text-muted">Note: {line.notes}</div>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Canonical quotation / booking document -->
    {bookingDocument && (
      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Canonical booking document</h2>
            <p>The same document rendered to customers and used for printing.</p>
          </div>
          <a href={`/booking/${data.booking.id}/quotation`} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
            Open printable document
          </a>
        </div>
        <div class="admin-panel-body">
          <CanonicalDocument document={bookingDocument} />
        </div>
      </div>
    )}

    <!-- Financial Breakdown & Deposit Configuration -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(320px, 100%), 1fr));gap:20px;margin-bottom:24px;">
      <!-- Deposit Configurator -->
      <div class="admin-panel">
        <div class="admin-panel-head">
          <div>
            <h2>Configure Booking Deposit</h2>
            <p>Set required advance or full payment policy</p>
          </div>
        </div>
        <div class="admin-panel-body">
          <form method="POST" action={`/admin/bookings/${data.booking.id}`} class="form-grid">
            <input type="hidden" name="_csrf" value={csrf} />
            <input type="hidden" name="action" value="update_deposit" />
            
            <div class="field">
              <label for="deposit_type">Deposit Policy Type</label>
              <select class="select" id="deposit_type" name="deposit_type" onchange="
                const valField = document.getElementById('depositValGroup');
                const lbl = document.getElementById('depositValLabel');
                if (this.value === 'full') {
                  valField.style.display = 'none';
                } else if (this.value === 'percentage') {
                  valField.style.display = 'block';
                  lbl.textContent = 'Percentage Value (1 - 100%)';
                } else {
                  valField.style.display = 'block';
                  lbl.textContent = 'Amount in INR (₹)';
                }
              ">
                <option value="percentage">Percentage Deposit (e.g. 25% or custom %)</option>
                <option value="full">Full Payment Required (100% Upfront)</option>
                <option value="fixed">Fixed Deposit Amount (₹)</option>
                <option value="custom">Custom Approved Deposit (₹)</option>
              </select>
            </div>

            <div class="field" id="depositValGroup">
              <label for="deposit_value" id="depositValLabel">Percentage Value (1 - 100%)</label>
              <input
                type="number"
                class="input"
                id="deposit_value"
                name="deposit_value"
                min="1"
                step="any"
                value="25"
                placeholder="e.g. 25 or amount in ₹"
              />
            </div>

            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;">
              <button type="submit" class="btn btn-primary btn-sm">
                Apply Deposit Policy
              </button>
              <button
                type="button"
                class="btn btn-secondary btn-sm"
                onclick="
                  document.getElementById('deposit_type').value = 'percentage';
                  document.getElementById('deposit_value').value = '25';
                  document.getElementById('depositValGroup').style.display = 'block';
                  document.getElementById('depositValLabel').textContent = 'Percentage Value (1 - 100%)';
                "
              >
                25% Default
              </button>
              <button
                type="button"
                class="btn btn-secondary btn-sm"
                onclick="
                  document.getElementById('deposit_type').value = 'full';
                  document.getElementById('depositValGroup').style.display = 'none';
                "
              >
                100% Full
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </AdminLayout>
)}
