---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { imageUrl } from '../../../core/http';
import { responsiveImage, thumbnailUrl } from '../../../core/media';
import type { StageRow } from '../service';

interface Props {
  data?: StageRow & { gallery: string[] };
  notFound?: boolean;
}

const { data, notFound = false } = Astro.props;
const stage = data;
const stageImage = responsiveImage(stage?.image, {
  widths: [480, 800, 1200],
  sizes: '(max-width: 900px) 100vw, 560px',
});
const decorationItems = stage?.decoration_notes
  .split('·')
  .map((item) => item.trim())
  .filter(Boolean) ?? [];
const images = stage ? [stage.image, ...stage.gallery].filter((image): image is string => Boolean(image)) : [];
const dimensions = stage ? `${stage.length_ft} × ${stage.width_ft} × ${stage.height_ft} ${stage.dimension_unit}` : '';
---

<BaseLayout
  title={stage ? `${stage.name} | Stage Design in Ranchi | Event Point Ranchi` : 'Stage design not found | Event Point Ranchi'}
  description={stage?.description ?? 'This stage design could not be found.'}
>
  {notFound || !stage ? (
    <section class="section">
      <div class="container">
        <div class="empty-state">
          <div class="empty-icon"><Icon name="theater" size={24} /></div>
          <h3>Stage design not found</h3>
          <p>This design may have been renamed. Browse the current stage collection instead.</p>
          <div class="section-actions"><a href="/stages" class="btn btn-primary">Back to stage designs</a></div>
        </div>
      </div>
    </section>
  ) : (
    <>
      <nav class="breadcrumb container" aria-label="Breadcrumb">
        <a href="/">Home</a><Icon name="chevron-right" size={12} />
        <a href="/stages">Stage Designs</a><Icon name="chevron-right" size={12} />
        <span aria-current="page">{stage.name}</span>
      </nav>

      <section class="detail-hero">
        <div class="container detail-hero-grid">
          <div class="detail-media">
            <img
              src={stageImage.src}
              srcset={stageImage.srcset}
              sizes="(max-width: 900px) 100vw, 560px"
              width="1200"
              height="900"
              alt={stage.name}
              fetchpriority="high"
              decoding="async"
            />
            <span class="catalogue-badge">{stage.style_category}</span>
          </div>
          <div class="detail-intro">
            <span class="eyebrow">Stage design</span>
            <h1>{stage.name}</h1>
            <p class="detail-lead">{stage.description}</p>

            <div class="detail-highlights">
              <div>
                <span>Standard footprint</span>
                <strong>{dimensions}</strong>
              </div>
              <div>
                <span>Style family</span>
                <strong>{stage.style_category}</strong>
              </div>
            </div>

            <div class="detail-actions">
              <a href="#configure" class="btn btn-primary btn-lg">Configure &amp; add</a>
              <a href={`https://wa.me/919876543210?text=${encodeURIComponent(`Hello Event Point Ranchi, I am interested in the ${stage.name} stage design.`)}`} class="btn btn-secondary btn-lg" target="_blank" rel="noopener">
                Ask on WhatsApp
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container detail-layout">
          <div class="detail-main">
            <div class="content-block">
              <h2>Decoration &amp; production notes</h2>
              <ul class="spec-list">
                {decorationItems.map((item) => (
                  <li><Icon name="check-circle" size={15} /> {item}</li>
                ))}
              </ul>
            </div>

            {images.length > 1 && (
              <div class="content-block">
                <h2>Gallery</h2>
                <div class="detail-gallery">
                  {images.map((image, index) => (
                    <button
                      type="button"
                      class="detail-gallery-item"
                      data-lightbox
                      data-src={imageUrl(image)}
                      data-caption={`${stage.name} — view ${index + 1}`}
                      aria-label={`View ${stage.name} image ${index + 1}`}
                    >
                      <img src={thumbnailUrl(image, 480)} width="400" height="400" alt={`${stage.name} detail ${index + 1}`} loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          <aside class="detail-aside" id="configure">
            <div class="panel requirement-panel" data-requirement-form>
              <div class="panel-head">
                <div>
                  <h2>Add to requirements</h2>
                  <p>Standard size: {dimensions}. Leave custom fields blank to use it.</p>
                </div>
              </div>

              <div class="dimension-panel">
                <div class="dimension-panel-head">
                  <Icon name="edit" size={16} />
                  <div>
                    <strong>Request custom dimensions</strong>
                    <span>Optional — in feet</span>
                  </div>
                </div>
                <div class="form-grid cols-3">
                  <div class="field">
                    <label for="stage-length">Length (ft)</label>
                    <input class="input" id="stage-length" type="number" min="1" step="0.5" inputmode="decimal" placeholder={String(stage.length_ft)} data-dim-length />
                  </div>
                  <div class="field">
                    <label for="stage-width">Width (ft)</label>
                    <input class="input" id="stage-width" type="number" min="1" step="0.5" inputmode="decimal" placeholder={String(stage.width_ft)} data-dim-width />
                  </div>
                  <div class="field">
                    <label for="stage-height">Height (ft)</label>
                    <input class="input" id="stage-height" type="number" min="1" step="0.5" inputmode="decimal" placeholder={String(stage.height_ft)} data-dim-height />
                  </div>
                </div>
              </div>

              <div class="field">
                <label for="stage-note">Decoration notes (optional)</label>
                <textarea class="textarea" id="stage-note" rows="3" placeholder="Palette, flowers, lighting, entrance or access notes…" data-dimension-note></textarea>
              </div>

              <button
                type="button"
                class="btn btn-primary btn-block btn-lg"
                data-add-stage
                data-id={stage.id}
                data-slug={stage.slug}
                data-name={stage.name}
                data-category={stage.style_category}
                data-image={stage.image ?? ''}
                data-length={stage.length_ft}
                data-width={stage.width_ft}
                data-height={stage.height_ft}
                data-unit={stage.dimension_unit}
                aria-pressed="false"
              >
                Add to Requirements
              </button>

              <a href="/plan" class="btn btn-secondary btn-block">Review all requirements</a>
              <p class="requirement-disclaimer">
                Submitting requirements is an enquiry for a quotation. It does not block a date or confirm a booking.
              </p>
            </div>
          </aside>
        </div>
      </section>
    </>
  )}
</BaseLayout>
