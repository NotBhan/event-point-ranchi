---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import NotFound from '../../../components/NotFound.astro';
import { formatDate, formatDateTime, formatMoney } from '../../../core/http';
import type { QuotationData } from '../service';
import '../bookings.css';

interface Props {
  data?: QuotationData;
  state?: 'not-found' | 'forbidden';
}

const { data, state } = Astro.props;

const statusClass: Record<string, string> = {
  draft: 'badge-muted',
  pending: 'badge-warning',
  confirmed: 'badge-success',
  cancelled: 'badge-danger',
};
---

{state === 'not-found' || (!data && !state) ? (
  <NotFound />
) : state === 'forbidden' ? (
  <BaseLayout title="Invoice access restricted | Event Point Ranchi" noCart>
    <section class="section">
      <div class="container">
        <div style="max-width:560px;margin:40px auto;text-align:center;">
          <div class="empty-icon" style="margin:0 auto 16px;width:56px;height:56px;border-radius:50%;background:var(--danger-soft);display:flex;align-items:center;justify-content:center;color:var(--danger);">
            <Icon name="shield" size={24} />
          </div>
          <h1 class="display-md">This invoice is private</h1>
          <p class="lead mt-3">
            Sign in with the account used for this booking, or open the link shared with your booking confirmation.
          </p>
          <div class="flex-center gap-3 mt-6 wrap">
            <a href="/login?next=/my-bookings" class="btn btn-primary">Log in</a>
            <a href="/" class="btn btn-secondary">Back to home</a>
          </div>
        </div>
      </div>
    </section>
  </BaseLayout>
) : data ? (
  <BaseLayout title={`Invoice EP-${String(data.booking.id).padStart(5, '0')} | Event Point Ranchi`} noCart>
    <section class="section-sm" style="background:var(--canvas-warm);">
      <div class="container">
        <div class="invoice-page print-area">
          <div class="invoice-head">
            <div class="invoice-brand">
              <img src="/images/event-point-logo.svg" alt="Event Point Ranchi" />
              <div>
                <h1>Event Point Ranchi</h1>
                <p>Mandap, Stage, Furniture & Wedding Requirements · Ranchi, Jharkhand</p>
              </div>
            </div>
            <div class="invoice-meta">
              <h2>Booking invoice</h2>
              <div class="invoice-number">EP-{String(data.booking.id).padStart(5, '0')}</div>
              <span class:list={['badge', statusClass[data.booking.status] ?? 'badge-muted']}>
                {data.booking.status}
              </span>
            </div>
          </div>

          <div class="invoice-info-grid">
            <div><span>Booking ID</span><strong>#{data.booking.id}</strong></div>
            <div><span>Created</span><strong>{formatDateTime(data.booking.created_at)}</strong></div>
            <div><span>Event date</span><strong>{formatDate(data.booking.event_date)}</strong></div>
            <div><span>Event type</span><strong>{data.booking.event_type}</strong></div>
          </div>

          <div class="invoice-card">
            <h3>Customer details</h3>
            <div class="invoice-customer">
              <div><span>Name</span><strong>{data.customer.name}</strong></div>
              <div><span>Phone</span><strong>{data.customer.phone || '—'}</strong></div>
              <div><span>Email</span><strong>{data.customer.email || '—'}</strong></div>
              <div><span>Guests</span><strong>{data.booking.total_guest}</strong></div>
            </div>
            {data.customer.address && <p class="invoice-address">{data.customer.address}</p>}
          </div>

          <div class="invoice-card">
            <h3>Booking breakdown</h3>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th style="width:26%;">Category</th>
                    <th>Details</th>
                    <th style="text-align:right;">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  {data.lines.map((line) => (
                    <tr>
                      <td><strong>{line.label}</strong></td>
                      <td>{line.detail}</td>
                      <td class="money" style="text-align:right;">{formatMoney(line.amount)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {data.booking.special_request && (
              <div class="invoice-note">
                <strong>Special requests:</strong> {data.booking.special_request}
              </div>
            )}
          </div>

          <div class="invoice-total">
            <span>Total amount</span>
            <strong>{formatMoney(data.booking.total_amount)}</strong>
          </div>

          <div style="background:var(--canvas-warm);border:1px solid var(--line);border-radius:var(--r-md);padding:14px 18px;margin-top:14px;font-size:13.5px;">
            <div style="display:flex;justify-content:space-between;padding:4px 0;">
              <span>Amount Paid:</span>
              <strong style="color:#2e7d32;">{formatMoney(data.booking.amount_paid ?? 0)}</strong>
            </div>
            <div style="display:flex;justify-content:space-between;padding:4px 0;">
              <span>Outstanding Balance:</span>
              <strong style="color:var(--primary-dark);">{formatMoney(data.booking.outstanding_balance ?? data.booking.total_amount)}</strong>
            </div>
            <div style="display:flex;justify-content:space-between;padding:4px 0;align-items:center;">
              <span>Payment Status:</span>
              <span class={`badge ${(data.booking.payment_status || 'unpaid') === 'paid' ? 'badge-success' : (data.booking.payment_status || 'unpaid') === 'partially_paid' ? 'badge-info' : 'badge-gold'}`}>
                {(data.booking.payment_status || 'unpaid').toUpperCase()}
              </span>
            </div>
          </div>

          <p class="invoice-disclaimer">
            This invoice includes all selected venues, catering, furnishings and services. Prices were verified against our
            live catalogue at the time of booking.
          </p>

          <div class="invoice-signatures">
            <div><span></span><p>Customer signature</p></div>
            <div><span></span><p>Authorised signature</p></div>
          </div>
        </div>

        <div class="invoice-actions no-print">
          {(data.booking.outstanding_balance ?? data.booking.total_amount) > 0 ? (
            <a
              href={`/payment/checkout?bookingId=${data.booking.id}&token=${encodeURIComponent(data.booking.access_token || '')}`}
              class="btn btn-primary"
              style="background:#2e7d32;border-color:#2e7d32;"
            >
              <Icon name="check-circle" size={16} />
              {(data.booking.amount_paid ?? 0) === 0 ? 'Pay Booking Advance (25%)' : 'Pay Remaining Balance'}
            </a>
          ) : (
            <span class="badge badge-success" style="padding:10px 16px;font-size:14px;">
              <Icon name="check-circle" size={16} /> Fully Paid & Confirmed
            </span>
          )}

          <button type="button" class="btn btn-secondary" data-print>
            <Icon name="print" size={16} /> Print / save as PDF
          </button>
          <a href="/" class="btn btn-secondary"><Icon name="home" size={16} /> Back to home</a>
          {data.booking.status === 'pending' && (data.booking.amount_paid ?? 0) === 0 && (
            <span class="muted-box" style="padding:10px 14px;">
              Pay advance online or our team will call to confirm.
            </span>
          )}
        </div>
      </div>
    </section>

    <script>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </BaseLayout>
) : null}
