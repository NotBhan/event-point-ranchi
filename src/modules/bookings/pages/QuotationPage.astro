---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import NotFound from '../../../components/NotFound.astro';
import CanonicalDocument from '../../../components/documents/CanonicalDocument.astro';
import { getSiteSettings } from '../../../core/content/service';
import { buildBookingDocument } from '../../../core/documents/canonical';
import type { QuotationData } from '../service';
import '../bookings.css';

interface Props {
  data?: QuotationData;
  state?: 'not-found' | 'forbidden';
}

const { data, state } = Astro.props;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Pragma', 'no-cache');

const settings = data ? await getSiteSettings() : null;
const document = data && settings
  ? buildBookingDocument(data, {
      name: settings.name,
      phone: settings.phone,
      email: settings.email,
      address: settings.address,
      website: 'https://eventpointranchi.com',
    })
  : null;
---

{state === 'not-found' || (!data && !state) ? (
  <NotFound />
) : state === 'forbidden' ? (
  <BaseLayout title="Document access restricted | Event Point Ranchi" noCart noDock>
    <section class="section">
      <div class="container">
        <div style="max-width:560px;margin:40px auto;text-align:center;">
          <div class="empty-icon" style="margin:0 auto 16px;width:56px;height:56px;border-radius:50%;background:var(--danger-soft);display:flex;align-items:center;justify-content:center;color:var(--danger);">
            <Icon name="shield" size={24} />
          </div>
          <h1 class="display-md">This document is private</h1>
          <p class="lead mt-3">
            Sign in with the account used for this booking, or open the secure link shared with your confirmation.
          </p>
          <div class="flex-center gap-3 mt-6 wrap">
            <a href="/login?next=/my-bookings" class="btn btn-primary">Log in</a>
            <a href="/" class="btn btn-secondary">Back to home</a>
          </div>
        </div>
      </div>
    </section>
  </BaseLayout>
) : document ? (
  <BaseLayout title={`${document.documentType} ${document.documentNumber} | Event Point Ranchi`} noCart noDock>
    <section class="section-sm" style="background:var(--canvas-warm);">
      <div class="container">
        <div class="no-print" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px;">
          <a href="/my-bookings" class="btn btn-ghost btn-sm"><Icon name="arrow-left" size={14} /> My bookings</a>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button type="button" class="btn btn-secondary btn-sm" data-print>
              <Icon name="print" size={14} /> Print / save as PDF
            </button>
            <a href="/" class="btn btn-secondary btn-sm"><Icon name="home" size={14} /> Home</a>
          </div>
        </div>

        <CanonicalDocument document={document} />

        <div class="no-print" style="max-width:960px;margin:16px auto 0;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:12px;">
          <span>Payment arrangements are confirmed separately by our team.</span>
          {data?.booking.status === 'pending' && Number(data.booking.amount_paid ?? 0) === 0 && (
            <span>No online payment is currently required.</span>
          )}
        </div>
      </div>
    </section>

    <script>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </BaseLayout>
) : null}
