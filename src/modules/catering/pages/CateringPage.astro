---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { formatMoney, imageUrl } from '../../../core/http';
import { heroImage } from '../../../core/media';
import type { loadCateringPage } from '../service';
import { getPageContent } from '../../../core/content/service';
import '../catering.css';

interface Props {
  data: ReturnType<typeof loadCateringPage>;
}

const { data } = Astro.props;
const { settings, packages } = data;
const pageContent = await getPageContent('catering');

const heroTitle = pageContent.title || settings.hero_title;
const heroSubtitle = pageContent.subtitle || settings.hero_subtitle;
const heroBadge = pageContent.content_json?.badge || settings.hero_badge;
const heroBanner = pageContent.banner_image_url || settings.hero_image;
const heroBannerImage = heroImage(heroBanner);
const showBanner = pageContent.banner_enabled !== false && Boolean(heroBanner);
---

<BaseLayout
  title={pageContent.seo_title || "Catering Packages | Event Point Ranchi"}
  description={pageContent.seo_description || heroSubtitle}
>
  <section class:list={['page-hero', { 'with-image': showBanner }]}>
    {showBanner && <img class="page-hero-media" src={heroBannerImage.src} srcset={heroBannerImage.srcset} sizes={heroBannerImage.sizes} width="1600" height="900" alt="" fetchpriority="high" decoding="async" />}
    <div class="container">
      {heroBadge && <span class="eyebrow">{heroBadge}</span>}
      <h1>{heroTitle}</h1>
      <p>{heroSubtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Packages for every celebration</h2>
        <p>Build each course yourself — open a package to choose starters, mains, desserts and live counters.</p>
      </div>

      {packages.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon"><Icon name="utensils" size={24} /></div>
          <h3>No catering packages available</h3>
          <p>Please check again later.</p>
        </div>
      ) : (
        <div class="package-rows">
          {packages.map((pkg, index) => (
            <article class:list={['package-row', index % 2 === 1 ? 'image-right' : '']}>
              <div class="package-row-media">
                {pkg.image ? (
                  <div class="media-with-skeleton" style="width: 100%; height: 100%;">
                    <div class="skeleton-placeholder skeleton-shimmer" role="status" aria-busy="true" aria-label="Loading image..."></div>
                    <img src={imageUrl(pkg.image)} alt={pkg.name} loading="lazy" />
                    <div class="skeleton-error-fallback" role="alert">
                      <Icon name="image" size={24} />
                      <span>Image preview unavailable</span>
                    </div>
                  </div>
                ) : (
                  <div class="room-row-fallback"><Icon name="utensils" size={32} /></div>
                )}
                {pkg.badge && <span class="badge badge-gold">{pkg.badge}</span>}
              </div>

              <div class="package-row-body">
                <span class="room-index">{String(index + 1).padStart(2, '0')}</span>
                <h3>{pkg.name}</h3>
                <div class="price price-lg">
                  {formatMoney(pkg.price_paise)} <span class="price-unit">/ plate</span>
                </div>
                {pkg.description && <p class="room-description">{pkg.description}</p>}

                <ul class="feature-list">
                  {[...pkg.features, ...pkg.bannerFeatures].map((feature) => (
                    <li><Icon name="check" size={14} /> {feature}</li>
                  ))}
                </ul>

                <div class="package-row-foot">
                  <a href={`/catering/${pkg.slug}`} class="btn btn-primary">
                    Build this menu <Icon name="arrow-right" size={15} />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
